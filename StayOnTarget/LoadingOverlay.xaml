<UserControl x:Class="StayOnTarget.Controls.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootLoadingControl">
    <Grid Background="#7F000000"> <!-- Semi-transparent dark overlay to block clicks -->
        <Border Background="White" 
                CornerRadius="8" 
                Padding="25,20" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2" />
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox Width="48" Height="48">
                    <Control>
                        <Control.Template>
                            <ControlTemplate TargetType="Control">
                                <Grid RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform x:Name="SpinTransform" Angle="0" />
                                    </Grid.RenderTransform>

                                    <Canvas Width="48" Height="48">
                                        <!-- Background Ring -->
                                        <Path Data="M24,4 A20,20 0 1,1 23.99,4"
                                              Stroke="#E2E8F0"
                                              StrokeThickness="4"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />

                                        <!-- Spinning Arc -->
                                        <Path Data="M24,4 A20,20 0 0,1 44,24"
                                              Stroke="#3B82F6"
                                              StrokeThickness="4"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsVisible" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard x:Name="SpinStory">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="SpinTransform"
                                                        Storyboard.TargetProperty="Angle"
                                                        From="0" To="360"
                                                        Duration="0:0:1" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinStory" />
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Control.Template>
                    </Control>
                </Viewbox>

                <!-- Dynamic Message -->
                <TextBlock Text="{Binding Message, ElementName=RootLoadingControl}"
                           Margin="0,12,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#475569"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>