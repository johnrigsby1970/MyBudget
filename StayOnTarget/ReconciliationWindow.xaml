<Window x:Class="StayOnTarget.ReconciliationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:StayOnTarget"
        xmlns:converters="clr-namespace:StayOnTarget.Converters"
        xmlns:helpers="clr-namespace:StayOnTarget" 
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="ReconciliationWindow" Height="450" Width="750">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding InitializeDataCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Window.Resources>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0" />
            <Setter Property="VerticalGridLinesBrush" Value="#E2E8F0" />
        
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
        
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
        
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="Background" Value="White" />
            <Setter Property="GridLinesVisibility" Value="All" />
        </Style>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#E2E8F0" />
        
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        
            <Setter Property="Padding" Value="8,6,8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        
            <Setter Property="SeparatorBrush" Value="#CBD5E1"/>
        </Style>
        <Style x:Key="RightAlignedHeaderStyle" 
               TargetType="{x:Type DataGridColumnHeader}" 
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
    
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="CenterAlignedHeaderStyle" 
               TargetType="{x:Type DataGridColumnHeader}" 
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
    
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:AccountTypeToVisibilityConverter x:Key="AccountTypeToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="10">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" x:Name="HeaderLabel" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,5" Orientation="Horizontal">
                                        <Label Content="Beginning balance:" Margin="0,0" />
                                        <Label
                                            Content="{Binding BeginningBalance, StringFormat=C}"
                                            Width="Auto" Margin="0,0" />
                                        
                                    </StackPanel>
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding ReconciliationTransactions}"
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      IsReadOnly="True"
                      PreviewKeyDown="ReconciliationDataGrid_PreviewKeyDown" 
                      SelectionMode="Single"
                      >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date"
                                        HeaderStyle="{StaticResource CenterAlignedHeaderStyle}"
                                        Binding="{Binding TransactionDate, StringFormat='{}{0:MM/dd/yyyy}'}"
                                        IsReadOnly="False" Width="90"  >
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Center" />
                                <!-- <Setter Property="Padding" Value="0,0,8,0" />  -->
                    
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Description"
                                        Binding="{Binding Description}" Width="*" />
                    
                    <DataGridTextColumn Header="From" Binding="{Binding AccountName}"
                                        Width="100" />
                    <DataGridTextColumn Header="To" Binding="{Binding ToAccountName}"
                                        Width="100" />
                    <DataGridTextColumn Header="Amount"
                                        HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                        Binding="{Binding Amount, StringFormat=C}"
                                        Width="80" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right" />
                            <Setter Property="Padding" Value="0,0,8,0" /> 
                            <!-- <Setter Property="Foreground"  -->
                            <!--         Value="{Binding Amount, Converter={StaticResource AmountToBrushConverter}}" /> -->
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Reconciled" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    IsChecked="{Binding IsReconciled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Checked="HandleCheck" Unchecked="HandleUnchecked" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="Balance"
                                        HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                        Binding="{Binding RunningBalance, StringFormat=C}"
                                        Width="80" >
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="Padding" Value="0,0,8,0" /> 
                                <!-- <Setter Property="Foreground"  -->
                                <!--         Value="{Binding RunningBalance, Converter={StaticResource AmountToBrushConverter}}" /> -->
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
                <StackPanel Grid.Row="2" Margin="0,5"
                            Orientation="Horizontal">
                    <Label Content="Ending balance:" Margin="0,0" />
                    <Label
                        Content="{Binding EndingBalance, StringFormat=C}"
                        Width="100" Margin="0,0" />
                    <Button Content="Set Ending Balance" Command="{Binding ShowAdjustmentCommand}"
                            Width="120" 
                            Margin="10,0,10,0">
                    </Button>
                    
                    <!-- <StackPanel Orientation="Horizontal" -->
                    <!--             Visibility="{Binding Account.Type, ConverterParameter='RealEstate|AppreciatingAsset|Investment|Brokerage|Retirement401k|CD|CollegeFund', Converter={StaticResource AccountTypeToVisibilityConverter}}"> -->
                    <!--     <Label Content="Current Value:" Margin="20,0,0,0" /> -->
                    <!--     ~1~ <TextBox @1@ -->
                    <!--     ~1~     Text="{Binding CurrentAssetValue, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" @1@ -->
                    <!--     ~1~     Width="80" Margin="0,0" VerticalContentAlignment="Center" /> @1@ -->
                    <!--     ~1~ @1@ -->
                    <!--     <TextBox  -->
                    <!--              helpers:TextBoxBehavior.IsNumericOnly="True" -->
                    <!--              Text="{Binding CurrentAssetValue, UpdateSourceTrigger=PropertyChanged, Delay=500, StringFormat={}{0:0.00;-0.00;''}}" -->
                    <!--              Width="80" Margin="0,0" /> -->
                    <!--      -->
                    <!--     <Button Content="Set Ending Balance"  -->
                    <!--             Command="{Binding AdjustBalanceCommand}" -->
                    <!--             Margin="10,0,0,0" Padding="10,0" /> -->
                    <!-- </StackPanel> -->
                </StackPanel>
                
                <StackPanel Grid.Row="3" Margin="0,5"
                            Orientation="Horizontal" 
                            Visibility="{Binding Account.Type, ConverterParameter='CreditCard|Checking|Savings|Mortgage|PersonalLoan|Investment|CD|Retirement401k|Brokerage|CollegeFund|Cash|Auto', Converter={StaticResource AccountTypeToVisibilityConverter}, FallbackValue=Collapsed}">
                    
                    <Label Content="Reconciled balance:" Margin="0,0" />
                    <TextBox 
                        helpers:TextBoxBehavior.IsNumericOnly="True"
                        Text="{Binding NewReconciledBalance, UpdateSourceTrigger=PropertyChanged, Delay=500, StringFormat={}{0:0.00;-0.00;''}}"
                        Width="80" Margin="0,0" />
                    <Label Content="Reconciled date:" Margin="0,0" />
                    <DatePicker Grid.Column="1" Grid.Row="0"
                                SelectedDate="{Binding NewReconciledDate, UpdateSourceTrigger=PropertyChanged}"
                                Width="80" Margin="0,0" />
                                        
                </StackPanel>
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    
                    <Button Content="Import" Command="{Binding ImportAccountCommand}"
                            Width="80" 
                            Background="YellowGreen"
                            Margin="0,0,10,0"
                            Click="HandleImportAccount_Click">
                    </Button>
                    <Button Content="Reconcile" Width="80" Margin="0,0,10,0" 
                            Click="OkButton_Click" IsDefault="True"
                            Background="CornflowerBlue" 
                            Foreground="White"/>
                    <Button Content="Cancel" Width="80" Click="CancelButton_Click" IsCancel="True"
                            />
                </StackPanel>
                </Grid>
        </DockPanel>
        
        <!-- CSV Mapping Overlay -->
        <Grid Background="#80000000" Visibility="{Binding IsBalanceAdjustmentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" Width="400" VerticalAlignment="Center" Padding="20" CornerRadius="8" BorderBrush="Gray" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Update Account Balance" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" />
        
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
        
                        <Label Grid.Row="0" Grid.Column="0" Content="Current ledger balance:" Margin="0,5,0,5" />
                        <Label Grid.Row="0" Grid.Column="1" Content="{Binding NewReconciledBalance, StringFormat={}{0:0.00;-0.00;''}}" Margin="0,0" />
                        
                        <Label Grid.Row="1" Grid.Column="0" Content="Today's value:" Margin="0,5,0,5" />
                        <TextBox  Grid.Row="1" Grid.Column="1" 
                                  helpers:TextBoxBehavior.IsNumericOnly="True"
                                  HorizontalAlignment="Left"
                                  Text="{Binding CurrentAssetValue, UpdateSourceTrigger=PropertyChanged, Delay=500, StringFormat={}{0:0.00;-0.00;''}}"
                                  Width="80" Margin="0,5,0,5" />
                        
                        <Separator Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  Margin="0,5,0,5" />
                        
                        <Label Grid.Row="3" Grid.Column="0" Content="Adjustment transaction:" Margin="0,5,0,5"   Visibility="{Binding AdjustmentTransactionAmount, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <!-- <Label Grid.Row="3" Grid.Column="1" Content="{Binding AdjustmentTransactionAmount}" ContentStringFormat="C" Margin="0,0" Visibility="{Binding AdjustmentTransactionAmount, Converter={StaticResource NullToVisibilityConverter}}"/> -->
                        <!-- -->
                        <TextBlock Grid.Row="3" Grid.Column="1"   Margin="0,5,0,5"
                                   TextWrapping="Wrap" 
                                   Visibility="{Binding AdjustmentTransactionAmount, Converter={StaticResource NullToVisibilityConverter}}"
                                   MaxWidth="400" >
                            <Run Text="{Binding AdjustmentTransactionAmount, Mode=OneWay, StringFormat=C}" />
                            <Run Text=" " />
                            <Run Text="{Binding AdjustmentTransactionDescription, Mode=OneWay}" />
                        </TextBlock>
                        
                        <Label Grid.Row="4" Grid.Column="0" Content="Memo:" Margin="0,5,0,5" Visibility="{Binding AdjustmentTransactionAmount, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <TextBox  Grid.Row="4" Grid.Column="1" 
                                  Visibility="{Binding AdjustmentTransactionAmount, Converter={StaticResource NullToVisibilityConverter}}"
                                  HorizontalAlignment="Left"
                                  Text="{Binding AdjustmentTransactionMemo, UpdateSourceTrigger=PropertyChanged}"
                                  Width="200" Margin="0,5,0,5" />

                    </Grid>
                    
                    <TextBlock Text="This will enter a new transaction to bring the account balance to the desired amount. You may then reconcile or delete it as a normal transaction." 
                               TextWrapping="Wrap" 
                               Visibility="{Binding AdjustmentTransactionAmount, Converter={StaticResource NullToVisibilityConverter}}"
                               MaxWidth="400" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Post" Width="80" 
                                Command="{Binding AdjustBalanceCommand}"
                                Margin="0,0,10,0" Padding="10,0" />
                        
                        <Button Content="Cancel" Command="{Binding CancelAdjustmentCommand}" Width="80" Margin="0,0,10,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        
        <ContentControl Content="{Binding ActiveOverlay}" />
    </Grid>
</Window>