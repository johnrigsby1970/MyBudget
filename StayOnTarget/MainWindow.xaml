    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBackgroundBrush}"
              Foreground="{DynamicResource PrimaryTextBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_Export Transactions..." Command="{Binding ExportTransactionsCommand}" />
                <MenuItem Header="_Backup" Command="{Binding BackupCommand}" />
                <Separator />
                <MenuItem Header="_Exit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="_SetTheme" Command="{Binding SetThemeCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- Toast Notification Overlay -->
        <ItemsControl Grid.Row="1" Grid.RowSpan="2" ItemsSource="{Binding Toasts}" VerticalAlignment="Top"
                      HorizontalAlignment="Right" Margin="0,10,20,0" Panel.ZIndex="1000">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ToastViewModel}">
                    <Border Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1"
                            CornerRadius="5"
                            Margin="0,0,0,10" Padding="10" Width="300">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.5" />
                        </Border.Effect>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="X" Command="{Binding CloseCommand}"
                                    Width="20" Height="20" Margin="5,0,0,0" VerticalAlignment="Top"
                                    Background="{Binding Background}" BorderThickness="0" FontWeight="Bold"
                                    Foreground="{Binding Border}" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{Binding Text}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="450" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4*" MinWidth="450" />
            </Grid.ColumnDefinitions>

            <!-- Left Workspace: Modern Left-Rail Navigation + Content View -->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Navigation Rail -->
                    <ColumnDefinition Width="*" />    <!-- Active View Area -->
                </Grid.ColumnDefinitions>

                <!-- 1. LEFT NAVIGATION RAIL -->
                <Border x:Name="SidebarBorder" Grid.Column="0"
                        Background="{DynamicResource SidebarBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderColorBrush}"
                        BorderThickness="0,0,1,0"
                        Margin="0,0,8,0">
                    <ListBox SelectedIndex="{Binding SelectedOuterTabIndex, FallbackValue=0}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0,4">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Margin" Value="2,2" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    CornerRadius="6"
                                                    Background="Transparent"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background"
                                                            Value="{DynamicResource SidebarSelectedBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background"
                                                            Value="{DynamicResource SidebarHoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBoxItem Content="Dashboard" ToolTip="Current Period Overview" />
                        <ListBoxItem Content="Ledger" />
                        <ListBoxItem Content="Accounts" />
                        <ListBoxItem Content="Paychecks" />
                        <ListBoxItem Content="Bills" />
                        <ListBoxItem Content="Envelopes" />
                        <ListBoxItem Content="Categories" />
                    </ListBox>
                </Border>

                <!-- 2. MAIN ACTIVE VIEW PANEL -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Content Switcher replacing top TabControl -->
                    <ContentControl Grid.Row="0">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <!-- Default (Index 0): Dashboard / Current Period & Cash Requirements View -->
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Margin="10">

                                                <!-- Header Title -->
                                                <TextBlock Text="Cash Overview &amp; Planned Money"
                                                           FontSize="18" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           Margin="0,0,0,12" />

                                                <!-- CASH READINESS & ACTION SUGGESTION CARD -->
                                                <Border Background="{Binding ReadinessStatusBackgroundBrush}"
                                                        BorderBrush="{Binding ReadinessStatusBorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="14"
                                                        Margin="0,0,0,16">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding ReadinessStatusTitle}"
                                                                       FontSize="14" FontWeight="Bold"
                                                                       Foreground="{Binding ReadinessStatusHeaderBrush}"
                                                                       VerticalAlignment="Center" />

                                                            <TextBlock
                                                                Text="{Binding LowestProjectedCheckingBalance, StringFormat='Lowest Checking Point: {0:C}'}"
                                                                FontSize="11" FontWeight="SemiBold"
                                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                                DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center" />
                                                        </DockPanel>

                                                        <TextBlock Text="{Binding ReadinessSuggestionMessage}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                                   TextWrapping="Wrap" LineHeight="18" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- 1. TOP CARDS: LIQUID CASH vs UNALLOCATED SURPLUS -->
                                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                                    <!-- Total Liquid Cash -->
                                                    <Border Background="{StaticResource SurfaceBackgroundBrush}"
                                                            BorderBrush="{StaticResource BorderColorBrush}"
                                                            BorderThickness="1" CornerRadius="8" Padding="14"
                                                            Margin="0,0,6,0">
                                                        <StackPanel>
                                                            <TextBlock Text="TOTAL LIQUID CASH" FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                                            <TextBlock Text="{Binding TotalLiquidCash, StringFormat=C}"
                                                                       FontSize="24" FontWeight="Bold"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       Margin="0,4,0,0" />
                                                            <TextBlock Text="Checking &amp; Savings Total Balance"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Unallocated / Surplus Cash -->
                                                    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderColorBrush}"
                                                            BorderThickness="1" CornerRadius="8" Padding="14"
                                                            Margin="6,0,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="EXTRA CASH" FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                                            <TextBlock
                                                                Text="{Binding UnallocatedSurplusCash, StringFormat=C}"
                                                                FontSize="24" FontWeight="Bold"
                                                                Foreground="#22C55E" Margin="0,4,0,0" />
                                                            <TextBlock Text="Available to Invest or Pay Down Debt"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </UniformGrid>

                                                <!-- 2. REQUIRED ACCOUNTS RESERVES BREAKDOWN -->
                                                <!-- 2. REQUIRED ACCOUNTS RESERVES BREAKDOWN -->
                                                <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderColorBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="16"
                                                        Margin="0,0,0,16">
                                                    <StackPanel>
                                                        <TextBlock Text="Money Already Spoken For"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                                   Margin="0,0,0,12" />

                                                        <!-- 1. Minimum Balance Cushion -->
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Minimum Balance Cushion"
                                                                           FontWeight="Medium"
                                                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                                                <TextBlock
                                                                    Text="Cash kept in checking/savings as a safety buffer"
                                                                    FontSize="11"
                                                                    Foreground="{StaticResource SecondaryTextBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding EnvelopeFloorRequirements, StringFormat=C}"
                                                                       FontWeight="Bold"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource PrimaryTextBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding IsMinimumBalanceCushionBreached}"
                                                                                Value="True">
                                                                                <Setter Property="Foreground"
                                                                                    Value="#EF4444" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <Separator Background="{DynamicResource BorderColorBrush}"
                                                                   Margin="0,8" Opacity="0.5" />

                                                        <!-- 2. Savings Goals & Future Funds -->
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Savings Goals &amp; Future Funds"
                                                                           FontWeight="Medium"
                                                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                                                <TextBlock
                                                                    Text="Money saved and put aside for larger or upcoming plans"
                                                                    FontSize="11"
                                                                    Foreground="{StaticResource SecondaryTextBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding AccumulatingDrawdownReserves, StringFormat=C}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>

                                                        <Separator Background="{DynamicResource BorderColorBrush}"
                                                                   Margin="0,8" Opacity="0.5" />

                                                        <!-- 3. Unpaid Period Bills -->
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Unpaid Period Bills"
                                                                           FontWeight="Medium"
                                                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                                                <TextBlock
                                                                    Text="Required balance to satisfy remaining bills this period"
                                                                    FontSize="11"
                                                                    Foreground="{StaticResource SecondaryTextBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding UpcomingBillsRequirements, StringFormat=C}"
                                                                       FontWeight="Bold"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource PrimaryTextBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding IsUnpaidBillsAlert}"
                                                                                Value="True">
                                                                                <Setter Property="Foreground"
                                                                                    Value="#EF4444" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <Separator Background="{DynamicResource BorderColorBrush}"
                                                                   Margin="0,8" Opacity="0.5" />

                                                        <!-- 4. Remaining Everyday Budget -->
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Remaining Everyday Budget"
                                                                           FontWeight="Medium"
                                                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                                                <TextBlock
                                                                    Text="Required balance to satisfy remaining budgeted envelope spending this period"
                                                                    FontSize="11"
                                                                    TextWrapping="Wrap"
                                                                    Foreground="{StaticResource SecondaryTextBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding UnspentStandardEnvelopeRequirements, StringFormat=C}"
                                                                       FontWeight="Bold"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <!-- Default Neutral Color -->
                                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                                                        <Style.Triggers>
                                                                            <!-- Warning Trigger: Amber/Orange when an envelope is overspent -->
                                                                            <DataTrigger Binding="{Binding HasOverspentEnvelopes}" Value="True">
                                                                                <Setter Property="Foreground" Value="#F59E0B" />
                                                                            </DataTrigger>
                                                                            <!-- Critical Trigger: Red if total cash can't cover committed reserves -->
                                                                            <DataTrigger Binding="{Binding IsTotalCommittedFundsBreached}" Value="True">
                                                                                <Setter Property="Foreground" Value="#EF4444" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <Separator Background="{DynamicResource BorderColorBrush}"
                                                                   Margin="0,8" Opacity="0.5" />

                                                        <!-- Total Required Reserves Summary Row -->
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Total Committed Funds:"
                                                                           FontWeight="Bold" FontSize="13"
                                                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                                                <TextBlock
                                                                    Text="Total cash reserved for cushions, savings goals, bills, and everyday budget"
                                                                    FontSize="11"
                                                                    TextWrapping="Wrap"
                                                                    Foreground="{StaticResource SecondaryTextBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding TotalRequiredReserves, StringFormat=C}"
                                                                       FontWeight="Bold" FontSize="13">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <!-- Set Default Foreground here in the style setter, NOT directly on the TextBlock tag -->
                                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsTotalCommittedFundsBreached}" Value="True">
                                                                                <Setter Property="Foreground" Value="#EF4444" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- WHERE EXTRA CASH GOES -->
                                                <Border Background="{StaticResource SurfaceBackgroundBrush}"
                                                        BorderBrush="{StaticResource BorderColorBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="16">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,12">
                                                            <TextBlock Text="Where Extra Cash Goes"
                                                                       FontSize="14" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding StrategyDisplayName}"
                                                                       FontSize="11" FontWeight="Bold"
                                                                       Foreground="#3B82F6"
                                                                       DockPanel.Dock="Right"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center" />
                                                        </DockPanel>

                                                        <UniformGrid Columns="3">
                                                            <!-- 1. Debt Target -->
                                                            <Border Background="White" BorderBrush="#CBD5E1"
                                                                    BorderThickness="1" CornerRadius="6" Padding="10"
                                                                    Margin="0,0,4,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="Swept Toward Debt" FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                                                    <TextBlock
                                                                        Text="{Binding RecommendedDebtAllocation, StringFormat=C}"
                                                                        FontSize="16" FontWeight="Bold"
                                                                        Foreground="#0F172A" Margin="0,4,0,0" />
                                                                    <TextBlock Text="Put towards debt payoff"
                                                                               FontSize="10"
                                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                                               Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- 2. Investment Target -->
                                                            <Border Background="White" BorderBrush="#CBD5E1"
                                                                    BorderThickness="1" CornerRadius="6" Padding="10"
                                                                    Margin="2,0,2,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="Swept To Investments"
                                                                               FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                                                    <TextBlock
                                                                        Text="{Binding RecommendedInvestmentAllocation, StringFormat=C}"
                                                                        FontSize="16" FontWeight="Bold"
                                                                        Foreground="#0F172A" Margin="0,4,0,0" />
                                                                    <TextBlock Text="Put towards growth accounts"
                                                                               FontSize="10"
                                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                                               Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- 3. Retained Checking Cushion -->
                                                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1"
                                                                    BorderThickness="1" CornerRadius="6" Padding="10"
                                                                    Margin="4,0,0,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="Kept In Checking" FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                                                    <TextBlock
                                                                        Text="{Binding RetainedCheckingBuffer, StringFormat=C}"
                                                                        FontSize="16" FontWeight="Bold"
                                                                        Foreground="#64748B" Margin="0,4,0,0" />
                                                                    <TextBlock Text="Play $$, fun funds, be good ..."
                                                                               FontSize="10"
                                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                                               Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </UniformGrid>
                                                    </StackPanel>
                                                </Border>

                                            </StackPanel>
                                        </ScrollViewer>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- Index 1: Ledger View -->
                                    <DataTrigger Binding="{Binding SelectedOuterTabIndex}" Value="1">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Top" Margin="5"
                                                                HorizontalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center" Margin="5">
                                                            <CheckBox Content="Show by Month"
                                                                      IsChecked="{Binding ShowByMonth}"
                                                                      VerticalAlignment="Center" Margin="5"
                                                                      Foreground="{StaticResource PrimaryTextBrush}" />
                                                            <ComboBox ItemsSource="{Binding PeriodPaychecks}"
                                                                      DisplayMemberPath="Name"
                                                                      SelectedValuePath="Id"
                                                                      SelectedValue="{Binding SelectedPeriodPaycheckId}"
                                                                      Width="150" Margin="5"
                                                                      Visibility="{Binding ShowByMonth, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center">
                                                            <Button Content=" &lt; "
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding PrevPeriodCommand}" Width="40"
                                                                    Margin="5" />
                                                            <TextBlock Text="{Binding PeriodDisplay}"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       VerticalAlignment="Center" FontWeight="Bold"
                                                                       FontSize="14" Margin="10,0" />
                                                            <Button Content=" &gt; "
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding NextPeriodCommand}" Width="40"
                                                                    Margin="5" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TabControl Style="{StaticResource InnerTabControlStyle}"
                                                                ItemContainerStyle="{StaticResource ModernUnderlineTabItemStyle}"
                                                                SelectedIndex="{Binding SelectedInnerTabIndex}">
                                                        <TabItem Header="Transaction">
                                                            <DockPanel>
                                                                <Grid DockPanel.Dock="Bottom">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Left" Margin="0,5,0,0">
                                                                        <Button Content="Delete"
                                                                                Command="{Binding DeleteTransactionCommand}"
                                                                                Width="80" Margin="2">
                                                                            <Button.Style>
                                                                                <Style TargetType="Button"
                                                                                    BasedOn="{StaticResource DangerButtonStyle}">
                                                                                    <Setter Property="Visibility"
                                                                                        Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger
                                                                                            Binding="{Binding EditingTransactionClone.TransactionId, Converter={StaticResource NullToVisibilityConverter}}"
                                                                                            Value="Collapsed">
                                                                                            <Setter
                                                                                                Property="Visibility"
                                                                                                Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger
                                                                                            Binding="{Binding IsEditingTransaction}"
                                                                                            Value="False">
                                                                                            <Setter
                                                                                                Property="Visibility"
                                                                                                Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Right"
                                                                            Margin="0,5,0,0">
                                                                        <Button Content="Add"
                                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                                Command="{Binding AddTransactionCommand}"
                                                                                Visibility="{Binding IsNotEditingTransaction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                Width="80" Margin="2" />
                                                                        <Button Content="Edit"
                                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                                Command="{Binding EditTransactionCommand}"
                                                                                Width="80" Margin="2">
                                                                            <Button.Visibility>
                                                                                <MultiBinding
                                                                                    Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                                                    <Binding Path="CanEditTransaction" />
                                                                                    <Binding
                                                                                        Path="IsNotEditingTransaction" />
                                                                                </MultiBinding>
                                                                            </Button.Visibility>
                                                                        </Button>
                                                                        <Button Content="Save"
                                                                                Command="{Binding SaveTransactionCommand}"
                                                                                Width="80" Margin="2"
                                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                                IsEnabled="{Binding IsEditingTransactionEnabled}"
                                                                                Visibility="{Binding IsEditingTransaction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                        <Button Content="Cancel"
                                                                                Command="{Binding CancelTransactionCommand}"
                                                                                Width="80" Margin="2"
                                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                                Visibility="{Binding IsEditingTransaction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>

                                                                    <DataGrid Grid.Row="0"
                                                                              ItemsSource="{Binding Source={StaticResource SortedCurrentPeriodTransactions}}"
                                                                              SelectedItem="{Binding SelectedTransaction}"
                                                                              AutoGenerateColumns="False"
                                                                              HorizontalScrollBarVisibility="Auto"
                                                                              CanUserAddRows="False"
                                                                              IsReadOnly="True">
                                                                        <DataGrid.InputBindings>
                                                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                                                    Command="{Binding EditTransactionCommand}" />
                                                                        </DataGrid.InputBindings>
                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn Header="Posting Date"
                                                                                    HeaderStyle="{StaticResource CenterAlignedHeaderStyle}"
                                                                                    Binding="{Binding TransactionDate, StringFormat='{}{0:MM/dd/yyyy}'}"
                                                                                    IsReadOnly="False" Width="90">
                                                                                <DataGridTextColumn.ElementStyle>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter
                                                                                            Property="TextAlignment"
                                                                                            Value="Center" />
                                                                                    </Style>
                                                                                </DataGridTextColumn.ElementStyle>
                                                                            </DataGridTextColumn>
                                                                            <DataGridTextColumn Header="Description"
                                                                                    Binding="{Binding Description}"
                                                                                    Width="Auto" MinWidth="100" />
                                                                            <DataGridTextColumn Header="Amount"
                                                                                    HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                                                    Binding="{Binding Amount, StringFormat=C}"
                                                                                    Width="85" MinWidth="80">
                                                                                <DataGridTextColumn.ElementStyle>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter
                                                                                            Property="TextAlignment"
                                                                                            Value="Right" />
                                                                                        <Setter Property="Padding"
                                                                                            Value="0,0,8,0" />
                                                                                        <Setter Property="Foreground"
                                                                                            Value="{Binding Amount, Converter={StaticResource AmountToBrushConverter}}" />
                                                                                    </Style>
                                                                                </DataGridTextColumn.ElementStyle>
                                                                            </DataGridTextColumn>
                                                                            <DataGridTextColumn Header="From"
                                                                                    Binding="{Binding AccountName}"
                                                                                    Width="Auto" MinWidth="100" />
                                                                            <DataGridTextColumn Header="To"
                                                                                    Binding="{Binding ToAccountName}"
                                                                                    Width="Auto" MinWidth="100" />
                                                                            <DataGridTextColumn Header="Category"
                                                                                    Binding="{Binding Converter={StaticResource CategoryNameConverter}}"
                                                                                    Width="Auto" MinWidth="100" />
                                                                            <DataGridTextColumn Header="Memo"
                                                                                    Binding="{Binding Memo}"
                                                                                    Width="Auto" MinWidth="100" />
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>

                                                                    <StackPanel Grid.Row="1" Margin="5"
                                                                            IsEnabled="{Binding IsEditingTransactionEnabled}">
                                                                        <TextBlock Text="Edit Transaction Item"
                                                                                FontWeight="Bold" Margin="0,5"
                                                                                Visibility="{Binding IsEditingTransaction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                        <Grid
                                                                            Visibility="{Binding IsEditingTransaction, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>

                                                                            <Label Grid.Column="0" Grid.Row="0"
                                                                                    Content="Date:" />
                                                                            <DatePicker Grid.Column="1" Grid.Row="0"
                                                                                    SelectedDate="{Binding EditingTransactionClone.TransactionDate}"
                                                                                    Margin="5" />

                                                                            <Label Grid.Column="0" Grid.Row="1"
                                                                                    Content="Description:" />
                                                                            <ComboBox Grid.Column="1" Grid.Row="1"
                                                                                    ItemsSource="{Binding FilteredBillsView}"
                                                                                    DisplayMemberPath="Name"
                                                                                    SelectedValuePath="Id"
                                                                                    SelectedValue="{Binding EditingTransactionClone.BillId}"
                                                                                    Text="{Binding EditingTransactionClone.Description, UpdateSourceTrigger=PropertyChanged}"
                                                                                    IsEditable="True"
                                                                                    IsTextSearchEnabled="False"
                                                                                    StaysOpenOnEdit="True" Margin="5">
                                                                                <ComboBox.Style>
                                                                                    <Style TargetType="ComboBox"
                                                                                        BasedOn="{StaticResource {x:Type ComboBox}}">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger
                                                                                                Binding="{Binding EditingTransactionClone.Description}"
                                                                                                Value="{x:Static local:Constants.OpeningBalance}">
                                                                                                <Setter
                                                                                                    Property="IsEnabled"
                                                                                                    Value="False" />
                                                                                            </DataTrigger>
                                                                                            <Trigger
                                                                                                Property="IsKeyboardFocusWithin"
                                                                                                Value="True">
                                                                                                <Setter
                                                                                                    Property="IsDropDownOpen"
                                                                                                    Value="True" />
                                                                                            </Trigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </ComboBox.Style>
                                                                            </ComboBox>
                                                                            <Label Grid.Column="2" Grid.Row="1"
                                                                                    Content="Memo:" />
                                                                            <TextBox Grid.Column="3" Grid.Row="1"
                                                                                    Text="{Binding EditingTransactionClone.Memo}"
                                                                                    Margin="5" />

                                                                            <Label Grid.Column="0" Grid.Row="2"
                                                                                    Content="Amount:" />
                                                                            <controls:NumericTextBox Grid.Column="1"
                                                                                    Grid.Row="2"
                                                                                    Text="{Binding EditingTransactionClone.Amount, Converter={StaticResource AbsoluteValueConverter}}"
                                                                                    Margin="5" />

                                                                            <Label Grid.Column="0" Grid.Row="3"
                                                                                    Content="From Account:" />
                                                                            <ComboBox Grid.Column="1" Grid.Row="3"
                                                                                    x:Name="FromAccountComboBox"
                                                                                    ItemsSource="{Binding TransactionAccounts}"
                                                                                    SelectedValue="{Binding EditingTransactionClone.AccountId}"
                                                                                    SelectedValuePath="Id"
                                                                                    DisplayMemberPath="Name" Margin="5" />

                                                                            <Label Grid.Column="2" Grid.Row="3"
                                                                                    Content="To Account:" />
                                                                            <ComboBox Grid.Column="3" Grid.Row="3"
                                                                                    x:Name="ToAccountComboBox"
                                                                                    ItemsSource="{Binding TransactionToAccounts}"
                                                                                    SelectedValue="{Binding EditingTransactionClone.ToAccountId}"
                                                                                    SelectedValuePath="Id"
                                                                                    DisplayMemberPath="Name" Margin="5" />

                                                                            <Label Grid.Column="0" Grid.Row="4"
                                                                                    Content="Bill:" />
                                                                            <ComboBox Grid.Column="1" Grid.Row="4"
                                                                                    x:Name="BillComboBox"
                                                                                    ItemsSource="{Binding BillsWithNone}"
                                                                                    SelectedValue="{Binding EditingTransactionClone.BillId}"
                                                                                    SelectedValuePath="Id"
                                                                                    DisplayMemberPath="Name" Margin="5" />

                                                                            <Label Grid.Column="0" Grid.Row="5"
                                                                                    Content="Sub Category:" />
                                                                            <ComboBox Grid.Column="1" Grid.Row="5"
                                                                                    x:Name="SubCategoryComboBox"
                                                                                    ItemsSource="{Binding SubCategoriesWithNone}"
                                                                                    SelectedValue="{Binding EditingTransactionClone.SubCategoryId}"
                                                                                    SelectedValuePath="Id"
                                                                                    DisplayMemberPath="Name" Margin="5" />

                                                                            <Label Grid.Column="2" Grid.Row="5"
                                                                                    Content="Envelope:" />
                                                                            <ComboBox Grid.Column="3" Grid.Row="5"
                                                                                    x:Name="BucketComboBox"
                                                                                    ItemsSource="{Binding BucketsWithNone}"
                                                                                    SelectedValue="{Binding EditingTransactionClone.BucketId}"
                                                                                    SelectedValuePath="Id"
                                                                                    DisplayMemberPath="Name" Margin="5" />

                                                                            <Label Grid.Column="0" Grid.Row="6"
                                                                                    Content="Paycheck:">
                                                                                <Label.Visibility>
                                                                                    <MultiBinding
                                                                                        Converter="{StaticResource PaycheckFieldVisibilityConverter}"
                                                                                        FallbackValue="Collapsed">
                                                                                        <Binding
                                                                                            Path="EditingTransactionClone.ToAccountId" />
                                                                                        <Binding Path="Accounts" />
                                                                                    </MultiBinding>
                                                                                </Label.Visibility>
                                                                            </Label>
                                                                            <ComboBox Grid.Column="1" Grid.Row="6"
                                                                                    ItemsSource="{Binding Paychecks}"
                                                                                    SelectedValue="{Binding EditingTransactionClone.PaycheckId}"
                                                                                    SelectedValuePath="Id"
                                                                                    DisplayMemberPath="Name" Margin="5">
                                                                                <ComboBox.Visibility>
                                                                                    <MultiBinding
                                                                                        Converter="{StaticResource PaycheckFieldVisibilityConverter}"
                                                                                        FallbackValue="Collapsed">
                                                                                        <Binding
                                                                                            Path="EditingTransactionClone.ToAccountId" />
                                                                                        <Binding Path="Accounts" />
                                                                                    </MultiBinding>
                                                                                </ComboBox.Visibility>
                                                                            </ComboBox>

                                                                            <Label Grid.Column="2" Grid.Row="6"
                                                                                    Content="Payroll Date:">
                                                                                <Label.Visibility>
                                                                                    <MultiBinding
                                                                                        Converter="{StaticResource PaycheckFieldVisibilityConverter}"
                                                                                        FallbackValue="Collapsed">
                                                                                        <Binding
                                                                                            Path="EditingTransactionClone.ToAccountId" />
                                                                                        <Binding Path="Accounts" />
                                                                                    </MultiBinding>
                                                                                </Label.Visibility>
                                                                            </Label>
                                                                            <DatePicker Grid.Column="3" Grid.Row="6"
                                                                                    SelectedDate="{Binding EditingTransactionClone.PaycheckOccurrenceDate}"
                                                                                    Margin="5">
                                                                                <DatePicker.Visibility>
                                                                                    <MultiBinding
                                                                                        Converter="{StaticResource PaycheckFieldVisibilityConverter}"
                                                                                        FallbackValue="Collapsed">
                                                                                        <Binding
                                                                                            Path="EditingTransactionClone.ToAccountId" />
                                                                                        <Binding Path="Accounts" />
                                                                                    </MultiBinding>
                                                                                </DatePicker.Visibility>
                                                                            </DatePicker>

                                                                            <StackPanel Grid.Column="0" Grid.Row="7"
                                                                                    Grid.ColumnSpan="4"
                                                                                    Orientation="Horizontal" Margin="5">
                                                                                <CheckBox
                                                                                    Content="Principal Only (Mortgage/Loan Extra)"
                                                                                    IsChecked="{Binding EditingTransactionClone.IsPrincipalOnly}"
                                                                                    VerticalAlignment="Center"
                                                                                    Margin="0,0,10,0"
                                                                                    Visibility="{Binding SelectedItem, ElementName=ToAccountComboBox, ConverterParameter='Mortgage|PersonalLoan|HELOC|StudentLoan', Converter={StaticResource AccountTypeToVisibilityConverter}, FallbackValue=Collapsed}" />
                                                                                <CheckBox
                                                                                    Content="Rebalance (Adds to Debt)"
                                                                                    IsChecked="{Binding EditingTransactionClone.IsRebalance}"
                                                                                    VerticalAlignment="Center"
                                                                                    Visibility="{Binding SelectedItem, ElementName=ToAccountComboBox, ConverterParameter='Mortgage|PersonalLoan|HELOC|StudentLoan', Converter={StaticResource AccountTypeToVisibilityConverter}, FallbackValue=Collapsed}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DockPanel>
                                                        </TabItem>
                                                        <TabItem Header="Bills">
                                                            <DockPanel>
                                                                <Grid DockPanel.Dock="Bottom">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Left" Margin="5">
                                                                        <Button Content="Delete"
                                                                                Command="{Binding DeletePeriodBillCommand}"
                                                                                Width="80" Margin="2"
                                                                                Style="{StaticResource DangerButtonStyle}"
                                                                                Visibility="{Binding IsEditingPeriodBill, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Right" Margin="5">
