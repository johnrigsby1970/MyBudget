                                                             Margin="5" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Envelopes">
                        <DockPanel>
                            <Grid DockPanel.Dock="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="Delete" Command="{Binding DeleteBucketCommand}"
                                            Margin="5"
                                            Width="80"
                                            Background="Red"
                                            Foreground="White">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding EditingBucketClone.Id, Converter={StaticResource IntToVisibilityConverter}}"
                                                        Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEditingBucket}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
