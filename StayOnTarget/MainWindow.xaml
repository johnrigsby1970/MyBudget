                                                                    Width="80"
                                                                    Visibility="{Binding IsNotEditingBucket, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <Button Content="Edit"
                                                                    Style="{DynamicResource    SecondaryButtonStyle}"
                                                                    Command="{Binding EditBucketCommand}"
                                                                    Margin="5"
                                                                    Width="80">
