                                                                                    VerticalAlignment="Center"
                                                                                    Margin="6,0" />
                                                                                <TextBlock Text="{Binding Name}"
                                                                                    VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
