                                                                                                <Hyperlink
                                                                                                    Command="{Binding DataContext.PayPeriodBillCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                                    CommandParameter="{Binding}">
                                                                                                    Enter Payment
                                                                                                </Hyperlink>
                                                                                            </TextBlock>
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </DataGridTemplateColumn.CellTemplate>
                                                                            </DataGridTemplateColumn>
                                                                            <DataGridTextColumn Header="Due Date"
                                                                                    HeaderStyle="{DynamicResource    CenterAlignedHeaderStyle}"
                                                                                    Binding="{Binding DueDate, StringFormat='{}{0:MM/dd/yyyy}'}"
                                                                                    IsReadOnly="False"
                                                                                    Width="80">
                                                                                <DataGridTextColumn.ElementStyle>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter
                                                                                            Property="TextAlignment"
                                                                                            Value="Center" />
                                                                                    </Style>
                                                                                </DataGridTextColumn.ElementStyle>
                                                                            </DataGridTextColumn>
                                                                            <DataGridTextColumn
                                                                                Header="Expected Amount"
                                                                                Binding="{Binding ActualAmount, StringFormat=C}"
                                                                                Width="100">
                                                                                <DataGridTextColumn.ElementStyle>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter
                                                                                            Property="TextAlignment"
                                                                                            Value="Right" />
                                                                                        <Setter Property="Padding"
                                                                                            Value="0,0,8,0" />
                                                                                    </Style>
                                                                                </DataGridTextColumn.ElementStyle>
                                                                            </DataGridTextColumn>
                                                                            <DataGridTextColumn
                                                                                Header="Actual Amount"
                                                                                Binding="{Binding TransactionAmount, Converter={StaticResource AbsoluteValueConverter}, StringFormat=C}"
                                                                                IsReadOnly="True"
                                                                                Width="100">
                                                                                <DataGridTextColumn.ElementStyle>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter
                                                                                            Property="TextAlignment"
                                                                                            Value="Right" />
                                                                                        <Setter Property="Padding"
                                                                                            Value="0,0,8,0" />
                                                                                    </Style>
                                                                                </DataGridTextColumn.ElementStyle>
                                                                            </DataGridTextColumn>
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>
                                                                    <StackPanel
                                                                        Grid.Row="2"
                                                                        Margin="10"
                                                                        Visibility="{Binding IsEditingPeriodBill, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock
                                                                            Style="{DynamicResource    StyledTextBlock}"
                                                                            Text="Edit Period Bill"
                                                                            FontWeight="Bold"
                                                                            Margin="0,0,0,5" />
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Label
                                                                                Style="{DynamicResource    StyledLabel}"
                                                                                Grid.Column="0"
                                                                                Content="Name:" />
                                                                            <TextBox Grid.Column="1"
                                                                                    Text="{Binding EditingPeriodBillClone.BillName, UpdateSourceTrigger=PropertyChanged}"
                                                                                    IsEnabled="False"
                                                                                    Margin="5" />
                                                                            <Label
                                                                                Style="{DynamicResource    StyledLabel}"
                                                                                Grid.Column="2" Content="Budgeted:" />
                                                                            <controls:NumericTextBox
                                                                                Grid.Column="3"
                                                                                Text="{Binding EditingPeriodBillClone.ActualAmount, UpdateSourceTrigger=PropertyChanged}"
                                                                                Margin="5" />
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DockPanel>
                                                        </TabItem>
                                                        <TabItem Header="Envelopes">
                                                            <DockPanel>
                                                                <Grid DockPanel.Dock="Bottom">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Left"
                                                                            Margin="5">
                                                                        <Button Content="Delete"
                                                                                Command="{Binding DeletePeriodBucketCommand}"
                                                                                Width="80" Margin="2">
                                                                            <Button.Style>
                                                                                <Style TargetType="Button"
                                                                                    BasedOn="{StaticResource DangerButtonStyle}">
                                                                                    <Setter Property="Visibility"
                                                                                        Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition
                                                                                                    Binding="{Binding IsEditingPeriodBucket}"
                                                                                                    Value="True" />
                                                                                                <Condition
                                                                                                    Binding="{Binding EditingPeriodBucketClone.Id, Converter={StaticResource NullOrZeroToVisibilityConverter}}"
                                                                                                    Value="Visible" />
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter
                                                                                                Property="Visibility"
                                                                                                Value="Visible" />
                                                                                        </MultiDataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="2"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Right"
                                                                            Margin="5">
                                                                        <Button Content="Edit"
                                                                                Command="{Binding EditPeriodBucketCommand}"
                                                                                Width="80" Margin="2">
                                                                            <Button.Visibility>
                                                                                <MultiBinding
                                                                                    Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                                                    <Binding
                                                                                        Path="CanEditPeriodBucket" />
                                                                                    <Binding
                                                                                        Path="IsNotEditingPeriodBucket" />
                                                                                </MultiBinding>
                                                                            </Button.Visibility>
                                                                        </Button>
                                                                        <Button Content="Save"
                                                                                Style="{DynamicResource    PrimaryButtonStyle}"
                                                                                Command="{Binding SavePeriodBucketCommand}"
                                                                                Visibility="{Binding IsEditingPeriodBucket, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                Width="80" Margin="2" />
                                                                        <Button Content="Cancel"
                                                                                Style="{DynamicResource    SecondaryButtonStyle}"
                                                                                Command="{Binding CancelPeriodBucketCommand}"
                                                                                Visibility="{Binding IsEditingPeriodBucket, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                Width="80" Margin="2" />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <StackPanel Grid.Row="0">
                                                                        <TextBlock
                                                                            Style="{DynamicResource    StyledTextBlock}"
                                                                            Margin="5"
                                                                            TextWrapping="Wrap"
                                                                            Visibility="{Binding IsBucketDescriptionExpanded, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                            Current period envelope budgeted amounts, actual spending in those envelopes, and overrides from default estimates. To change estimates, use the envelopes menu on the left to change budget for future spending.
                                                                        </TextBlock>
                                                                    </StackPanel>

                                                                    <DataGrid Grid.Row="1"
                                                                              ItemsSource="{Binding CurrentPeriodBuckets}"
                                                                              SelectedItem="{Binding SelectedPeriodBucket}"
                                                                              AutoGenerateColumns="False"
                                                                              CanUserAddRows="False">
                                                                        <DataGrid.RowStyle>
                                                                            <Style
                                                                                TargetType="{x:Type DataGridRow}"
                                                                                BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding IsFunded}"
                                                                                        Value="True">
                                                                                        <Setter
                                                                                            Property="Background"
                                                                                            Value="#E6F4EA" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding IsSkipped}"
                                                                                        Value="True">
                                                                                        <Setter
                                                                                            Property="Background"
                                                                                            Value="#F1F3F4" />
                                                                                        <Setter
                                                                                            Property="Foreground"
                                                                                            Value="#70757A" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding HasActualAmount}"
                                                                                        Value="True">
                                                                                        <Setter
                                                                                            Property="Background"
                                                                                            Value="#CCFFCC" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding BudgetExceeded}"
                                                                                        Value="True">
                                                                                        <Setter
                                                                                            Property="Background"
                                                                                            Value="#FFCCCC" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </DataGrid.RowStyle>
                                                                        <DataGrid.InputBindings>
                                                                            <MouseBinding
                                                                                MouseAction="LeftDoubleClick"
                                                                                Command="{Binding EditPeriodBucketCommand}" />
                                                                        </DataGrid.InputBindings>
                                                                        <DataGrid.Columns>
                                                                            <DataGridTemplateColumn
                                                                                Header="Envelope"
                                                                                Width="*">
                                                                                <DataGridTemplateColumn.CellTemplate>
                                                                                    <DataTemplate>
                                                                                        <StackPanel
                                                                                            Orientation="Horizontal"
                                                                                            VerticalAlignment="Center"
                                                                                            Margin="4,0">
                                                                                            <TextBlock
                                                                                                Text="{Binding BucketName}"
                                                                                                FontWeight="SemiBold" />
                                                                                            <Border
                                                                                                Margin="8,0,0,0"
                                                                                                Padding="4,1"
                                                                                                CornerRadius="3"
                                                                                                Visibility="{Binding IsAccumulatingDrawdown, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                                <Border.Style>
                                                                                                    <Style
                                                                                                        TargetType="Border">
                                                                                                        <Setter
                                                                                                            Property="Background"
                                                                                                            Value="#E8EAED" />
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger
                                                                                                                Binding="{Binding IsFunded}"
                                                                                                                Value="True">
                                                                                                                <Setter
                                                                                                                    Property="Background"
                                                                                                                    Value="#CEEAD6" />
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger
                                                                                                                Binding="{Binding IsSkipped}"
                                                                                                                Value="True">
                                                                                                                <Setter
                                                                                                                    Property="Background"
                                                                                                                    Value="#F1F3F4" />
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Border.Style>
                                                                                                <TextBlock
                                                                                                    Text="{Binding FundingStatus}"
                                                                                                    FontSize="10"
                                                                                                    FontWeight="Bold"
                                                                                                    Foreground="#3C4043" />
                                                                                            </Border>
                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </DataGridTemplateColumn.CellTemplate>
                                                                            </DataGridTemplateColumn>

                                                                            <DataGridTextColumn
                                                                                Header="Target / Set Aside"
                                                                                Binding="{Binding ActualAmount, StringFormat=C}"
                                                                                Width="140">
                                                                                <DataGridTextColumn.ElementStyle>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter
                                                                                            Property="TextAlignment"
                                                                                            Value="Right" />
                                                                                        <Setter Property="Padding"
                                                                                            Value="0,0,8,0" />
                                                                                    </Style>
                                                                                </DataGridTextColumn.ElementStyle>
                                                                            </DataGridTextColumn>

                                                                            <DataGridTextColumn Header="Spent"
                                                                                    Binding="{Binding TransactionAmount, Converter={StaticResource AbsoluteValueConverter}, StringFormat=C}"
                                                                                    IsReadOnly="True" Width="120">
                                                                                <DataGridTextColumn.ElementStyle>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter
                                                                                            Property="TextAlignment"
                                                                                            Value="Right" />
                                                                                        <Setter Property="Padding"
                                                                                            Value="0,0,8,0" />
                                                                                    </Style>
                                                                                </DataGridTextColumn.ElementStyle>
                                                                            </DataGridTextColumn>
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>

                                                                    <StackPanel
                                                                        Grid.Row="2"
                                                                        Margin="10"
                                                                        Visibility="{Binding IsEditingPeriodBucket, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock
                                                                            FontWeight="Bold"
                                                                            Margin="0,0,0,5">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text"
                                                                                        Value="Edit Period Budget" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger
                                                                                            Binding="{Binding EditingPeriodBucketClone.IsAccumulatingDrawdown}"
                                                                                            Value="True">
                                                                                            <Setter Property="Text"
                                                                                                Value="Edit Envelope Set Aside Funding" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>

                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Label
                                                                                Style="{DynamicResource    StyledLabel}"
                                                                                Grid.Column="0"
                                                                                Content="Name:" />
                                                                            <TextBox Grid.Column="1"
                                                                                    Text="{Binding EditingPeriodBucketClone.BucketName, UpdateSourceTrigger=PropertyChanged}"
                                                                                    IsEnabled="False"
                                                                                    Margin="5" />
                                                                            <Label Grid.Column="2">
                                                                                <Label.Style>
                                                                                    <Style TargetType="Label"
                                                                                        BasedOn="{StaticResource StyledLabel}">
                                                                                        <Setter Property="Content"
                                                                                            Value="Budgeted:" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger
                                                                                                Binding="{Binding EditingPeriodBucketClone.IsAccumulatingDrawdown}"
                                                                                                Value="True">
                                                                                                <Setter
                                                                                                    Property="Content"
                                                                                                    Value="Set Aside Amount:" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Label.Style>
                                                                            </Label>
                                                                            <controls:NumericTextBox
                                                                                Grid.Column="3"
                                                                                Text="{Binding EditingPeriodBucketClone.ActualAmount, UpdateSourceTrigger=PropertyChanged}"
                                                                                Margin="5" />
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DockPanel>
                                                        </TabItem>
                                                    </TabControl>
                                                </DockPanel>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

                                    <!-- Index 2: Accounts View -->
                                    <DataTrigger Binding="{Binding SelectedOuterTabIndex}" Value="1">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Bottom">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                            <Button Content="Delete"
                                                                    Command="{Binding DeleteAccountCommand}"
                                                                    Width="80"
                                                                    Margin="2">
                                                                <Button.Style>
                                                                    <Style TargetType="Button"
                                                                           BasedOn="{StaticResource DangerButtonStyle}">
                                                                        <Setter Property="Visibility"
                                                                                Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding EditingAccountClone.Id, Converter={StaticResource IntToVisibilityConverter}}"
                                                                                Value="Collapsed">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger
                                                                                Binding="{Binding IsEditingAccount}"
                                                                                Value="False">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <Button Content="Reconcile"
                                                                    Style="{DynamicResource    SecondaryButtonStyle}"
                                                                    Command="{Binding ReconcileAccountCommand}"
                                                                    Width="80"
                                                                    Margin="2">
                                                                <Button.Visibility>
                                                                    <MultiBinding
                                                                        Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                                        <Binding Path="CanEditAccount" />
                                                                        <Binding Path="IsNotEditingAccount" />
                                                                    </MultiBinding>
                                                                </Button.Visibility>
                                                            </Button>
                                                            <Button Content="Import"
                                                                    Style="{DynamicResource    SecondaryButtonStyle}"
                                                                    Command="{Binding ImportAccountCommand}"
                                                                    Width="80"
                                                                    Margin="2">
                                                                <Button.Visibility>
                                                                    <MultiBinding
                                                                        Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                                        <Binding Path="CanEditAccount" />
                                                                        <Binding Path="IsNotEditingAccount" />
                                                                    </MultiBinding>
                                                                </Button.Visibility>
                                                            </Button>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                            <Button Content="Add"
                                                                    Style="{DynamicResource    SecondaryButtonStyle}"
                                                                    Command="{Binding AddAccountCommand}"
                                                                    Width="80"
                                                                    Margin="2"
                                                                    Visibility="{Binding IsNotEditingAccount, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <Button Content="Edit"
                                                                    Style="{DynamicResource    SecondaryButtonStyle}"
                                                                    Command="{Binding EditAccountCommand}"
                                                                    Width="80"
                                                                    Margin="2">
                                                                <Button.Visibility>
                                                                    <MultiBinding
                                                                        Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                                        <Binding Path="CanEditAccount" />
                                                                        <Binding Path="IsNotEditingAccount" />
                                                                    </MultiBinding>
                                                                </Button.Visibility>
                                                            </Button>
                                                            <Button Content="Save"
                                                                    Style="{DynamicResource    PrimaryButtonStyle}"
                                                                    Command="{Binding SaveAccountCommand}"
                                                                    Width="80"
                                                                    Margin="2"
                                                                    Visibility="{Binding IsEditingAccount, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <Button Content="Cancel"
                                                                    Style="{DynamicResource    SecondaryButtonStyle}"
                                                                    Command="{Binding CancelAccountCommand}"
                                                                    Width="80"
                                                                    Margin="2"
                                                                    Visibility="{Binding IsEditingAccount, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <DataGrid Grid.Row="0"
                                                                  ItemsSource="{Binding VisibleAccounts}"
                                                                  SelectedItem="{Binding SelectedAccount}"
                                                                  AutoGenerateColumns="False"
                                                                  HorizontalScrollBarVisibility="Auto"
                                                                  CanUserAddRows="False" IsReadOnly="True">
                                                            <DataGrid.InputBindings>
                                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                                              Command="{Binding EditAccountCommand}" />
                                                            </DataGrid.InputBindings>
                                                            <DataGrid.Columns>
                                                                <DataGridTemplateColumn Header="Name"
                                                                        MinWidth="150"
                                                                        Width="Auto">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Orientation="Horizontal"
                                                                                    VerticalAlignment="Center">
                                                                                <iconPacks1:PackIconFontAwesome
                                                                                    Kind="{Binding Type, Converter={StaticResource AccountIconConverter}}"
                                                                                    Width="16"
                                                                                    Height="16"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"
                                                                                    Margin="6,0" />
                                                                                <TextBlock
                                                                                    Style="{DynamicResource    StyledTextBlock}"
                                                                                    Text="{Binding Name}"
                                                                                    VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                                <DataGridTextColumn
                                                                    Header="Balance"
                                                                    Binding="{Binding Balance, StringFormat=C}"
                                                                    Width="100"
                                                                    MinWidth="100">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="TextAlignment"
                                                                                    Value="Right" />
                                                                            <Setter Property="Padding"
                                                                                    Value="0,0,8,0" />
                                                                            <Setter Property="Foreground"
                                                                                    Value="{Binding Balance, Converter={StaticResource AmountToBrushConverter}}" />
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>
                                                                <DataGridTemplateColumn Width="Auto" MinWidth="110"
                                                                        Header="Actions">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Button Content="Loan Amortization"
                                                                                    Style="{DynamicResource    SecondaryButtonStyle}"
                                                                                    Command="{Binding DataContext.ShowAmortizationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Visibility="{Binding Type, ConverterParameter=Mortgage, Converter={StaticResource AccountTypeToVisibilityConverter}}" />
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                                <!-- <DataGridTextColumn Header="Bank" Binding="{Binding BankName}" Width="*" MinWidth="100" /> -->
                                                                <!-- <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80" MinWidth="80" /> -->
                                                                <!-- <DataGridCheckBoxColumn Header="Include in Total" Binding="{Binding IncludeInTotal}" Width="60" MinWidth="60"> -->
                                                                <!--     <DataGridCheckBoxColumn.HeaderTemplate> -->
                                                                <!--         <DataTemplate> -->
                                                                <!--             <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" /> -->
                                                                <!--         </DataTemplate> -->
                                                                <!--     </DataGridCheckBoxColumn.HeaderTemplate> -->
                                                                <!-- </DataGridCheckBoxColumn> -->
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <StackPanel Grid.Row="1" Margin="5"
                                                                    Visibility="{Binding IsEditingAccount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Style="{DynamicResource    StyledTextBlock}"
                                                                       Text="Account Details" FontWeight="Bold"
                                                                       Margin="0,5" />
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0" Grid.Row="0" Content="Name:" />
                                                                <TextBox
                                                                    Grid.Column="1"
                                                                    Grid.Row="0"
                                                                    Text="{Binding EditingAccountClone.Name, UpdateSourceTrigger=PropertyChanged}"
                                                                    Margin="5" />
                                                                <CheckBox
                                                                    Grid.Column="2"
                                                                    Grid.Row="0"
                                                                    Content="Include In Total"
                                                                    IsChecked="{Binding EditingAccountClone.IncludeInTotal}"
                                                                    VerticalAlignment="Center"
                                                                    Margin="5" />

                                                                <Label Content="Bank:"
                                                                       Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0"
                                                                       Grid.Row="1" />
                                                                <TextBox
                                                                    Grid.Column="1"
                                                                    Grid.Row="1"
                                                                    Text="{Binding EditingAccountClone.BankName, UpdateSourceTrigger=PropertyChanged}"
                                                                    Margin="5" />

                                                                <Label Content="Type:"
                                                                       Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="2"
                                                                       Grid.Row="1" />
                                                                <StackPanel
                                                                    Grid.Column="3"
                                                                    Grid.Row="1"
                                                                    Orientation="Horizontal">
                                                                    <ComboBox ItemsSource="{Binding AccountTypes}"
                                                                              Style="{DynamicResource    StyledEnumComboBox}"
                                                                              SelectedItem="{Binding EditingAccountClone.Type}"
                                                                              Margin="5" />
                                                                    <CheckBox Content="Primary"
                                                                              IsChecked="{Binding EditingAccountClone.IsPrimary}"
                                                                              VerticalAlignment="Center"
                                                                              Margin="0,0,10,0"
                                                                              Visibility="{Binding EditingAccountClone.Type, ConverterParameter='Checking|Savings', Converter={StaticResource AccountTypeToVisibilityConverter}, FallbackValue=Collapsed}" />
                                                                </StackPanel>

                                                                <Label Content="Balance:"
                                                                       Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0"
                                                                       Grid.Row="2" />
                                                                <TextBox Grid.Column="1" Grid.Row="2"
                                                                         Text="{Binding EditingAccountClone.Balance, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                                                         Margin="5" />
                                                                <Label Content="As Of:"
                                                                       Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="2"
                                                                       Grid.Row="2" />
                                                                <DatePicker
                                                                    Grid.Column="3"
                                                                    Grid.Row="2"
                                                                    SelectedDate="{Binding EditingAccountClone.BalanceAsOf}"
                                                                    Margin="5" />

                                                                <Label Content="Growth %:"
                                                                       Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0"
                                                                       Grid.Row="3" />
                                                                <TextBox
                                                                    Grid.Column="1"
                                                                    Grid.Row="3"
                                                                    Text="{Binding EditingAccountClone.AnnualGrowthRate, UpdateSourceTrigger=PropertyChanged}"
                                                                    Margin="5" />
                                                                <Label Content="Color (Hex):"
                                                                       Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="2"
                                                                       Grid.Row="3" />
                                                                <TextBox Grid.Column="3" Grid.Row="3"
                                                                         Text="{Binding EditingAccountClone.HexColor, UpdateSourceTrigger=PropertyChanged}"
                                                                         Margin="5" />

                                                                <!-- Mortgage Details -->
                                                                <StackPanel Grid.Column="0" Grid.Row="4"
                                                                            Grid.ColumnSpan="4" Orientation="Vertical"
                                                                            Visibility="{Binding EditingAccountClone.Type, ConverterParameter=Mortgage, Converter={StaticResource AccountTypeToVisibilityConverter}}">
                                                                    <TextBlock
                                                                        Style="{DynamicResource    StyledTextBlock}"
                                                                        Text="Mortgage Details" FontSize="12"
                                                                        FontWeight="Bold" Margin="0,5,0,5" />
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Label
                                                                            Style="{DynamicResource    StyledLabel}"
                                                                            Grid.Row="0" Grid.Column="0"
                                                                            Content="Rate %:" />
                                                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                                                Text="{Binding EditingAccountClone.MortgageDetails.InterestRate, UpdateSourceTrigger=PropertyChanged}"
                                                                                Margin="5" />
                                                                        <Label
                                                                            Style="{DynamicResource    StyledLabel}"
                                                                            Grid.Row="0" Grid.Column="2"
                                                                            Content="Escrow:" />
                                                                        <TextBox Grid.Row="0" Grid.Column="3"
                                                                                Text="{Binding EditingAccountClone.MortgageDetails.Escrow, UpdateSourceTrigger=PropertyChanged}"
                                                                                Margin="5" />
                                                                        <Label Content="Insurance:"
                                                                               Style="{DynamicResource    StyledLabel}"
                                                                               Grid.Row="1"
                                                                               Grid.Column="0" />
                                                                        <TextBox
                                                                            Grid.Row="1"
                                                                            Grid.Column="1"
                                                                            Text="{Binding EditingAccountClone.MortgageDetails.MortgageInsurance, UpdateSourceTrigger=PropertyChanged}"
                                                                            Margin="5" />
                                                                        <Label Content="Payment:"
                                                                               Style="{DynamicResource    StyledLabel}"
                                                                               Grid.Row="2"
                                                                               Grid.Column="0" />
                                                                        <TextBox
                                                                            Grid.Row="2"
                                                                            Grid.Column="1"
                                                                            Text="{Binding EditingAccountClone.MortgageDetails.LoanPayment, UpdateSourceTrigger=PropertyChanged}"
                                                                            Margin="5" />
                                                                        <Label Content="Statement date:"
                                                                               Style="{DynamicResource    StyledLabel}"
                                                                               Grid.Row="2"
                                                                               Grid.Column="2" />
                                                                        <DatePicker
                                                                            Grid.Row="2"
                                                                            Grid.Column="3"
                                                                            SelectedDate="{Binding EditingAccountClone.MortgageDetails.PaymentDate, UpdateSourceTrigger=PropertyChanged}"
                                                                            MinWidth="90"
                                                                            Margin="5" />
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Credit Card Details -->
                                                                <StackPanel
                                                                    Grid.Column="0"
                                                                    Grid.Row="4"
                                                                    Grid.ColumnSpan="4"
                                                                    Orientation="Vertical"
                                                                    Visibility="{Binding EditingAccountClone.Type, ConverterParameter=CreditCard, Converter={StaticResource AccountTypeToVisibilityConverter}}">
                                                                    <TextBlock Text="Credit Card Details"
                                                                               Style="{DynamicResource    StyledTextBlock}"
                                                                               FontSize="12"
                                                                               FontWeight="Bold"
                                                                               Margin="0,5,0,5" />
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Label
                                                                            Style="{DynamicResource    StyledLabel}"
                                                                            Grid.Row="0" Grid.Column="0"
                                                                            Content="Statement Day:" />
                                                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                                                Text="{Binding EditingAccountClone.CreditCardDetails.StatementDay, UpdateSourceTrigger=PropertyChanged}"
                                                                                Margin="5" />
                                                                        <Label
                                                                            Style="{DynamicResource    StyledLabel}"
                                                                            Grid.Row="0" Grid.Column="2"
                                                                            Content="Due Date Offset:" />
                                                                        <TextBox Grid.Row="0" Grid.Column="3"
                                                                                Text="{Binding EditingAccountClone.CreditCardDetails.DueDateOffset, UpdateSourceTrigger=PropertyChanged}"
                                                                                Margin="5" />
                                                                        <Label
                                                                            Style="{DynamicResource    StyledLabel}"
                                                                            Grid.Row="1" Grid.Column="0"
                                                                            Content="Minimum payment:" />
                                                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                                                Text="{Binding EditingAccountClone.CreditCardDetails.MinPayFloor, UpdateSourceTrigger=PropertyChanged}"
                                                                                Margin="5" />
                                                                        <CheckBox Grid.Row="1" Grid.Column="2"
                                                                                Content="Grace Period"
                                                                                IsChecked="{Binding EditingAccountClone.CreditCardDetails.PayPreviousMonthBalanceInFull, UpdateSourceTrigger=PropertyChanged}"
                                                                                VerticalAlignment="Center"
                                                                                Margin="5"
                                                                                ToolTip="Interest is not charged if previous month's balance is paid in full" />
                                                                        <Button Grid.Row="2" Grid.Column="0"
                                                                                Content="Manage Interest Rates"
                                                                                Command="{Binding DataContext.SetAccountAprRatesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                Margin="0,0,0,0" Width="150"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </DockPanel>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

                                    <!-- Index 3: Paychecks View -->
                                    <DataTrigger Binding="{Binding SelectedOuterTabIndex}" Value="6">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Bottom">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                    HorizontalAlignment="Left">
                                                            <Button Content="Delete"
                                                                    Command="{Binding DeletePaycheckCommand}"
                                                                    Width="80" Margin="2">
                                                                <Button.Style>
                                                                    <Style TargetType="Button"
                                                                           BasedOn="{StaticResource DangerButtonStyle}">
                                                                        <Setter Property="Visibility"
                                                                                Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding EditingPaycheckClone.Id, Converter={StaticResource IntToVisibilityConverter}}"
                                                                                Value="Collapsed">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger
                                                                                Binding="{Binding IsEditingPaycheck}"
                                                                                Value="False">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                            <Button Content="Add"
                                                                    Style="{DynamicResource    SecondaryButtonStyle}"
                                                                    Command="{Binding AddPaycheckCommand}"
                                                                    Width="80"
                                                                    Margin="2"
                                                                    Visibility="{Binding IsNotEditingPaycheck, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <Button Content="Edit"
                                                                    Style="{DynamicResource    SecondaryButtonStyle}"
                                                                    Command="{Binding EditPaycheckCommand}"
                                                                    Width="80"
                                                                    Margin="2">
                                                                <Button.Visibility>
                                                                    <MultiBinding
                                                                        Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                                        <Binding Path="CanEditPaycheck" />
                                                                        <Binding Path="IsNotEditingPaycheck" />
                                                                    </MultiBinding>
                                                                </Button.Visibility>
                                                            </Button>
                                                            <Button Content="Save"
                                                                    Style="{DynamicResource    PrimaryButtonStyle}"
                                                                    Command="{Binding SavePaycheckCommand}"
                                                                    Width="80"
                                                                    Margin="2"
                                                                    Visibility="{Binding IsEditingPaycheck, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <Button Content="Cancel"
                                                                    Style="{DynamicResource    SecondaryButtonStyle}"
                                                                    Command="{Binding CancelPaycheckCommand}"
                                                                    Width="80" Margin="2"
                                                                    Visibility="{Binding IsEditingPaycheck, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <DataGrid ItemsSource="{Binding Paychecks}"
                                                                  SelectedItem="{Binding SelectedPaycheck}"
                                                                  IsReadOnly="True" AutoGenerateColumns="False"
                                                                  HorizontalScrollBarVisibility="Auto"
                                                                  CanUserAddRows="False">
                                                            <DataGrid.InputBindings>
                                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                                              Command="{Binding EditPaycheckCommand}" />
                                                            </DataGrid.InputBindings>
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Name"
                                                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                        Width="100" MinWidth="100" />
                                                                <DataGridTextColumn Header="Amount"
                                                                        Binding="{Binding ExpectedAmount, StringFormat=C, UpdateSourceTrigger=PropertyChanged}"
                                                                        Width="80" MinWidth="80" />
                                                                <DataGridTextColumn Header="Frequency"
                                                                        Binding="{Binding Frequency, UpdateSourceTrigger=PropertyChanged}"
                                                                        Width="80" MinWidth="80" />
                                                                <DataGridTextColumn Header="Start Date"
                                                                        HeaderStyle="{DynamicResource    CenterAlignedHeaderStyle}"
                                                                        Binding="{Binding StartDate, StringFormat='{}{0:MM/dd/yyyy}', UpdateSourceTrigger=PropertyChanged}"
                                                                        Width="90" MinWidth="65">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="TextAlignment"
                                                                                    Value="Center" />
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>
                                                                <DataGridTextColumn Header="End Date"
                                                                        HeaderStyle="{DynamicResource    CenterAlignedHeaderStyle}"
                                                                        Binding="{Binding EndDate, StringFormat='{}{0:MM/dd/yyyy}', UpdateSourceTrigger=PropertyChanged}"
                                                                        Width="90" MinWidth="65">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="TextAlignment"
                                                                                    Value="Center" />
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>
                                                                <DataGridTemplateColumn Header="Deposit To"
                                                                        Width="120">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <ComboBox
                                                                                ItemsSource="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                DisplayMemberPath="Name"
                                                                                SelectedValuePath="Id"
                                                                                SelectedValue="{Binding AccountId, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <StackPanel Grid.Row="1" Margin="5"
                                                                    Visibility="{Binding IsEditingPaycheck, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Style="{DynamicResource    StyledTextBlock}"
                                                                       Text="Paycheck Details" FontWeight="Bold"
                                                                       Margin="0,5" />
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0" Grid.Row="0" Content="Name:" />
                                                                <TextBox Grid.Column="1" Grid.Row="0"
                                                                         Text="{Binding EditingPaycheckClone.Name, UpdateSourceTrigger=PropertyChanged}"
                                                                         Margin="5" />
                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="2" Grid.Row="0"
                                                                       Content="Amount:" />
                                                                <controls:NumericTextBox Grid.Column="3"
                                                                        Grid.Row="0"
                                                                        Text="{Binding EditingPaycheckClone.ExpectedAmount, UpdateSourceTrigger=PropertyChanged}"
                                                                        Margin="5" />
                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0" Grid.Row="1"
                                                                       Content="Frequency:" />
                                                                <ComboBox Grid.Column="1" Grid.Row="1"
                                                                          Style="{DynamicResource    StyledEnumComboBox}"
                                                                          ItemsSource="{Binding Source={StaticResource EnumFrequency}}"
                                                                          SelectedItem="{Binding EditingPaycheckClone.Frequency}"
                                                                          Margin="5" />
                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0" Grid.Row="2"
                                                                       Content="Start date:" />
                                                                <DatePicker Grid.Column="1" Grid.Row="2"
                                                                            SelectedDate="{Binding EditingPaycheckClone.StartDate}"
                                                                            Margin="5" />
                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="2" Grid.Row="2"
                                                                       Content="End date:" />
                                                                <DatePicker Grid.Column="3" Grid.Row="2"
                                                                            SelectedDate="{Binding EditingPaycheckClone.EndDate}"
                                                                            Margin="5" />
                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0" Grid.Row="3"
                                                                       Content="Deposit To:" />
                                                                <ComboBox Grid.Column="1" Grid.Row="3"
                                                                          ItemsSource="{Binding Accounts}"
                                                                          SelectedValue="{Binding EditingPaycheckClone.AccountId}"
                                                                          SelectedValuePath="Id"
                                                                          DisplayMemberPath="Name" Margin="5" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </DockPanel>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

                                    <!-- Index 4: Bills View -->
                                    <DataTrigger Binding="{Binding SelectedOuterTabIndex}" Value="3">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Bottom">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                    HorizontalAlignment="Left">
                                                            <Button Content="Delete"
                                                                    Command="{Binding DeleteBillCommand}"
                                                                    Margin="5"
                                                                    Width="80">
                                                                <Button.Style>
                                                                    <Style TargetType="Button"
                                                                           BasedOn="{StaticResource DangerButtonStyle}">
                                                                        <Setter Property="Visibility"
                                                                                Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding EditingBillClone.Id, Converter={StaticResource IntToVisibilityConverter}}"
                                                                                Value="Collapsed">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger
                                                                                Binding="{Binding IsEditingBill}"
                                                                                Value="False">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                            <Button Content="Add"
                                                                    Style="{DynamicResource    SecondaryButtonStyle}"
                                                                    Command="{Binding AddBillCommand}" Margin="5"
                                                                    Width="80"
                                                                    Visibility="{Binding IsNotEditingBill, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <Button Content="Edit"
                                                                    Style="{DynamicResource    SecondaryButtonStyle}"
                                                                    Command="{Binding EditBillCommand}" Margin="5"
                                                                    Width="80">
                                                                <Button.Visibility>
                                                                    <MultiBinding
                                                                        Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                                        <Binding Path="CanEditBill" />
                                                                        <Binding Path="IsNotEditingBill" />
                                                                    </MultiBinding>
                                                                </Button.Visibility>
                                                            </Button>
                                                            <Button Content="Save"
                                                                    Style="{DynamicResource    PrimaryButtonStyle}"
                                                                    Command="{Binding SaveBillCommand}" Margin="5"
                                                                    Width="80"
                                                                    Visibility="{Binding IsEditingBill, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <Button Content="Cancel"
                                                                    Style="{DynamicResource    SecondaryButtonStyle}"
                                                                    Command="{Binding CancelBillCommand}"
                                                                    Margin="5"
                                                                    Width="80"
                                                                    Visibility="{Binding IsEditingBill, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <DataGrid Grid.Row="0" ItemsSource="{Binding Bills}"
                                                                  SelectedItem="{Binding SelectedBill}"
                                                                  AutoGenerateColumns="False"
                                                                  CanUserAddRows="False"
                                                                  IsReadOnly="True">
                                                            <DataGrid.InputBindings>
                                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                                              Command="{Binding EditBillCommand}" />
                                                            </DataGrid.InputBindings>
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Name"
                                                                        Binding="{Binding Name}" Width="*" />
                                                                <DataGridTextColumn Header="Budgeted"
                                                                        Binding="{Binding ExpectedAmount, StringFormat=C}"
                                                                        Width="80" />
                                                                <DataGridTextColumn Header="Due Day"
                                                                        Binding="{Binding DueDay}" Width="60" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <StackPanel Grid.Row="1" Margin="10"
                                                                    Visibility="{Binding IsEditingBill, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Style="{DynamicResource    StyledTextBlock}"
                                                                       Text="Edit Bill" FontWeight="Bold"
                                                                       Margin="0,0,0,5" />
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0" Grid.Row="0" Content="Name:" />
                                                                <TextBox Grid.Column="1" Grid.Row="0"
                                                                         Text="{Binding EditingBillClone.Name, UpdateSourceTrigger=PropertyChanged}"
                                                                         Margin="5" />
                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="2" Grid.Row="0"
                                                                       Content="Frequency:" />
                                                                <ComboBox Grid.Column="3" Grid.Row="0"
                                                                          Style="{DynamicResource    StyledEnumComboBox}"
                                                                          ItemsSource="{Binding BillFrequencies}"
                                                                          SelectedItem="{Binding EditingBillClone.Frequency}"
                                                                          Margin="5" />
                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0" Grid.Row="1"
                                                                       Content="Budgeted:" />
                                                                <controls:NumericTextBox Grid.Column="1"
                                                                        Grid.Row="1"
                                                                        Text="{Binding EditingBillClone.ExpectedAmount, UpdateSourceTrigger=PropertyChanged}"
                                                                        Margin="5" />

                                                                <Label Grid.Column="2" Grid.Row="1"
                                                                       Content="Due Day:">
                                                                    <Label.Style>
                                                                        <Style TargetType="Label"
                                                                               BasedOn="{StaticResource StyledLabel}">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger
                                                                                    Binding="{Binding EditingBillClone.Frequency}"
                                                                                    Value="Monthly">
                                                                                    <Setter Property="Visibility"
                                                                                        Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Label.Style>
                                                                </Label>
                                                                <TextBox Grid.Column="3" Grid.Row="1"
                                                                         Text="{Binding EditingBillClone.DueDay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Margin="5">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger
                                                                                    Binding="{Binding EditingBillClone.Frequency}"
                                                                                    Value="Monthly">
                                                                                    <Setter Property="Visibility"
                                                                                        Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>

                                                                <Label Grid.Column="2" Grid.Row="1"
                                                                       Content="Next Due Date:">
                                                                    <Label.Style>
                                                                        <Style TargetType="Label"
                                                                               BasedOn="{StaticResource StyledLabel}">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger
                                                                                    Binding="{Binding EditingBillClone.Frequency}"
                                                                                    Value="Yearly">
                                                                                    <Setter Property="Visibility"
                                                                                        Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Label.Style>
                                                                </Label>
                                                                <DatePicker Grid.Column="3" Grid.Row="1"
                                                                            SelectedDate="{Binding EditingBillClone.NextDueDate}"
                                                                            Margin="5">
                                                                    <DatePicker.Style>
                                                                        <Style TargetType="DatePicker">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger
                                                                                    Binding="{Binding EditingBillClone.Frequency}"
                                                                                    Value="Yearly">
                                                                                    <Setter Property="Visibility"
                                                                                        Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </DatePicker.Style>
                                                                </DatePicker>

                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0" Grid.Row="2"
                                                                       Content="Paid From:" />
                                                                <ComboBox Grid.Column="1" Grid.Row="2"
                                                                          ItemsSource="{Binding ActiveAccountsWithNone}"
                                                                          x:Name="BillAccountComboBox"
                                                                          SelectedValue="{Binding EditingBillClone.AccountId}"
                                                                          SelectedValuePath="Id"
                                                                          DisplayMemberPath="Name" Margin="5" />
                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="2" Grid.Row="2"
                                                                       Content="Paid To:" />
                                                                <ComboBox Grid.Column="3" Grid.Row="2"
                                                                          ItemsSource="{Binding ActiveAccountsWithNone}"
                                                                          x:Name="BillToAccountComboBox"
                                                                          SelectedValue="{Binding EditingBillClone.ToAccountId}"
                                                                          SelectedValuePath="Id"
                                                                          DisplayMemberPath="Name" Margin="5" />

                                                                <StackPanel Grid.Column="0" Grid.Row="3"
                                                                            Grid.ColumnSpan="4"
                                                                            Orientation="Horizontal" Margin="5">
                                                                    <CheckBox
                                                                        Content="Principal Only (Mortgage/Loan Extra)"
                                                                        IsChecked="{Binding EditingBillClone.IsPrincipalOnly}"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,10,0"
                                                                        Visibility="{Binding SelectedItem, ElementName=BillToAccountComboBox, ConverterParameter='Mortgage|PersonalLoan|HELOC|StudentLoan', Converter={StaticResource AccountTypeToVisibilityConverter}, FallbackValue=Collapsed}" />
                                                                </StackPanel>

                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0" Grid.Row="4"
                                                                       Content="Sub Category:" />
                                                                <ComboBox Grid.Column="1" Grid.Row="4"
                                                                          x:Name="BillSubCategoryComboBox"
                                                                          ItemsSource="{Binding SubCategoriesWithNone}"
                                                                          SelectedValue="{Binding EditingBillClone.SubCategoryId}"
                                                                          SelectedValuePath="Id"
                                                                          DisplayMemberPath="Name" Margin="5" />
                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="2" Grid.Row="4"
                                                                       Content="Envelope:" />
                                                                <ComboBox Grid.Column="3" Grid.Row="4"
                                                                          x:Name="BillBucketComboBox"
                                                                          ItemsSource="{Binding BucketsWithNone}"
                                                                          SelectedValue="{Binding EditingBillClone.BucketId}"
                                                                          SelectedValuePath="Id"
                                                                          DisplayMemberPath="Name" Margin="5" />

                                                                <!-- Monthly / Seasonal Overrides Section -->
                                                                <StackPanel Grid.Row="5" Grid.Column="0"
                                                                            Grid.ColumnSpan="4" Margin="5"
                                                                            Visibility="{Binding EditingBillClone.Frequency, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Monthly}">

