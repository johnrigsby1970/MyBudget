                                                                                        <Setter
                                                                                            Property="TextAlignment"
                                                                                            Value="Center" />
                                                                                    </Style>
                                                                                </DataGridTextColumn.ElementStyle>
                                                                            </DataGridTextColumn>
                                                                            <DataGridTextColumn
                                                                                Header="Expected Amount"
