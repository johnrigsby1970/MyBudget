                                                                    Margin="2"
                                                                    Visibility="{Binding IsNotEditingAccount, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <Button Content="Edit"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding EditAccountCommand}" Width="80"
                                                                    Margin="2">
                                                                <Button.Visibility>
                                                                    <MultiBinding
                                                                        Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                                        <Binding Path="CanEditAccount" />
                                                                        <Binding Path="IsNotEditingAccount" />
                                                                    </MultiBinding>
                                                                </Button.Visibility>
