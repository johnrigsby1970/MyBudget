                                                                               Visibility="{Binding IsBillDescriptionExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        Amounts set here apply only for this period and are used for projections prior to the actual bill being entered as a transaction.
                                                                        <Hyperlink
                                                                            Command="{Binding ToggleBillDescriptionCommand}">
                                                                            Read less
                                                                        </Hyperlink>
                                                                    </TextBlock>
                                                                    <DataGrid Grid.Row="1"
                                                                              ItemsSource="{Binding CurrentPeriodBills}"
