                                                    <Style TargetType="{x:Type DataGridRow}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasActualAmount}"
                                                                         Value="True">
                                                                <Setter Property="Background" Value="#CCFFCC" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding BudgetExceeded}"
                                                                         Value="True">
                                                                <Setter Property="Background" Value="#FFCCCC" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                                  Command="{Binding EditPeriodBucketCommand}" />
                                                </DataGrid.InputBindings>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Envelope"
                                                                        Binding="{Binding BucketName}"
                                                                        IsReadOnly="True" Width="*" />
                                                    <DataGridTextColumn Header="Expected Amount"
                                                                        Binding="{Binding ActualAmount, StringFormat=C}"
                                                                        Width="100">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextAlignment" Value="Right" />
                                                                <Setter Property="Padding" Value="0,0,8,0" />
                                                                <!-- <Setter Property="Foreground"  -->
                                                                <!--         Value="{Binding ActualAmount, Converter={StaticResource AmountToBrushConverter}}" /> -->

                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Actual Amount"
                                                                        Binding="{Binding TransactionAmount, Converter={StaticResource AbsoluteValueConverter}, StringFormat=C}"
                                                                        IsReadOnly="True" Width="100">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextAlignment" Value="Right" />
                                                                <Setter Property="Padding" Value="0,0,8,0" />
                                                                <!-- <Setter Property="Foreground"  -->
                                                                <!--         Value="{Binding TransactionAmount, Converter={StaticResource AmountToBrushConverter}}" /> -->

                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <StackPanel Grid.Row="2" Margin="10"
                                                        Visibility="{Binding IsEditingPeriodBucket, Converter={StaticResource BooleanToVisibilityConverter}}">
