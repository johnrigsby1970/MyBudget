                                                                                                    <Style
                                                                                                        TargetType="Border">
                                                                                                        <Setter
                                                                                                            Property="Background"
                                                                                                            Value="#E8EAED" />
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger
                                                                                                                Binding="{Binding IsFunded}"
                                                                                                                Value="True">
                                                                                                                <Setter
                                                                                                                    Property="Background"
                                                                                                                    Value="#CEEAD6" />
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger
                                                                                                                Binding="{Binding IsSkipped}"
                                                                                                                Value="True">
                                                                                                                <Setter
                                                                                                                    Property="Background"
                                                                                                                    Value="#F1F3F4" />
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Border.Style>
                                                                                                <TextBlock
                                                                                                    Text="{Binding FundingStatus}"
                                                                                                    FontSize="10"
                                                                                                    FontWeight="Bold"
                                                                                                    Foreground="#3C4043" />
                                                                                            </Border>
                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </DataGridTemplateColumn.CellTemplate>
                                                                            </DataGridTemplateColumn>

                                                                            <DataGridTextColumn
                                                                                Header="Target / Set Aside"
                                                                                Binding="{Binding ActualAmount, StringFormat=C}"
                                                                                Width="140">
                                                                                <DataGridTextColumn.ElementStyle>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter
                                                                                            Property="TextAlignment"
                                                                                            Value="Right" />
                                                                                        <Setter Property="Padding"
                                                                                            Value="0,0,8,0" />
                                                                                    </Style>
                                                                                </DataGridTextColumn.ElementStyle>
                                                                            </DataGridTextColumn>

                                                                            <DataGridTextColumn Header="Spent"
                                                                                    Binding="{Binding TransactionAmount, Converter={StaticResource AbsoluteValueConverter}, StringFormat=C}"
                                                                                    IsReadOnly="True" Width="120">
                                                                                <DataGridTextColumn.ElementStyle>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter
                                                                                            Property="TextAlignment"
                                                                                            Value="Right" />
                                                                                        <Setter Property="Padding"
                                                                                            Value="0,0,8,0" />
                                                                                    </Style>
                                                                                </DataGridTextColumn.ElementStyle>
                                                                            </DataGridTextColumn>
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>

                                                                    <StackPanel Grid.Row="2" Margin="10"
                                                                            Visibility="{Binding IsEditingPeriodBucket, Converter={StaticResource BooleanToVisibilityConverter}}">
