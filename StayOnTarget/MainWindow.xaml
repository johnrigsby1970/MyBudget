                                                                    <MultiBinding
                                                                        Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                                        <Binding Path="CanEditBucket" />
                                                                        <Binding Path="IsNotEditingBucket" />
                                                                    </MultiBinding>
                                                                </Button.Visibility>
                                                            </Button>
                                                            <Button Content="Save"
                                                                    Style="{DynamicResource    PrimaryButtonStyle}"
                                                                    Command="{Binding SaveBucketCommand}"
                                                                    Margin="5"
                                                                    Width="80"
                                                                    Visibility="{Binding IsEditingBucket, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <Button Content="Cancel"
                                                                    Style="{DynamicResource    SecondaryButtonStyle}"
                                                                    Command="{Binding CancelBucketCommand}"
                                                                    Margin="5"
                                                                    Width="80"
                                                                    Visibility="{Binding IsEditingBucket, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
