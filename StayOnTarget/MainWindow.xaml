                                                                    <StackPanel Grid.Column="2"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Right" Margin="5">
                                                                        <Button Content="Edit"
                                                                                Command="{Binding EditPeriodBucketCommand}"
                                                                                Width="80" Margin="2">
