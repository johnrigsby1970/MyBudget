                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0">
                                                <TextBlock Margin="5" TextWrapping="Wrap"
                                                           Visibility="{Binding IsBucketDescriptionExpanded, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    Amounts set here apply only for this period.
                                                    <Hyperlink Command="{Binding ToggleBucketDescriptionCommand}">Read more...</Hyperlink>
                                                </TextBlock>
                                                <TextBlock Margin="5" TextWrapping="Wrap"
                                                           Visibility="{Binding IsBucketDescriptionExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    Amounts set here apply only for this period. The available projected amount will adjust as transactions are entered that apply to this envelope. Once enough transactions are marked with this envelope are subtracted from the total available for the period, the projection for the remainder of the period will be zero. You can add to the envelope total for the period to give more room in this envelope. To set the projection for all future periods, set it in the Envelopes tab.
                                                    <Hyperlink Command="{Binding ToggleBucketDescriptionCommand}">Read less</Hyperlink>
                                                </TextBlock>
                                            </StackPanel>

                                            <DataGrid Grid.Row="1" ItemsSource="{Binding CurrentPeriodBuckets}"
                                                      SelectedItem="{Binding SelectedPeriodBucket}"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False">
