                                                                                                Visibility="{Binding TransactionAmount, Converter={StaticResource MarkBillAsPaidVisibilityConverter}}"
                                                                                                Margin="6,0,0,0"
                                                                                                VerticalAlignment="Center">
                                                                                                <Hyperlink
                                                                                                    Command="{Binding DataContext.PayPeriodBillCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                                    CommandParameter="{Binding}">
                                                                                                    Enter Payment
                                                                                                </Hyperlink>
                                                                                            </TextBlock>
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </DataGridTemplateColumn.CellTemplate>
                                                                            </DataGridTemplateColumn>
                                                                            <DataGridTextColumn Header="Due Date"
