                                                                            CanUserAddRows="False"
                                                                            CanUserDeleteRows="False"
                                                                            MaxHeight="160"
                                                                            Margin="0,0,0,5">
                                                                            <DataGrid.Columns>
                                                                                <!-- Month Selector -->
                                                                                <DataGridTemplateColumn Header="Month"
                                                                                    Width="140">
                                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                                        <DataTemplate>
                                                                                            <ComboBox
                                                                                                ItemsSource="{Binding DataContext.MonthOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                SelectedValuePath="Key"
                                                                                                DisplayMemberPath="Name"
                                                                                                SelectedValue="{Binding MonthKey, UpdateSourceTrigger=PropertyChanged}"
                                                                                                Margin="2" />
                                                                                        </DataTemplate>
                                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                                </DataGridTemplateColumn>

                                                                                <!-- Override Amount -->
                                                                                <DataGridTemplateColumn
                                                                                    Header="Override Amount"
                                                                                    Width="140">
                                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                                        <DataTemplate>
                                                                                            <controls:NumericTextBox
                                                                                                Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                                                                                Margin="2" />
                                                                                        </DataTemplate>
                                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                                </DataGridTemplateColumn>

                                                                                <!-- Delete Row Button -->
                                                                                <DataGridTemplateColumn Width="60">
                                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                                        <DataTemplate>
                                                                                            <Button Content="✕"
                                                                                                Command="{Binding DataContext.RemoveBucketOverrideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                CommandParameter="{Binding}"
                                                                                                Style="{DynamicResource DangerButtonStyle}"
                                                                                                Padding="4,1"
                                                                                                Margin="2"
                                                                                                ToolTip="Remove this override" />
                                                                                        </DataTemplate>
                                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                                </DataGridTemplateColumn>
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </DockPanel>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

                                    <!-- Index 6: Categories View -->
                                    <DataTrigger Binding="{Binding SelectedOuterTabIndex}" Value="5">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="5" />
                                                        <ColumnDefinition Width="1.5*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Left Categories -->
                                                    <DockPanel Grid.Column="0" Margin="5">
                                                        <Grid DockPanel.Dock="Bottom">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Content="Delete"
                                                                    Command="{Binding DeleteCategoryCommand}"
                                                                    Margin="2,5"
                                                                    Width="70">
                                                                <Button.Style>
                                                                    <Style TargetType="Button"
                                                                           BasedOn="{StaticResource DangerButtonStyle}">
                                                                        <Setter Property="Visibility"
                                                                                Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding EditingCategoryClone.Id, Converter={StaticResource IntToVisibilityConverter}}"
                                                                                Value="Collapsed">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger
                                                                                Binding="{Binding IsEditingCategory}"
                                                                                Value="False">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                        HorizontalAlignment="Right">
                                                                <Button Content="Add"
                                                                        Style="{DynamicResource    SecondaryButtonStyle}"
                                                                        Command="{Binding AddCategoryCommand}"
                                                                        Margin="2,5" Width="60"
                                                                        Visibility="{Binding IsNotEditingCategory, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <Button Content="Edit"
                                                                        Style="{DynamicResource    SecondaryButtonStyle}"
                                                                        Command="{Binding EditCategoryCommand}"
                                                                        Margin="2,5" Width="60">
                                                                    <Button.Visibility>
                                                                        <MultiBinding
                                                                            Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                                            <Binding Path="CanEditCategory" />
                                                                            <Binding Path="IsNotEditingCategory" />
                                                                        </MultiBinding>
                                                                    </Button.Visibility>
                                                                </Button>
                                                                <Button Content="Save"
                                                                        Style="{DynamicResource    PrimaryButtonStyle}"
                                                                        Command="{Binding SaveCategoryCommand}"
                                                                        Margin="2,5" Width="60"
                                                                        Visibility="{Binding IsEditingCategory, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <Button Content="Cancel"
                                                                        Style="{DynamicResource    SecondaryButtonStyle}"
                                                                        Command="{Binding CancelCategoryCommand}"
                                                                        Margin="2,5" Width="60"
                                                                        Visibility="{Binding IsEditingCategory, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <DataGrid ItemsSource="{Binding Categories}"
                                                                  SelectedItem="{Binding SelectedCategory}"
                                                                  AutoGenerateColumns="False"
                                                                  CanUserAddRows="False"
                                                                  IsReadOnly="True">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Category"
                                                                        Binding="{Binding Name}" Width="*" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </DockPanel>

                                                    <GridSplitter Grid.Column="1" Width="5"
                                                                  HorizontalAlignment="Stretch"
                                                                  Style="{DynamicResource    ModernGridSplitterStyle}" />

                                                    <!-- Right Subcategories -->
                                                    <DockPanel Grid.Column="2" Margin="5">
                                                        <DataGrid ItemsSource="{Binding SubCategories}"
                                                                  SelectedItem="{Binding SelectedSubCategory}"
                                                                  AutoGenerateColumns="False"
                                                                  CanUserAddRows="False"
                                                                  IsReadOnly="True">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Category"
                                                                        Binding="{Binding CategoryName}"
                                                                        Width="120" />
                                                                <DataGridTextColumn Header="Subcategory"
                                                                        Binding="{Binding Name}" Width="*" />
                                                                <!-- <DataGridTextColumn Header="Default Envelope" Binding="{Binding DefaultBucketName}" Width="140" /> -->
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </DockPanel>
                                                </Grid>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <!-- Flexible Alerts & Action Tasks Panel -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderColorBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="10,10,10,10"
                            Padding="12"
                            VerticalAlignment="Bottom"
                            Visibility="{Binding ShowWarningWidget, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <!-- COMPACT HEADER & SUMMARY BADGES -->
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Style="{DynamicResource StyledTextBlock}"
                                           Text="Alerts &amp; Action Items"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           DockPanel.Dock="Left" />

                                <!-- Summary Badges Right-Aligned -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            DockPanel.Dock="Right">

                                    <!-- Past Due Bills Pill (Only visible if PastDueCount > 0) -->
                                    <Border Background="#22EF4444"
                                            CornerRadius="10"
                                            Padding="6,2"
                                            Margin="0,0,6,0"
                                            ToolTip="Past Due Bills"
                                            Visibility="{Binding PastDueCount, Converter={StaticResource IntToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Exclamation / Warning Icon -->
                                            <Path
                                                Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                                Fill="{DynamicResource ErrorBrush}"
                                                Width="12" Height="12"
                                                Stretch="Uniform"
                                                Margin="0,0,4,0" />
                                            <TextBlock
                                                Text="{Binding PastDueCount, StringFormat='{}Past Due ({0})'}"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource ErrorBrush}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Upcoming Bills Pill (Only visible if UpcomingCount > 0) -->
                                    <Border Background="#22F59E0B"
                                            CornerRadius="10"
                                            Padding="6,2"
                                            ToolTip="Upcoming Bills (Next 7 Days)"
                                            Visibility="{Binding UpcomingCount, Converter={StaticResource IntToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Calendar / Clock Icon -->
                                            <Path
                                                Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                                                Fill="{DynamicResource WarningBrush}"
                                                Width="12" Height="12"
                                                Stretch="Uniform"
                                                Margin="0,0,4,0" />
                                            <TextBlock
                                                Text="{Binding UpcomingCount, StringFormat='{}Upcoming ({0})'}"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource WarningBrush}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </DockPanel>
                            <!-- ~1~ HEADER & COUNTERS @1@ -->
                            <!-- <TextBlock Style="{DynamicResource    StyledTextBlock}" Text="Alerts &amp; Action Items" -->
                            <!--            FontWeight="SemiBold" -->
                            <!--            FontSize="14" -->
                            <!--            Margin="0,0,0,10" /> -->
                            <!-- -->
                            <!-- <UniformGrid Columns="2" Margin="0,0,0,10"> -->
                            <!--     ~1~ Past Due @1@ -->
                            <!--     <StackPanel Orientation="Horizontal" Margin="0,0,8,0"> -->
                            <!--         <Viewbox Width="18" Height="18" Margin="0,0,8,0"> -->
                            <!--             <Path Data="M3 2v18h2V12h11l1-2-1-2H5V2H3zm4 4h7.5l.5 1-.5 1H7V6z" -->
                            <!--                   Fill="{DynamicResource ErrorBrush}" /> -->
                            <!--         </Viewbox> -->
                            <!--         <StackPanel> -->
                            <!--             <TextBlock Style="{DynamicResource    StyledSecondaryTextBlock}" -->
                            <!--                        Text="Past Due" -->
                            <!--                        FontSize="11" -->
                            <!--                        FontWeight="Medium" /> -->
                            <!--             <TextBlock Style="{DynamicResource    StyledTextBlock}" -->
                            <!--                        Text="{Binding PastDueCount}" FontSize="16" FontWeight="Bold" /> -->
                            <!--         </StackPanel> -->
                            <!--     </StackPanel> -->
                            <!-- -->
                            <!--     ~1~ Upcoming @1@ -->
                            <!--     <StackPanel Orientation="Horizontal"> -->
                            <!--         <Viewbox Width="18" Height="18" Margin="0,0,8,0"> -->
                            <!--             <Path Data="M3 2v18h2V12h11l1-2-1-2H5V2H3zm4 4h7.5l.5 1-.5 1H7V6z" -->
                            <!--                   Fill="{DynamicResource WarningBrush}" /> -->
                            <!--         </Viewbox> -->
                            <!--         <StackPanel> -->
                            <!--             <TextBlock Text="Upcoming" FontSize="11" -->
                            <!--                        Style="{DynamicResource    StyledSecondaryTextBlock}" -->
                            <!--                        FontWeight="Medium" /> -->
                            <!--             <TextBlock Style="{DynamicResource    StyledTextBlock}" -->
                            <!--                        Text="{Binding UpcomingCount}" FontSize="16" FontWeight="Bold" /> -->
                            <!--         </StackPanel> -->
                            <!--     </StackPanel> -->
                            <!-- </UniformGrid> -->

                            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">

                                <!-- SECTION 1: BUSTED BUCKETS & OVERSPEND (Collapses if empty) -->
                                <ItemsControl ItemsSource="{Binding BudgetBustedBuckets}" Margin="0,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Background="{DynamicResource WindowBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderColorBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="0,0,0,6"
                                                Padding="8,6">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                                  Command="{Binding DataContext.MapsToBucketCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                </Border.InputBindings>
                                                <DockPanel>
                                                    <TextBlock
                                                        Text="{Binding TransactionAmount, Converter={StaticResource AbsoluteValueConverter}, StringFormat=C}"
                                                        DockPanel.Dock="Right"
                                                        FontWeight="SemiBold"
                                                        FontSize="11"
                                                        VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource SuccessBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding BudgetExceeded}"
                                                                            Value="true">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource ErrorBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Style="{DynamicResource    StyledTextBlock}"
                                                               Text="{Binding BucketName}"
                                                               FontWeight="Medium"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </ScrollViewer>
                            <!-- SECTION 2: UPCOMING 30-DAY STRATEGY SWEEPS & SNOWBALL TASKS -->
                            <Border
                                Margin="0,4,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <!-- Default state: Collapsed -->
                                        <Setter Property="Visibility" Value="Collapsed" />

                                        <Style.Triggers>
                                            <!-- Show ONLY when EnableSnowball is True AND Count produces 'Visible' -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SnowballOptions.EnableSnowball}"
                                                               Value="True" />
                                                    <Condition
                                                        Binding="{Binding UpcomingStrategyTasks.Count, Converter={StaticResource IntToVisibilityConverter}}"
                                                        Value="Visible" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Separator Background="{DynamicResource BorderColorBrush}" Margin="0,4,0,8"
                                               Opacity="0.5" />

                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="30-Day Snowball Tasks"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource    SpecialHeadingBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Style="{DynamicResource    StyledSecondaryTextBlock}"
                                                   Text="Next 31 Days"
                                                   FontSize="10"
                                                   DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>

                                    <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding UpcomingStrategyTasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Background="{DynamicResource    StrategyTaskBackgroundBrush}"
                                                        BorderBrush="{DynamicResource    StrategyTaskBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6" Margin="0,0,0,6" Padding="8,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontWeight="SemiBold" FontSize="11"
                                                                           Foreground="{DynamicResource    StrategyTaskTitleBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Foreground="{DynamicResource    StrategyTaskTextBrush}"
                                                                    Text="{Binding DueDate, StringFormat='Target: {0:MM/dd/yyyy}'}"
                                                                    FontSize="10" />
                                                            </StackPanel>

                                                            <TextBlock Text="{Binding Amount, StringFormat=C}"
                                                                       Grid.Column="1"
                                                                       FontWeight="Bold"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource    StrategyTaskBrush}"
                                                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>

                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch"
                          Style="{DynamicResource    ModernGridSplitterStyle}" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ShowsPreview="True" />

            <!-- Right Panel: Projections -->
            <DockPanel Grid.Column="2" Margin="10,0,0,0">
                <Label Style="{DynamicResource    StyledLabel}" DockPanel.Dock="Top"
                       Content="{Binding YearsProjecting, Converter={StaticResource ProjectionYearsLabelConverter}}"
                       Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="4"
                            Padding="6,4" Margin="0,4,0,8" Grid.Row="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Label Style="{DynamicResource    StyledLabel}" Content="Start:"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" Margin="5,0,0,0" />
                                <DatePicker
                                    SelectedDate="{Binding ProjectionStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                    VerticalAlignment="Center" Margin="5,0,0,0" />
                                <Label Style="{DynamicResource    StyledLabel}" Content="End:"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                                <DatePicker DisplayDateStart="{x:Static System:DateTime.Today}"
                                            SelectedDate="{Binding ProjectionEndDate}" VerticalAlignment="Center"
                                            Margin="5,0,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Command="{Binding SetOneYearCommand}" Content="1 yr" Padding="10,4"
                                        Style="{DynamicResource    SecondaryButtonStyle}" />
                                <Button Command="{Binding SetFiveYearCommand}" Content="5 yr" Padding="10,4"
                                        Style="{DynamicResource    SecondaryButtonStyle}" Margin="-1,0,0,0" />
                                <Button Command="{Binding SetTenYearCommand}" Content="10 yr" Padding="10,4"
                                        Style="{DynamicResource    SecondaryButtonStyle}" Margin="-1,0,0,0" />
                                <Button Command="{Binding SetThirtyYearCommand}" Content="30 yr" Padding="10,4"
                                        Style="{DynamicResource    SecondaryButtonStyle}" Margin="-1,0,0,0" />
                            </StackPanel>

                            <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                      Content="Pay off new credit card spending each period"
                                      Foreground="{DynamicResource SecondaryTextBrush}"
                                      IsChecked="{Binding UseAutoSweep}" VerticalAlignment="Center"
                                      Margin="5,6,5,2" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <TabControl
                            Style="{DynamicResource    InnerTabControlStyle}"
                            ItemContainerStyle="{DynamicResource    ModernUnderlineTabItemStyle}"
                            SelectedIndex="{Binding SelectedProjectionTabIndex}">
                            <TabItem Header="Current Plan">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="2*" />
                                    </Grid.RowDefinitions>

                                    <DataGrid x:Name="ProjectionGrid" Grid.Row="0"
                                              ItemsSource="{Binding Projections}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              EnableRowVirtualization="True"
                                              ScrollViewer.CanContentScroll="True"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="{x:Type DataGridRow}">
                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                <Setter Property="BorderBrush" Value="LightGray" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                        <Setter Property="BorderThickness" Value="0,2,0,0" />
                                                        <Setter Property="BorderBrush"
                                                                Value="{DynamicResource GridPeriodBorderBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Posting Date"
                                                                HeaderStyle="{DynamicResource    CenterAlignedHeaderStyle}"
                                                                Binding="{Binding TransactionDate, StringFormat='{}{0:MM/dd/yyyy}'}"
                                                                IsReadOnly="False" Width="90">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTemplateColumn Header="Description" Width="200">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Style="{DynamicResource    StyledTextBlock}"
                                                                       Grid.Column="0" Text="{Binding Description}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />

                                                            <TextBlock Style="{DynamicResource    StyledTextBlock}"
                                                                       Grid.Column="1"
                                                                       Visibility="{Binding CanPayIt, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                       Margin="6,0,0,0" VerticalAlignment="Center">
                                                                <Hyperlink
                                                                    Command="{Binding DataContext.PayBillCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}">
                                                                    Enter Payment
                                                                </Hyperlink>
                                                            </TextBlock>

                                                            <TextBlock Style="{DynamicResource    StyledTextBlock}"
                                                                       Grid.Column="1"
                                                                       Visibility="{Binding CanFundDrawdown, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                       Margin="6,0,0,0" VerticalAlignment="Center">
                                                                <Hyperlink
                                                                    Command="{Binding DataContext.FundEnvelopeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}">
                                                                    Funds Set Aside
                                                                </Hyperlink>
                                                                or
                                                                <Hyperlink
                                                                    Command="{Binding DataContext.SkipFundEnvelopeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}">
                                                                    Skip
                                                                </Hyperlink>
                                                            </TextBlock>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Header="Amount"
                                                                HeaderStyle="{DynamicResource    RightAlignedHeaderStyle}"
                                                                Binding="{Binding Amount, StringFormat=C, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="90" MinWidth="80">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextAlignment" Value="Right" />
                                                        <Setter Property="Padding" Value="0,0,8,0" />
                                                        <Setter Property="Foreground"
                                                                Value="{Binding Amount, Converter={StaticResource AmountToBrushConverter}}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBucket}" Value="True">
                                                                <Setter Property="Foreground" Value="#6C5CE7" />
                                                                <Setter Property="FontStyle" Value="Italic" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSweep}" Value="True">
                                                                <Setter Property="Foreground" Value="Goldenrod" />
                                                                <Setter Property="FontStyle" Value="Italic" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Total Balance"
                                                                HeaderStyle="{DynamicResource    RightAlignedHeaderStyle}"
                                                                Binding="{Binding Balance, StringFormat=C}"
                                                                Width="90">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextAlignment" Value="Right" />
                                                        <Setter Property="Padding" Value="0,0,8,0" />
                                                        <Setter Property="Foreground"
                                                                Value="{Binding Balance, Converter={StaticResource AmountToBrushConverter}}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource BadNumericHighlightBrush}" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Period Net"
                                                                HeaderStyle="{DynamicResource    RightAlignedHeaderStyle}"
                                                                Binding="{Binding PeriodNet, StringFormat=C}"
                                                                Width="90">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextAlignment" Value="Right" />
                                                        <Setter Property="Padding" Value="0,0,8,0" />
                                                        <Setter Property="Foreground"
                                                                Value="{Binding Amount, Converter={StaticResource AmountToBrushConverter}}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding PeriodNet, Converter={StaticResource NegativeToRedConverter}}"
                                                                Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource BadNumericHighlightBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <GridSplitter Grid.Row="1" ResizeDirection="Rows" Height="2"
                                                  HorizontalAlignment="Stretch"
                                                  Style="{DynamicResource    ModernGridSplitterStyle}"
                                                  VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                                                  ShowsPreview="True" />

                                    <Grid Grid.Row="2" Margin="0,5,0,0">
                                        <local:ProjectionLiveChartControl
                                            Visibility="{Binding IsProjecting, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                            Projections="{Binding Projections}"
                                            Accounts="{Binding VisibleAccounts}" />
                                        <StackPanel
                                            Visibility="{Binding IsProjecting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Orientation="Vertical">
                                            <Viewbox Width="50" Height="50">
                                                <Control>
                                                    <Control.Template>
                                                        <ControlTemplate TargetType="Control">
                                                            <Grid RenderTransformOrigin="0.5,0.5">
                                                                <Grid.RenderTransform>
                                                                    <RotateTransform x:Name="SpinTransform"
                                                                            Angle="0" />
                                                                </Grid.RenderTransform>
                                                                <Canvas Width="48" Height="48">
                                                                    <Path Data="M24,4 A20,20 0 1,1 23.99,4"
                                                                          Stroke="#E2E8F0" StrokeThickness="4"
                                                                          StrokeStartLineCap="Round"
                                                                          StrokeEndLineCap="Round" />
                                                                    <Path Data="M24,4 A20,20 0 0,1 44,24"
                                                                          Stroke="#3B82F6"
                                                                          StrokeThickness="4"
                                                                          StrokeStartLineCap="Round"
                                                                          StrokeEndLineCap="Round" />
                                                                </Canvas>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsVisible" Value="True">
                                                                    <Trigger.EnterActions>
                                                                        <BeginStoryboard x:Name="SpinStory">
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation
                                                                                    Storyboard.TargetName="SpinTransform"
                                                                                    Storyboard.TargetProperty="Angle"
                                                                                    From="0" To="360"
                                                                                    Duration="0:0:1" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.EnterActions>
                                                                    <Trigger.ExitActions>
                                                                        <StopStoryboard
                                                                            BeginStoryboardName="SpinStory" />
                                                                    </Trigger.ExitActions>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Control.Template>
                                                </Control>
                                            </Viewbox>
                                            <TextBlock Style="{DynamicResource    StyledTextBlock}"
                                                       Text="Loading Projections..."
                                                       Margin="0,10,0,0"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Snowball Debt Planner">
                                <Grid>
                                    <DockPanel Grid.Column="0">


                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="1*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="2*" />
                                            </Grid.RowDefinitions>
                                            <!-- Advisory Note for Downloaded Transactions & Debt Balances -->
                                            <Border Grid.Row="0" Background="{DynamicResource SurfaceBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderColorBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    Margin="0,0,0,10"
                                                    Visibility="{Binding SnowballOptions.EnableSnowball, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock Text="💡 Snowball Data Notice"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource SpecialHeadingBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <TextBlock Style="{DynamicResource StyledSecondaryTextBlock}"
                                                               Text="Projections only reflect transactions currently in the system. Imported bank files only include posted transactions, so recent external payments (like wiping a credit card balance) won't show up immediately. Until those transactions import, the planner may suggest paying off debt you've already cleared. Ensure your accounts are fully up to date to see accurate investment vs. debt payoff suggestions."
                                                               FontSize="10.5"
                                                               TextWrapping="Wrap"
                                                               LineHeight="15" />
                                                </StackPanel>
                                            </Border>
                                            <!-- EMPTY STATE / PROMOTIONAL PLACEHOLDER FOR SNOWBALL STRATEGY -->
                                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Visibility="{Binding SnowballOptions.EnableSnowball, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <StackPanel Margin="0,0,0,10">
                                                    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderColorBrush}"
                                                            Visibility="{Binding SnowballOptions.EnableSnowball, Converter={StaticResource InverseBooleanToVisibilityConverter}}"

                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="16,14">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <!-- Header -->
                                                            <StackPanel Grid.Row="0" Orientation="Horizontal"
                                                                        Margin="0,0,0,10">
                                                                <Viewbox Width="20" Height="20" Margin="0,0,8,0"
                                                                         VerticalAlignment="Center">
                                                                    <Path
                                                                        Data="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M4.93 19.07L19.07 4.93M7 12l-2-2m2 2l-2 2m10-2l2-2m-2 2l2 2m-5-5l-2-2m2 2l2-2m-2 10l-2 2m2-2l2 2"
                                                                        Stroke="#3B82F6"
                                                                        StrokeThickness="1.75"
                                                                        StrokeStartLineCap="Round"
                                                                        StrokeEndLineCap="Round"
                                                                        StrokeLineJoin="Round"
                                                                        Stretch="Uniform" />
                                                                </Viewbox>
                                                                <TextBlock Style="{DynamicResource StyledTextBlock}"
                                                                           Text="Automated Snowball &amp; Wealth Engine"
                                                                           FontSize="14"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <!-- Explanation Body -->
                                                            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                                                <!-- EXPLANATION & DISCLAIMER CONTAINER -->
                                                                <StackPanel Margin="0,0,0,10">

                                                                    <!-- Primary Overview Text -->
                                                                    <TextBlock
                                                                        Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                        Text="Take control of surplus cash with automated strategies designed to eliminate high-interest debt and accelerate wealth growth. The projections below model optimal allocations based on your strategy and account rates."
                                                                        FontSize="11.5"
                                                                        TextWrapping="Wrap"
                                                                        LineHeight="16"
                                                                        Margin="0,0,0,8" />

                                                                    <!-- Important Notice / Responsibility Callout Box -->
                                                                    <Border
                                                                        Background="{DynamicResource WindowBackgroundBrush}"
                                                                        BorderBrush="{DynamicResource BorderColorBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="6"
                                                                        Padding="10,8"
                                                                        Margin="0,2,0,0">
                                                                        <StackPanel>
                                                                            <DockPanel Margin="0,0,0,4">
                                                                                <!-- Info / Shield Icon -->
                                                                                <Path
                                                                                    Data="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"
                                                                                    Fill="{DynamicResource SpecialHeadingBrush}"
                                                                                    Width="12" Height="12"
                                                                                    Stretch="Uniform"
                                                                                    Margin="0,0,6,0"
                                                                                    DockPanel.Dock="Left"
                                                                                    VerticalAlignment="Center" />

                                                                                <TextBlock Text="Advisory Notice"
                                                                                    FontSize="10.5"
                                                                                    FontWeight="Bold"
                                                                                    Foreground="{DynamicResource SpecialHeadingBrush}"
                                                                                    VerticalAlignment="Center" />
                                                                            </DockPanel>

                                                                            <TextBlock
                                                                                Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                                Text="All figures are hypothetical projections based on user-entered interest rates and parameters. Recommendations do not execute transactions automatically; projected balances and debt payoff timelines will only materialize as you manually complete the transfers in your real-world accounts."
                                                                                FontSize="10.5"
                                                                                TextWrapping="Wrap"
                                                                                LineHeight="15"
                                                                                Opacity="0.85" />
                                                                        </StackPanel>
                                                                    </Border>

                                                                </StackPanel>

                                                                <Grid Margin="0,2,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Feature 1: Debt Snowball -->
                                                                    <Border Grid.Column="0"
                                                                            Background="{DynamicResource WindowBackgroundBrush}"
                                                                            BorderBrush="{DynamicResource BorderColorBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            Padding="10,8"
                                                                            Margin="0,0,4,0">
                                                                        <StackPanel>
                                                                            <TextBlock Text="⚡ Debt Snowball"
                                                                                    FontSize="11"
                                                                                    FontWeight="Bold"
                                                                                    Foreground="{DynamicResource SpecialHeadingBrush}"
                                                                                    Margin="0,0,0,3" />
                                                                            <TextBlock
                                                                                Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                                Text="Directs excess checking balance toward your lowest-balance or highest-interest debt first to build momentum."
                                                                                FontSize="10.5"
                                                                                TextWrapping="Wrap"
                                                                                LineHeight="14" />
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <!-- Feature 2: Wealth Waterfall -->
                                                                    <Border Grid.Column="1"
                                                                            Background="{DynamicResource WindowBackgroundBrush}"
                                                                            BorderBrush="{DynamicResource BorderColorBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            Padding="10,8"
                                                                            Margin="4,0,0,0">
                                                                        <StackPanel>
                                                                            <TextBlock Text="🌊 Wealth Waterfall"
                                                                                    FontSize="11"
                                                                                    FontWeight="Bold"
                                                                                    Foreground="#3B82F6"
                                                                                    Margin="0,0,0,3" />
                                                                            <TextBlock
                                                                                Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                                Text="Once debts are paid, extra cash is suggested to be redirected by you into your investment and growth accounts."
                                                                                FontSize="10.5"
                                                                                TextWrapping="Wrap"
                                                                                LineHeight="14" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </StackPanel>

                                                            <!-- Call-to-Action Footer -->
                                                            <!-- <Border Grid.Row="2" -->
                                                            <!--         Background="#1E3B82F6" -->
                                                            <!--         BorderBrush="#3B82F6" -->
                                                            <!--         BorderThickness="1" -->
                                                            <!--         CornerRadius="6" -->
                                                            <!--         Padding="10,6"> -->
                                                            <!--     <DockPanel> -->
                                                            <!--         <TextBlock Text="💡 Tip:" -->
                                                            <!--                    FontWeight="Bold" -->
                                                            <!--                    FontSize="10.5" -->
                                                            <!--                    Foreground="#3B82F6" -->
                                                            <!--                    Margin="0,0,6,0" -->
                                                            <!--                    DockPanel.Dock="Left" -->
                                                            <!--                    VerticalAlignment="Center" /> -->
                                                            <!--         <TextBlock -->
                                                            <!--             Style="{DynamicResource StyledSecondaryTextBlock}" -->
                                                            <!--             Text="Select 'Enable Snowball Strategy' in Settings to activate real-time surplus projections." -->
                                                            <!--             FontSize="10.5" -->
                                                            <!--             Foreground="{DynamicResource StyledTextBlockForeground}" -->
                                                            <!--             VerticalAlignment="Center" /> -->
                                                            <!--     </DockPanel> -->
                                                            <!-- </Border> -->
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </ScrollViewer>
                                            <DataGrid x:Name="SnowballGrid" Grid.Row="1"
                                                      ItemsSource="{Binding SnowballProjections}"
                                                      Visibility="{Binding SnowballOptions.EnableSnowball, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                      AutoGenerateColumns="False"
                                                      EnableRowVirtualization="True"
                                                      CanUserAddRows="False">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="{x:Type DataGridRow}">
                                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                        <Setter Property="BorderBrush" Value="LightGray" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeedsAttention}"
                                                                         Value="True">
                                                                <Setter Property="BorderThickness" Value="0,2,0,0" />
                                                                <Setter Property="BorderBrush"
                                                                        Value="{DynamicResource GridPeriodBorderBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Posting Date"
                                                                        HeaderStyle="{DynamicResource    CenterAlignedHeaderStyle}"
                                                                        Binding="{Binding TransactionDate, StringFormat='{}{0:MM/dd/yyyy}'}"
                                                                        IsReadOnly="False" Width="90">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextAlignment" Value="Center" />
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Description"
                                                                        Binding="{Binding Description}"
                                                                        IsReadOnly="True"
                                                                        Width="150" />
                                                    <DataGridTextColumn Header="Amount"
                                                                        HeaderStyle="{DynamicResource    RightAlignedHeaderStyle}"
                                                                        Binding="{Binding Amount, StringFormat=C, UpdateSourceTrigger=PropertyChanged}"
                                                                        Width="90" MinWidth="80">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextAlignment" Value="Right" />
                                                                <Setter Property="Padding" Value="0,0,8,0" />
                                                                <Setter Property="Foreground"
                                                                        Value="{Binding Amount, Converter={StaticResource AmountToBrushConverter}}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBucket}"
                                                                            Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource GridBucketForegroundBrush}" />
                                                                        <Setter Property="FontStyle" Value="Italic" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSweep}"
                                                                            Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource GridSweepForegroundBrush}" />
                                                                        <Setter Property="FontStyle" Value="Italic" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Total Balance"
                                                                        HeaderStyle="{DynamicResource    RightAlignedHeaderStyle}"
                                                                        Binding="{Binding Balance, StringFormat=C}"
                                                                        Width="90">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextAlignment" Value="Right" />
                                                                <Setter Property="Padding" Value="0,0,8,0" />
                                                                <Setter Property="Foreground"
                                                                        Value="{Binding Balance, Converter={StaticResource AmountToBrushConverter}}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWarning}"
                                                                            Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource BadNumericHighlightBrush}" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Period Net"
                                                                        HeaderStyle="{DynamicResource    RightAlignedHeaderStyle}"
                                                                        Binding="{Binding PeriodNet, StringFormat=C}"
                                                                        Width="90">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextAlignment" Value="Right" />
                                                                <Setter Property="Padding" Value="0,0,8,0" />
                                                                <Setter Property="Foreground"
                                                                        Value="{Binding Amount, Converter={StaticResource AmountToBrushConverter}}" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                                <Style.Triggers>
                                                                    <DataTrigger
                                                                        Binding="{Binding PeriodNet, Converter={StaticResource NegativeToRedConverter}}"
                                                                        Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource BadNumericHighlightBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <GridSplitter Grid.Row="2" ResizeDirection="Rows" Height="2"
                                                          HorizontalAlignment="Stretch"
                                                          Style="{DynamicResource    ModernGridSplitterStyle}"
                                                          VerticalAlignment="Stretch"
                                                          ResizeBehavior="PreviousAndNext"
                                                          ShowsPreview="True" />

                                            <Grid Grid.Row="3" Margin="0,5,0,0">

                                                <local:ProjectionLiveChartControl
                                                    Projections="{Binding SnowballProjections}"
                                                    Accounts="{Binding VisibleAccounts}">
                                                    <local:ProjectionLiveChartControl.Visibility>
                                                        <MultiBinding
                                                            Converter="{StaticResource MultiBooleanToVisibilityConverter}">
                                                            <Binding Path="SnowballOptions.EnableSnowball" />
                                                            <Binding Path="IsSnowballProjecting" />
                                                        </MultiBinding>
                                                    </local:ProjectionLiveChartControl.Visibility>
                                                </local:ProjectionLiveChartControl>
                                                <StackPanel
                                                    Visibility="{Binding IsSnowballProjecting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Vertical">
                                                    <Viewbox Width="50" Height="50">
                                                        <Control>
                                                            <Control.Template>
                                                                <ControlTemplate TargetType="Control">
                                                                    <Grid RenderTransformOrigin="0.5,0.5">
                                                                        <Grid.RenderTransform>
                                                                            <RotateTransform x:Name="SpinTransform"
                                                                                    Angle="0" />
                                                                        </Grid.RenderTransform>
                                                                        <Canvas Width="48" Height="48">
                                                                            <Path Data="M24,4 A20,20 0 1,1 23.99,4"
                                                                                    Stroke="#E2E8F0"
                                                                                    StrokeThickness="4"
                                                                                    StrokeStartLineCap="Round"
                                                                                    StrokeEndLineCap="Round" />
                                                                            <Path Data="M24,4 A20,20 0 0,1 44,24"
                                                                                    Stroke="#3B82F6"
                                                                                    StrokeThickness="4"
                                                                                    StrokeStartLineCap="Round"
                                                                                    StrokeEndLineCap="Round" />
                                                                        </Canvas>
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsVisible" Value="True">
                                                                            <Trigger.EnterActions>
                                                                                <BeginStoryboard x:Name="SpinStory">
                                                                                    <Storyboard
                                                                                        RepeatBehavior="Forever">
                                                                                        <DoubleAnimation
                                                                                            Storyboard.TargetName="SpinTransform"
                                                                                            Storyboard.TargetProperty="Angle"
                                                                                            From="0" To="360"
                                                                                            Duration="0:0:1" />
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </Trigger.EnterActions>
                                                                            <Trigger.ExitActions>
                                                                                <StopStoryboard
                                                                                    BeginStoryboardName="SpinStory" />
                                                                            </Trigger.ExitActions>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Control.Template>
                                                        </Control>
                                                    </Viewbox>
                                                    <TextBlock Text="Loading Snowball Projections..."
                                                               Style="{DynamicResource    StyledTextBlock}"
                                                               Margin="0,10,0,0"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>

                                                <!-- EDUCATIONAL PLACEHOLDER (When EnableSnowball is False) -->
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              Visibility="{Binding SnowballOptions.EnableSnowball, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <StackPanel Margin="0,0,0,10">
                                                        <StackPanel Margin="0,0,0,10"
                                                                    Visibility="{Binding SnowballOptions.EnableSnowball, Converter={StaticResource InverseBooleanToVisibilityConverter}}">


                                                            <!-- CARD 1: SURPLUS ALLOCATION & WEALTH BUILDING -->
                                                            <Border
                                                                Background="{DynamicResource SurfaceBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BorderColorBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="12,10"
                                                                Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <!-- Section Header -->
                                                                    <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                                                        <StackPanel Orientation="Horizontal"
                                                                                VerticalAlignment="Center"
                                                                                DockPanel.Dock="Left">
                                                                            <Viewbox Width="18" Height="18"
                                                                                    Margin="0,0,6,0">
                                                                                <Path
                                                                                    Data="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M4.93 19.07L19.07 4.93M7 12l-2-2m2 2l-2 2m10-2l2-2m-2 2l2 2m-5-5l-2-2m2 2l2-2m-2 10l-2 2m2-2l2 2"
                                                                                    Stroke="#3B82F6"
                                                                                    StrokeThickness="1.75"
                                                                                    StrokeStartLineCap="Round"
                                                                                    StrokeEndLineCap="Round"
                                                                                    StrokeLineJoin="Round"
                                                                                    Stretch="Uniform" />
                                                                            </Viewbox>
                                                                            <TextBlock
                                                                                Style="{DynamicResource StyledTextBlock}"
                                                                                Text="1. Managing Surplus &amp; Idle Cash"
                                                                                FontSize="14" FontWeight="SemiBold"
                                                                                TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>

                                                                        <Border Background="#1E3B82F6"
                                                                                BorderBrush="#3B82F6"
                                                                                BorderThickness="1" CornerRadius="10"
                                                                                Padding="8,3" DockPanel.Dock="Right"
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Center">
                                                                            <TextBlock Text="Wealth Strategy"
                                                                                    FontSize="10" FontWeight="Bold"
                                                                                    Foreground="#3B82F6" />
                                                                        </Border>
                                                                    </DockPanel>

                                                                    <TextBlock
                                                                        Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                        Text="Extra cash often sits idle in low-interest checking accounts. Snowball sweeps protect your safety cushion and automatically put excess cash to work in investments."
                                                                        FontSize="11.5" TextWrapping="Wrap"
                                                                        LineHeight="16" Margin="0,0,0,12" />

                                                                    <!-- Comparison Grid 1 -->
                                                                    <Grid Margin="0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <!-- Spacing Column -->
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>

                                                                        <!-- Idle Accumulation (Card 1A) -->
                                                                        <Border
                                                                            Background="{DynamicResource WindowBackgroundBrush}"
                                                                            BorderBrush="{DynamicResource BorderColorBrush}"
                                                                            BorderThickness="1" CornerRadius="6"
                                                                            Padding="10,8" Margin="0,0,0,8"
                                                                            MinWidth="260"
                                                                            HorizontalAlignment="Stretch">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <!-- Wide Display: Row 0, Column 0 -->
                                                                                    <Setter Property="Grid.Row"
                                                                                        Value="0" />
                                                                                    <Setter Property="Grid.Column"
                                                                                        Value="0" />
                                                                                    <Setter Property="Grid.ColumnSpan"
                                                                                        Value="1" />
                                                                                    <Style.Triggers>
                                                                                        <!-- Narrow Display (< 1100px): Span full width of Row 0 -->
                                                                                        <DataTrigger
                                                                                            Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource LessThanConverter}, ConverterParameter=1100}"
                                                                                            Value="True">
                                                                                            <Setter
                                                                                                Property="Grid.ColumnSpan"
                                                                                                Value="3" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>

                                                                            <StackPanel>
                                                                                <DockPanel Margin="0,0,0,4"
                                                                                    LastChildFill="False">
                                                                                    <TextBlock
                                                                                        Text="Idle Cash Build-Up"
                                                                                        FontSize="10.5"
                                                                                        FontWeight="Bold"
                                                                                        DockPanel.Dock="Left"
                                                                                        TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Text="Idle Cash Stack"
                                                                                        FontSize="9.5"
                                                                                        Foreground="{DynamicResource ErrorBrush}"
                                                                                        DockPanel.Dock="Right"
                                                                                        HorizontalAlignment="Right" />
                                                                                </DockPanel>

                                                                                <Border Height="55"
                                                                                    Background="{DynamicResource SurfaceBackgroundBrush}"
                                                                                    CornerRadius="4" Padding="6"
                                                                                    Margin="0,0,0,4">
                                                                                    <Viewbox Stretch="Fill">
                                                                                        <Canvas Width="200" Height="45">
                                                                                            <Line X1="0" Y1="42"
                                                                                                X2="200" Y2="42"
                                                                                                Stroke="{DynamicResource BorderColorBrush}"
                                                                                                StrokeThickness="1"
                                                                                                StrokeDashArray="2 2" />
                                                                                            <Path
                                                                                                Data="M 0,40 L 15,28 L 20,33 L 35,21 L 40,26 L 60,15 L 65,20 L 85,10 L 90,15 L 110,5 L 115,10 L 140,2"
                                                                                                Stroke="#F59E0B"
                                                                                                StrokeThickness="2"
                                                                                                StrokeLineJoin="Round" />
                                                                                        </Canvas>
                                                                                    </Viewbox>
                                                                                </Border>

                                                                                <TextBlock
                                                                                    Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                                    Text="Checking trends constantly upward while cash sits idle instead of building yield."
                                                                                    FontSize="10" TextWrapping="Wrap"
                                                                                    LineHeight="13" />
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <!-- Leveled Sweep (Card 1B) -->
                                                                        <Border
                                                                            Background="{DynamicResource WindowBackgroundBrush}"
                                                                            BorderBrush="{DynamicResource BorderColorBrush}"
                                                                            BorderThickness="1" CornerRadius="6"
                                                                            Padding="10,8" Margin="0,0,0,8"
                                                                            MinWidth="260"
                                                                            HorizontalAlignment="Stretch">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <!-- Wide Display: Row 0, Column 2 -->
                                                                                    <Setter Property="Grid.Row"
                                                                                        Value="0" />
                                                                                    <Setter Property="Grid.Column"
                                                                                        Value="2" />
                                                                                    <Setter Property="Grid.ColumnSpan"
                                                                                        Value="1" />
                                                                                    <Style.Triggers>
                                                                                        <!-- Narrow Display (< 1100px): Move to Row 1 and span full width -->
                                                                                        <DataTrigger
                                                                                            Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource LessThanConverter}, ConverterParameter=1100}"
                                                                                            Value="True">
                                                                                            <Setter Property="Grid.Row"
                                                                                                Value="1" />
                                                                                            <Setter
                                                                                                Property="Grid.Column"
                                                                                                Value="0" />
                                                                                            <Setter
                                                                                                Property="Grid.ColumnSpan"
                                                                                                Value="3" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>

                                                                            <StackPanel>
                                                                                <DockPanel Margin="0,0,0,4"
                                                                                    LastChildFill="False">
                                                                                    <TextBlock Text="Snowball Sweep"
                                                                                        FontSize="10.5"
                                                                                        FontWeight="Bold"
                                                                                        Foreground="{DynamicResource SpecialHeadingBrush}"
                                                                                        DockPanel.Dock="Left"
                                                                                        TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Text="Leveled Cushion"
                                                                                        FontSize="9.5"
                                                                                        Foreground="{DynamicResource SuccessBrush}"
                                                                                        DockPanel.Dock="Right"
                                                                                        HorizontalAlignment="Right" />
                                                                                </DockPanel>

                                                                                <Border Height="55"
                                                                                    Background="{DynamicResource SurfaceBackgroundBrush}"
                                                                                    CornerRadius="4" Padding="6"
                                                                                    Margin="0,0,0,4">
                                                                                    <Viewbox Stretch="Fill">
                                                                                        <Canvas Width="200" Height="45">
                                                                                            <Line X1="0" Y1="35"
                                                                                                X2="200" Y2="35"
                                                                                                Stroke="#10B981"
                                                                                                StrokeThickness="1.5" />
                                                                                            <Path
                                                                                                Data="M 0,22 L 15,10 L 18,32 L 35,12 L 38,33 L 60,14 L 63,32 L 85,13 L 88,31 L 110,12 L 113,33 L 140,14"
                                                                                                Stroke="#3B82F6"
                                                                                                StrokeThickness="2"
                                                                                                StrokeLineJoin="Round" />
                                                                                        </Canvas>
                                                                                    </Viewbox>
                                                                                </Border>

                                                                                <TextBlock
                                                                                    Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                                    Text="Checking stays safely above your floor while excess cash is swept into growth accounts."
                                                                                    FontSize="10" TextWrapping="Wrap"
                                                                                    LineHeight="13" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- CARD 2: DEBT TURNAROUND & RECOVERY -->
                                                            <Border
                                                                Background="{DynamicResource SurfaceBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BorderColorBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="12,10"
                                                                Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <!-- Section Header -->
                                                                    <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                                                        <StackPanel Orientation="Horizontal"
                                                                                VerticalAlignment="Center">
                                                                            <Viewbox Width="18" Height="18"
                                                                                    Margin="0,0,6,0">
                                                                                <!-- Shield / Check Icon -->
                                                                                <Path
                                                                                    Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-5.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"
                                                                                    Fill="#10B981"
                                                                                    Stretch="Uniform" />
                                                                            </Viewbox>
                                                                            <TextBlock
                                                                                Style="{DynamicResource StyledTextBlock}"
                                                                                Text="2. Reversing Downward Debt Trajectories"
                                                                                FontSize="14"
                                                                                FontWeight="SemiBold" />
                                                                        </StackPanel>

                                                                        <Border Background="#1E10B981"
                                                                                BorderBrush="#10B981"
                                                                                BorderThickness="1"
                                                                                CornerRadius="10"
                                                                                Padding="8,3"
                                                                                HorizontalAlignment="Right"
                                                                                DockPanel.Dock="Right">
                                                                            <TextBlock Text="Debt Recovery"
                                                                                    FontSize="10"
                                                                                    FontWeight="Bold"
                                                                                    Foreground="#10B981" />
                                                                        </Border>
                                                                    </DockPanel>

                                                                    <TextBlock
                                                                        Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                        Text="Minimum payments leave debt dragging your balances down. The snowball strategy targets debts in order to stop interest bleed and level out your balance."
                                                                        FontSize="11.5"
                                                                        TextWrapping="Wrap"
                                                                        LineHeight="16"
                                                                        Margin="0,0,0,12" />

                                                                    <!-- Comparison Grid 2 -->
                                                                    <Grid Margin="0,0,0,0">
                                                                        <!-- Grid Layout Setup -->
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <!-- Spacing Column -->
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>


                                                                        <!-- Downward Trajectory -->
                                                                        <Border
                                                                            Background="{DynamicResource WindowBackgroundBrush}"
                                                                            BorderBrush="{DynamicResource BorderColorBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            Padding="10,8"
                                                                            Margin="0,0,0,8"
                                                                            MinWidth="260"
                                                                            HorizontalAlignment="Stretch">

                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <!-- Default (Wide Display): Row 0, Column 0 -->
                                                                                    <Setter Property="Grid.Row"
                                                                                        Value="0" />
                                                                                    <Setter Property="Grid.Column"
                                                                                        Value="0" />
                                                                                    <Setter Property="Grid.ColumnSpan"
                                                                                        Value="1" />

                                                                                    <Style.Triggers>
                                                                                        <!-- Narrow Display: Span full width of Row 0 -->
                                                                                        <DataTrigger
                                                                                            Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource LessThanConverter}, ConverterParameter=1100}"
                                                                                            Value="True">
                                                                                            <Setter
                                                                                                Property="Grid.ColumnSpan"
                                                                                                Value="3" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <StackPanel>
                                                                                <DockPanel Margin="0,0,0,4"
                                                                                    LastChildFill="False">
                                                                                    <TextBlock Text="Debt Mounting"
                                                                                        FontSize="10.5"
                                                                                        FontWeight="Bold" />
                                                                                    <TextBlock Text="Downward Spiral"
                                                                                        FontSize="9.5"
                                                                                        Foreground="{DynamicResource ErrorBrush}"
                                                                                        DockPanel.Dock="Right"
                                                                                        HorizontalAlignment="Right" />
                                                                                </DockPanel>

                                                                                <Border Height="55"
                                                                                    Background="{DynamicResource SurfaceBackgroundBrush}"
                                                                                    CornerRadius="4" Padding="6"
                                                                                    Margin="0,0,0,4">
                                                                                    <Viewbox Stretch="Fill">
                                                                                        <Canvas Width="200" Height="45">
                                                                                            <!-- Floor cushion warning line -->
                                                                                            <Line X1="0" Y1="42"
                                                                                                X2="200"
                                                                                                Y2="42"
                                                                                                Stroke="{DynamicResource ErrorBrush}"
                                                                                                StrokeThickness="1"
                                                                                                StrokeDashArray="2 2" />
                                                                                            <!-- Downward Trend Path -->
                                                                                            <Path
                                                                                                Data="M 0,5 L 15,12 L 20,8 L 35,22 L 40,18 L 60,30 L 65,25 L 85,38 L 90,34 L 110,45 L 115,40 L 140,50"
                                                                                                Stroke="{DynamicResource ErrorBrush}"
                                                                                                StrokeThickness="2"
                                                                                                StrokeLineJoin="Round" />
                                                                                        </Canvas>
                                                                                    </Viewbox>
                                                                                </Border>

                                                                                <TextBlock
                                                                                    Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                                    Text="Interest charges accumulate, pulling the balance downward toward or below safety cushions."
                                                                                    FontSize="10" TextWrapping="Wrap"
                                                                                    LineHeight="13" />
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <!-- Snowball Turnaround -->
                                                                        <Border
                                                                            Background="{DynamicResource WindowBackgroundBrush}"
                                                                            BorderBrush="{DynamicResource BorderColorBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            Padding="10,8"
                                                                            Margin="0,0,0,8"
                                                                            MinWidth="260"
                                                                            HorizontalAlignment="Stretch">

                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <!-- Default (Wide Display): Row 0, Column 2 -->
                                                                                    <Setter Property="Grid.Row"
                                                                                        Value="0" />
                                                                                    <Setter Property="Grid.Column"
                                                                                        Value="2" />
                                                                                    <Setter Property="Grid.ColumnSpan"
                                                                                        Value="1" />

                                                                                    <Style.Triggers>
                                                                                        <!-- Narrow Display: Move to Row 1 and span full width -->
                                                                                        <DataTrigger
                                                                                            Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource LessThanConverter}, ConverterParameter=1100}"
                                                                                            Value="True">
                                                                                            <Setter Property="Grid.Row"
                                                                                                Value="1" />
                                                                                            <Setter
                                                                                                Property="Grid.Column"
                                                                                                Value="0" />
                                                                                            <Setter
                                                                                                Property="Grid.ColumnSpan"
                                                                                                Value="3" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <StackPanel>
                                                                                <DockPanel Margin="0,0,0,4"
                                                                                    LastChildFill="False">
                                                                                    <TextBlock Text="Snowball Payoff"
                                                                                        FontSize="10.5"
                                                                                        FontWeight="Bold"
                                                                                        Foreground="{DynamicResource SpecialHeadingBrush}" />
                                                                                    <TextBlock Text="Stabilized Floor"
                                                                                        FontSize="9.5"
                                                                                        Foreground="{DynamicResource SuccessBrush}"
                                                                                        DockPanel.Dock="Right"
                                                                                        HorizontalAlignment="Right" />
                                                                                </DockPanel>

                                                                                <Border Height="55"
                                                                                    Background="{DynamicResource SurfaceBackgroundBrush}"
                                                                                    CornerRadius="4" Padding="6"
                                                                                    Margin="0,0,0,4">
                                                                                    <!-- Make Canvas Viewport Responsive to Width -->
                                                                                    <Viewbox Stretch="Fill">
                                                                                        <Canvas Width="200" Height="45">
                                                                                            <Line X1="0" Y1="25"
                                                                                                X2="200"
                                                                                                Y2="25"
                                                                                                Stroke="#10B981"
                                                                                                StrokeThickness="1.5" />
                                                                                            <!-- Turnaround Curve Path: Drops initially, then flattens/curves up above safety floor -->
                                                                                            <Path
                                                                                                Data="M 0,8 L 15,18 L 18,14 L 35,24 L 38,20 L 60,25 L 63,22 L 85,25 L 88,21 L 110,25 L 113,20 L 140,24"
                                                                                                Stroke="#10B981"
                                                                                                StrokeThickness="2"
                                                                                                StrokeLineJoin="Round" />
                                                                                        </Canvas>
                                                                                    </Viewbox>
                                                                                </Border>

                                                                                <TextBlock
                                                                                    Style="{DynamicResource StyledSecondaryTextBlock}"
