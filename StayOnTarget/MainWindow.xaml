                                                                <!-- <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80" MinWidth="80" /> -->
                                                                <!-- <DataGridCheckBoxColumn Header="Include in Total" Binding="{Binding IncludeInTotal}" Width="60" MinWidth="60"> -->
                                                                <!--     <DataGridCheckBoxColumn.HeaderTemplate> -->
                                                                <!--         <DataTemplate> -->
                                                                <!--             <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" /> -->
                                                                <!--         </DataTemplate> -->
                                                                <!--     </DataGridCheckBoxColumn.HeaderTemplate> -->
                                                                <!-- </DataGridCheckBoxColumn> -->
