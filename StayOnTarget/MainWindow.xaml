                                                                        Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                                        <Binding Path="CanEditAccount" />
                                                                        <Binding Path="IsNotEditingAccount" />
                                                                    </MultiBinding>
                                                                </Button.Visibility>
                                                            </Button>
