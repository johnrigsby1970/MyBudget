                                                                                        Value="True">
                                                                                        <Setter Property="Background"
                                                                                            Value="#FFCCCC" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </DataGrid.RowStyle>
                                                                        <DataGrid.InputBindings>
                                                                            <MouseBinding MouseAction="LeftDoubleClick"
