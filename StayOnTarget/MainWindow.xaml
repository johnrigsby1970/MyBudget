                                            <Border Background="#E8F4FD" BorderBrush="#BEE3F8" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,5,0,15"
        Visibility="{Binding ShowSnowballAnalysis, Converter={StaticResource BooleanToVisibilityConverter}}">
    <StackPanel>
        <TextBlock Text="Strategy Comparison" FontWeight="Bold" Foreground="#0369A1" Margin="0,0,0,8" />
        
        <!-- Debt Free Milestone (If reached) -->
        <StackPanel Visibility="{Binding SnowballDebtFreeDate, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Foreground="#1E293B" FontSize="12">
                <Run Text="Estimated Debt Free: " />
                <Run Text="{Binding SnowballDebtFreeDate, StringFormat={}{0:MMM yyyy}, Mode=OneWay}" FontWeight="Bold" />
            </TextBlock>
            <TextBlock Foreground="{Binding SnowballMonthsSaved, Converter={StaticResource DeltaToBrushConverter}}" 
                       FontSize="11" FontWeight="Bold" Margin="0,2,0,8"
                       Visibility="{Binding SnowballMonthsSaved, Converter={StaticResource IntToVisibilityConverter}}">
                <Run Text="(Saves " />
                <Run Text="{Binding SnowballMonthsSaved, Mode=OneWay}" />
                <Run Text=" months vs current plan)" />
            </TextBlock>
        </StackPanel>

        <!-- End of Projection Debt (If not paid off) -->
        <StackPanel Visibility="{Binding SnowballDebtFreeDate, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
            <TextBlock Foreground="#1E293B" FontSize="12">
                <Run Text="End of Projection Debt: " />
                <Run Text="{Binding SnowballFinalDebt, StringFormat='{}{0:+$#,##0;-$#,##0;$0}', Mode=OneWay}" FontWeight="Bold" />
            </TextBlock>
            <TextBlock Foreground="{Binding SnowballDebtReductionVsStandard, Converter={StaticResource DeltaToBrushConverter}}" 
                       FontSize="11" FontWeight="Bold" Margin="0,2,0,8"
                       Visibility="{Binding SnowballDebtReductionVsStandard, Converter={StaticResource IntToVisibilityConverter}}">
                <Run Text="(" />
                <Run Text="{Binding SnowballDebtReductionVsStandard, StringFormat='{}{0:+$#,##0;-$#,##0;$0}', Mode=OneWay}" />
                <Run Text=" less than current plan)" />
            </TextBlock>
        </StackPanel>

        <!-- Net Worth Output -->
        <TextBlock Foreground="#1E293B" FontSize="12">
            <Run Text="Final Net Worth: " />
            <Run Text="{Binding SnowballFinalNetWorth, StringFormat='{}{0:+$#,##0;-$#,##0;$0}', Mode=OneWay}" FontWeight="Bold" />
        </TextBlock>
        <TextBlock Foreground="{Binding SnowballNetWorthImprovement, Converter={StaticResource DeltaToBrushConverter}}" 
                   FontSize="11" FontWeight="Bold" Margin="0,2,0,8">
            <Run Text="(" />
            <Run Text="{Binding SnowballNetWorthImprovement, StringFormat='{}{0:+$#,##0;-$#,##0;$0}', Mode=OneWay}" />
            <Run Text=" improvement)" />
        </TextBlock>

        <!-- ~1~ NEW: Dynamic Layman's Summary Insight @1@ -->
        <!-- <Border BorderBrush="#BAE6FD" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,8,0,0"> -->
        <!--     <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#0C4A6E" LineHeight="15"> -->
        <!--         <Run Text="💡 " /> -->
        <!--         <Run Text="{Binding StrategyTakeawayText, Mode=OneWay}" FontStyle="Italic" /> -->
        <!--     </TextBlock> -->
        <!-- </Border> -->
        <!-- Insight Container -->
        <Border BorderBrush="#BAE6FD" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
            <StackPanel>
                <!-- Primary Outcome Paragraph -->
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#0C4A6E" FontWeight="SemiBold" LineHeight="16" Margin="0,0,0,6">
                    <Run Text="💡 " />
                    <Run Text="{Binding StrategyTakeawayPrimary, Mode=OneWay}" />
                </TextBlock>

                <!-- General Dilemma Paragraph -->
                <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="#475569" LineHeight="15" FontStyle="Italic">
                    <Run Text="{Binding StrategyTakeawayDilemma, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</Border>
                                            
