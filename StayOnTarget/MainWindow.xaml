                                                        Margin="2"
                                                        Background="Red"
                                                        Foreground="White" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" Margin="5">
                                                <Button Content="Edit" Command="{Binding EditPeriodBucketCommand}"
                                                        Width="80"
                                                        Margin="2">
                                                    <Button.Visibility>
                                                        <MultiBinding
                                                            Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                            <Binding Path="CanEditPeriodBucket" />
                                                            <Binding Path="IsNotEditingPeriodBucket" />
                                                        </MultiBinding>
                                                    </Button.Visibility>
                                                </Button>

                                                <Button Content="Save" Command="{Binding SavePeriodBucketCommand}"
                                                        Visibility="{Binding IsEditingPeriodBucket, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Width="80"
                                                        Margin="2"
                                                        Background=" CornflowerBlue"
                                                        Foreground="White" />
                                                <Button Content="Cancel"
                                                        Command="{Binding CancelPeriodBucketCommand}"
