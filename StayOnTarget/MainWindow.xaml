                                        <Button.Visibility>
                                            <MultiBinding Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                <Binding Path="CanEditBucket" />
                                                <Binding Path="IsNotEditingBucket" />
                                            </MultiBinding>
                                        </Button.Visibility>
                                    </Button>
                                    <Button Content="Save" Command="{Binding SaveBucketCommand}" Margin="5" Width="80"
                                            Background=" CornflowerBlue"
                                            Foreground="White"
                                            Visibility="{Binding IsEditingBucket, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button Content="Cancel" Command="{Binding CancelBucketCommand}" Margin="5"
                                            Width="80"
                                            Visibility="{Binding IsEditingBucket, Converter={StaticResource BooleanToVisibilityConverter}}" />
