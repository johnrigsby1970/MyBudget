                                                                                                <ColumnDefinition
                                                                                                    Width="*" />
                                                                                                <ColumnDefinition
                                                                                                    Width="Auto" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock Grid.Column="0"
                                                                                                Text="{Binding BillName}"
                                                                                                FontWeight="SemiBold"
                                                                                                TextTrimming="CharacterEllipsis"
                                                                                                VerticalAlignment="Center" />
