                                                                            <Label Grid.Column="2">
                                                                                <Label.Style>
                                                                                    <Style TargetType="Label">
                                                                                        <Setter Property="Content"
                                                                                            Value="Budgeted:" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger
                                                                                                Binding="{Binding EditingPeriodBucketClone.IsAccumulatingDrawdown}"
                                                                                                Value="True">
                                                                                                <Setter
                                                                                                    Property="Content"
                                                                                                    Value="Set Aside Amount:" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Label.Style>
                                                                            </Label>
                                                                            <controls:NumericTextBox Grid.Column="3"
                                                                                    Text="{Binding EditingPeriodBucketClone.ActualAmount, UpdateSourceTrigger=PropertyChanged}"
                                                                                    Margin="5" />
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DockPanel>
                                                        </TabItem>
                                                    </TabControl>
                                                </DockPanel>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

