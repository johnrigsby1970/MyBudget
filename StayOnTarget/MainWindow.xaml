                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <Label Grid.Column="0" Grid.Row="0" Content="Name:" />
                                                                <TextBox Grid.Column="1" Grid.Row="0"
                                                                         Text="{Binding EditingAccountClone.Name, UpdateSourceTrigger=PropertyChanged}"
                                                                         Margin="5" />
                                                                <CheckBox Grid.Column="2" Grid.Row="0"
                                                                          Content="Include In Total"
                                                                          IsChecked="{Binding EditingAccountClone.IncludeInTotal}"
                                                                          VerticalAlignment="Center" Margin="5" />

                                                                <Label Grid.Column="0" Grid.Row="1" Content="Bank:" />
                                                                <TextBox Grid.Column="1" Grid.Row="1"
                                                                         Text="{Binding EditingAccountClone.BankName, UpdateSourceTrigger=PropertyChanged}"
                                                                         Margin="5" />

                                                                <Label Grid.Column="2" Grid.Row="1" Content="Type:" />
                                                                <StackPanel Grid.Column="3" Grid.Row="1"
                                                                            Orientation="Horizontal">
                                                                    <ComboBox ItemsSource="{Binding AccountTypes}"
                                                                              SelectedItem="{Binding EditingAccountClone.Type}"
                                                                              Margin="5" />
                                                                    <CheckBox Content="Primary"
                                                                              IsChecked="{Binding EditingAccountClone.IsPrimary}"
                                                                              VerticalAlignment="Center"
                                                                              Margin="0,0,10,0"
                                                                              Visibility="{Binding EditingAccountClone.Type, ConverterParameter='Checking|Savings', Converter={StaticResource AccountTypeToVisibilityConverter}, FallbackValue=Collapsed}" />
                                                                </StackPanel>

                                                                <Label Grid.Column="0" Grid.Row="2" Content="Balance:" />
                                                                <TextBox Grid.Column="1" Grid.Row="2"
                                                                         Text="{Binding EditingAccountClone.Balance, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                                                         Margin="5" />
                                                                <Label Grid.Column="2" Grid.Row="2" Content="As Of:" />
                                                                <DatePicker Grid.Column="3" Grid.Row="2"
                                                                            SelectedDate="{Binding EditingAccountClone.BalanceAsOf}"
                                                                            Margin="5" />

                                                                <Label Grid.Column="0" Grid.Row="3" Content="Growth %:" />
                                                                <TextBox Grid.Column="1" Grid.Row="3"
                                                                         Text="{Binding EditingAccountClone.AnnualGrowthRate, UpdateSourceTrigger=PropertyChanged}"
                                                                         Margin="5" />
                                                                <Label Grid.Column="2" Grid.Row="3"
                                                                       Content="Color (Hex):" />
                                                                <TextBox Grid.Column="3" Grid.Row="3"
                                                                         Text="{Binding EditingAccountClone.HexColor, UpdateSourceTrigger=PropertyChanged}"
                                                                         Margin="5" />

                                                                <!-- Mortgage Details -->
                                                                <StackPanel Grid.Column="0" Grid.Row="4"
                                                                            Grid.ColumnSpan="4" Orientation="Vertical"
                                                                            Visibility="{Binding EditingAccountClone.Type, ConverterParameter=Mortgage, Converter={StaticResource AccountTypeToVisibilityConverter}}">
                                                                    <TextBlock Text="Mortgage Details" FontSize="12"
                                                                               FontWeight="Bold" Margin="0,5,0,5" />
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Label Grid.Row="0" Grid.Column="0"
                                                                               Content="Rate %:" />
                                                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                                                Text="{Binding EditingAccountClone.MortgageDetails.InterestRate, UpdateSourceTrigger=PropertyChanged}"
                                                                                Margin="5" />
                                                                        <Label Grid.Row="0" Grid.Column="2"
                                                                               Content="Escrow:" />
                                                                        <TextBox Grid.Row="0" Grid.Column="3"
                                                                                Text="{Binding EditingAccountClone.MortgageDetails.Escrow, UpdateSourceTrigger=PropertyChanged}"
                                                                                Margin="5" />
                                                                        <Label Grid.Row="1" Grid.Column="0"
                                                                               Content="Insurance:" />
                                                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                                                Text="{Binding EditingAccountClone.MortgageDetails.MortgageInsurance, UpdateSourceTrigger=PropertyChanged}"
                                                                                Margin="5" />
                                                                        <Label Grid.Row="2" Grid.Column="0"
                                                                               Content="Payment:" />
                                                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                                                Text="{Binding EditingAccountClone.MortgageDetails.LoanPayment, UpdateSourceTrigger=PropertyChanged}"
                                                                                Margin="5" />
                                                                        <Label Grid.Row="2" Grid.Column="2"
                                                                               Content="Statement date:" />
                                                                        <DatePicker Grid.Row="2" Grid.Column="3"
                                                                                SelectedDate="{Binding EditingAccountClone.MortgageDetails.PaymentDate, UpdateSourceTrigger=PropertyChanged}"
                                                                                MinWidth="90" Margin="5" />
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Credit Card Details -->
                                                                <StackPanel Grid.Column="0" Grid.Row="4"
                                                                            Grid.ColumnSpan="4" Orientation="Vertical"
                                                                            Visibility="{Binding EditingAccountClone.Type, ConverterParameter=CreditCard, Converter={StaticResource AccountTypeToVisibilityConverter}}">
                                                                    <TextBlock Text="Credit Card Details" FontSize="12"
                                                                               FontWeight="Bold" Margin="0,5,0,5" />
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Label Grid.Row="0" Grid.Column="0"
                                                                               Content="Statement Day:" />
                                                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                                                Text="{Binding EditingAccountClone.CreditCardDetails.StatementDay, UpdateSourceTrigger=PropertyChanged}"
                                                                                Margin="5" />
                                                                        <Label Grid.Row="0" Grid.Column="2"
                                                                               Content="Due Date Offset:" />
                                                                        <TextBox Grid.Row="0" Grid.Column="3"
                                                                                Text="{Binding EditingAccountClone.CreditCardDetails.DueDateOffset, UpdateSourceTrigger=PropertyChanged}"
                                                                                Margin="5" />
                                                                        <Label Grid.Row="1" Grid.Column="0"
                                                                               Content="Minimum payment:" />
                                                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                                                Text="{Binding EditingAccountClone.CreditCardDetails.MinPayFloor, UpdateSourceTrigger=PropertyChanged}"
                                                                                Margin="5" />
                                                                        <CheckBox Grid.Row="1" Grid.Column="2"
                                                                                Content="Grace Period"
                                                                                IsChecked="{Binding EditingAccountClone.CreditCardDetails.PayPreviousMonthBalanceInFull, UpdateSourceTrigger=PropertyChanged}"
                                                                                VerticalAlignment="Center" Margin="5"
                                                                                ToolTip="Interest is not charged if previous month's balance is paid in full" />
                                                                        <Button Grid.Row="2" Grid.Column="0"
                                                                                Content="Manage Interest Rates"
                                                                                Command="{Binding DataContext.SetAccountAprRatesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                Margin="0,0,0,0" Width="150"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </DockPanel>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

                                    <!-- Index 3: Paychecks View -->
                                    <DataTrigger Binding="{Binding SelectedOuterTabIndex}" Value="3">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Bottom">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                    HorizontalAlignment="Left">
                                                            <Button Content="Delete"
                                                                    Command="{Binding DeletePaycheckCommand}"
                                                                    Width="80" Margin="2" Background="Red"
                                                                    Foreground="White">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding EditingPaycheckClone.Id, Converter={StaticResource IntToVisibilityConverter}}"
                                                                                Value="Collapsed">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger
                                                                                Binding="{Binding IsEditingPaycheck}"
                                                                                Value="False">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                            <Button Content="Add"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding AddPaycheckCommand}" Width="80"
                                                                    Margin="2"
                                                                    Visibility="{Binding IsNotEditingPaycheck, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <Button Content="Edit"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding EditPaycheckCommand}" Width="80"
                                                                    Margin="2">
                                                                <Button.Visibility>
                                                                    <MultiBinding
                                                                        Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                                        <Binding Path="CanEditPaycheck" />
                                                                        <Binding Path="IsNotEditingPaycheck" />
                                                                    </MultiBinding>
                                                                </Button.Visibility>
                                                            </Button>
                                                            <Button Content="Save"
                                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                                    Command="{Binding SavePaycheckCommand}" Width="80"
                                                                    Margin="2"
                                                                    Visibility="{Binding IsEditingPaycheck, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <Button Content="Cancel"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding CancelPaycheckCommand}"
                                                                    Width="80" Margin="2"
                                                                    Visibility="{Binding IsEditingPaycheck, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <DataGrid ItemsSource="{Binding Paychecks}"
                                                                  SelectedItem="{Binding SelectedPaycheck}"
                                                                  IsReadOnly="True" AutoGenerateColumns="False"
                                                                  HorizontalScrollBarVisibility="Auto"
                                                                  CanUserAddRows="False">
                                                            <DataGrid.InputBindings>
                                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                                              Command="{Binding EditPaycheckCommand}" />
                                                            </DataGrid.InputBindings>
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Name"
                                                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                        Width="100" MinWidth="100" />
                                                                <DataGridTextColumn Header="Amount"
                                                                        Binding="{Binding ExpectedAmount, StringFormat=C, UpdateSourceTrigger=PropertyChanged}"
                                                                        Width="80" MinWidth="80" />
                                                                <DataGridTextColumn Header="Frequency"
                                                                        Binding="{Binding Frequency, UpdateSourceTrigger=PropertyChanged}"
                                                                        Width="80" MinWidth="80" />
                                                                <DataGridTextColumn Header="Start Date"
                                                                        HeaderStyle="{StaticResource CenterAlignedHeaderStyle}"
                                                                        Binding="{Binding StartDate, StringFormat='{}{0:MM/dd/yyyy}', UpdateSourceTrigger=PropertyChanged}"
                                                                        Width="90" MinWidth="65">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="TextAlignment"
                                                                                    Value="Center" />
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>
                                                                <DataGridTextColumn Header="End Date"
                                                                        HeaderStyle="{StaticResource CenterAlignedHeaderStyle}"
                                                                        Binding="{Binding EndDate, StringFormat='{}{0:MM/dd/yyyy}', UpdateSourceTrigger=PropertyChanged}"
                                                                        Width="90" MinWidth="65">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="TextAlignment"
                                                                                    Value="Center" />
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>
                                                                <DataGridTemplateColumn Header="Deposit To" Width="120">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <ComboBox
                                                                                ItemsSource="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                DisplayMemberPath="Name"
                                                                                SelectedValuePath="Id"
                                                                                SelectedValue="{Binding AccountId, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <StackPanel Grid.Row="1" Margin="5"
                                                                    Visibility="{Binding IsEditingPaycheck, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="Paycheck Details" FontWeight="Bold"
                                                                       Margin="0,5" />
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Label Grid.Column="0" Grid.Row="0" Content="Name:" />
                                                                <TextBox Grid.Column="1" Grid.Row="0"
                                                                         Text="{Binding EditingPaycheckClone.Name, UpdateSourceTrigger=PropertyChanged}"
                                                                         Margin="5" />
                                                                <Label Grid.Column="2" Grid.Row="0" Content="Amount:" />
                                                                <controls:NumericTextBox Grid.Column="3" Grid.Row="0"
                                                                        Text="{Binding EditingPaycheckClone.ExpectedAmount, UpdateSourceTrigger=PropertyChanged}"
                                                                        Margin="5" />
                                                                <Label Grid.Column="0" Grid.Row="1"
                                                                       Content="Frequency:" />
                                                                <ComboBox Grid.Column="1" Grid.Row="1"
                                                                          ItemsSource="{Binding Source={StaticResource EnumFrequency}}"
                                                                          SelectedItem="{Binding EditingPaycheckClone.Frequency}"
                                                                          Margin="5" />
                                                                <Label Grid.Column="0" Grid.Row="2"
                                                                       Content="Start date:" />
                                                                <DatePicker Grid.Column="1" Grid.Row="2"
                                                                            SelectedDate="{Binding EditingPaycheckClone.StartDate}"
                                                                            Margin="5" />
                                                                <Label Grid.Column="2" Grid.Row="2" Content="End date:" />
                                                                <DatePicker Grid.Column="3" Grid.Row="2"
                                                                            SelectedDate="{Binding EditingPaycheckClone.EndDate}"
                                                                            Margin="5" />
                                                                <Label Grid.Column="0" Grid.Row="3"
                                                                       Content="Deposit To:" />
                                                                <ComboBox Grid.Column="1" Grid.Row="3"
                                                                          ItemsSource="{Binding Accounts}"
                                                                          SelectedValue="{Binding EditingPaycheckClone.AccountId}"
                                                                          SelectedValuePath="Id"
                                                                          DisplayMemberPath="Name" Margin="5" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </DockPanel>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

                                    <!-- Index 4: Bills View -->
                                    <DataTrigger Binding="{Binding SelectedOuterTabIndex}" Value="4">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Bottom">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                    HorizontalAlignment="Left">
                                                            <Button Content="Delete"
                                                                    Command="{Binding DeleteBillCommand}" Margin="5"
                                                                    Width="80" Background="Red" Foreground="White">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding EditingBillClone.Id, Converter={StaticResource IntToVisibilityConverter}}"
                                                                                Value="Collapsed">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger
                                                                                Binding="{Binding IsEditingBill}"
                                                                                Value="False">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                            <Button Content="Add"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding AddBillCommand}" Margin="5"
                                                                    Width="80"
                                                                    Visibility="{Binding IsNotEditingBill, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <Button Content="Edit"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding EditBillCommand}" Margin="5"
                                                                    Width="80">
                                                                <Button.Visibility>
                                                                    <MultiBinding
                                                                        Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                                        <Binding Path="CanEditBill" />
                                                                        <Binding Path="IsNotEditingBill" />
                                                                    </MultiBinding>
                                                                </Button.Visibility>
                                                            </Button>
                                                            <Button Content="Save"
                                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                                    Command="{Binding SaveBillCommand}" Margin="5"
                                                                    Width="80"
                                                                    Visibility="{Binding IsEditingBill, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <Button Content="Cancel"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding CancelBillCommand}" Margin="5"
                                                                    Width="80"
                                                                    Visibility="{Binding IsEditingBill, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <DataGrid Grid.Row="0" ItemsSource="{Binding Bills}"
                                                                  SelectedItem="{Binding SelectedBill}"
                                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                                  IsReadOnly="True">
                                                            <DataGrid.InputBindings>
                                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                                              Command="{Binding EditBillCommand}" />
                                                            </DataGrid.InputBindings>
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Name"
                                                                        Binding="{Binding Name}" Width="*" />
                                                                <DataGridTextColumn Header="Budgeted"
                                                                        Binding="{Binding ExpectedAmount, StringFormat=C}"
                                                                        Width="80" />
                                                                <DataGridTextColumn Header="Due Day"
                                                                        Binding="{Binding DueDay}" Width="60" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <StackPanel Grid.Row="1" Margin="10"
                                                                    Visibility="{Binding IsEditingBill, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="Edit Bill" FontWeight="Bold"
                                                                       Margin="0,0,0,5" />
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <Label Grid.Column="0" Grid.Row="0" Content="Name:" />
                                                                <TextBox Grid.Column="1" Grid.Row="0"
                                                                         Text="{Binding EditingBillClone.Name, UpdateSourceTrigger=PropertyChanged}"
                                                                         Margin="5" />
                                                                <Label Grid.Column="2" Grid.Row="0"
                                                                       Content="Frequency:" />
                                                                <ComboBox Grid.Column="3" Grid.Row="0"
                                                                          ItemsSource="{Binding BillFrequencies}"
                                                                          SelectedItem="{Binding EditingBillClone.Frequency}"
                                                                          Margin="5" />
                                                                <Label Grid.Column="0" Grid.Row="1" Content="Budgeted:" />
                                                                <controls:NumericTextBox Grid.Column="1" Grid.Row="1"
                                                                        Text="{Binding EditingBillClone.ExpectedAmount, UpdateSourceTrigger=PropertyChanged}"
                                                                        Margin="5" />

                                                                <Label Grid.Column="2" Grid.Row="1" Content="Due Day:">
                                                                    <Label.Style>
                                                                        <Style TargetType="Label">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger
                                                                                    Binding="{Binding EditingBillClone.Frequency}"
                                                                                    Value="Monthly">
                                                                                    <Setter Property="Visibility"
                                                                                        Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Label.Style>
                                                                </Label>
                                                                <TextBox Grid.Column="3" Grid.Row="1"
                                                                         Text="{Binding EditingBillClone.DueDay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Margin="5">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger
                                                                                    Binding="{Binding EditingBillClone.Frequency}"
                                                                                    Value="Monthly">
                                                                                    <Setter Property="Visibility"
                                                                                        Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>

                                                                <Label Grid.Column="2" Grid.Row="1"
                                                                       Content="Next Due Date:">
                                                                    <Label.Style>
                                                                        <Style TargetType="Label">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger
                                                                                    Binding="{Binding EditingBillClone.Frequency}"
                                                                                    Value="Yearly">
                                                                                    <Setter Property="Visibility"
                                                                                        Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Label.Style>
                                                                </Label>
                                                                <DatePicker Grid.Column="3" Grid.Row="1"
                                                                            SelectedDate="{Binding EditingBillClone.NextDueDate}"
                                                                            Margin="5">
                                                                    <DatePicker.Style>
                                                                        <Style TargetType="DatePicker">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger
                                                                                    Binding="{Binding EditingBillClone.Frequency}"
                                                                                    Value="Yearly">
                                                                                    <Setter Property="Visibility"
                                                                                        Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </DatePicker.Style>
                                                                </DatePicker>

                                                                <Label Grid.Column="0" Grid.Row="2"
                                                                       Content="Paid From:" />
                                                                <ComboBox Grid.Column="1" Grid.Row="2"
                                                                          ItemsSource="{Binding ActiveAccountsWithNone}"
                                                                          x:Name="BillAccountComboBox"
                                                                          SelectedValue="{Binding EditingBillClone.AccountId}"
                                                                          SelectedValuePath="Id"
                                                                          DisplayMemberPath="Name" Margin="5" />
                                                                <Label Grid.Column="2" Grid.Row="2" Content="Paid To:" />
                                                                <ComboBox Grid.Column="3" Grid.Row="2"
                                                                          ItemsSource="{Binding ActiveAccountsWithNone}"
                                                                          x:Name="BillToAccountComboBox"
                                                                          SelectedValue="{Binding EditingBillClone.ToAccountId}"
                                                                          SelectedValuePath="Id"
                                                                          DisplayMemberPath="Name" Margin="5" />

                                                                <StackPanel Grid.Column="0" Grid.Row="3"
                                                                            Grid.ColumnSpan="4"
                                                                            Orientation="Horizontal" Margin="5">
                                                                    <CheckBox
                                                                        Content="Principal Only (Mortgage/Loan Extra)"
                                                                        IsChecked="{Binding EditingBillClone.IsPrincipalOnly}"
                                                                        VerticalAlignment="Center" Margin="0,0,10,0"
                                                                        Visibility="{Binding SelectedItem, ElementName=BillToAccountComboBox, ConverterParameter='Mortgage|PersonalLoan|HELOC|StudentLoan', Converter={StaticResource AccountTypeToVisibilityConverter}, FallbackValue=Collapsed}" />
                                                                </StackPanel>

                                                                <Label Grid.Column="0" Grid.Row="4"
                                                                       Content="Sub Category:" />
                                                                <ComboBox Grid.Column="1" Grid.Row="4"
                                                                          x:Name="BillSubCategoryComboBox"
                                                                          ItemsSource="{Binding SubCategoriesWithNone}"
                                                                          SelectedValue="{Binding EditingBillClone.SubCategoryId}"
                                                                          SelectedValuePath="Id"
                                                                          DisplayMemberPath="Name" Margin="5" />
                                                                <Label Grid.Column="2" Grid.Row="4" Content="Envelope:" />
                                                                <ComboBox Grid.Column="3" Grid.Row="4"
                                                                          x:Name="BillBucketComboBox"
                                                                          ItemsSource="{Binding BucketsWithNone}"
                                                                          SelectedValue="{Binding EditingBillClone.BucketId}"
                                                                          SelectedValuePath="Id"
                                                                          DisplayMemberPath="Name" Margin="5" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </DockPanel>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

                                    <!-- Index 5: Envelopes View -->
                                    <DataTrigger Binding="{Binding SelectedOuterTabIndex}" Value="5">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Bottom">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                    HorizontalAlignment="Left">
                                                            <Button Content="Delete"
                                                                    Command="{Binding DeleteBucketCommand}" Margin="5"
                                                                    Width="80" Background="Red" Foreground="White">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding EditingBucketClone.Id, Converter={StaticResource IntToVisibilityConverter}}"
                                                                                Value="Collapsed">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger
                                                                                Binding="{Binding IsEditingBucket}"
                                                                                Value="False">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                            <Button Content="Add"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding AddBucketCommand}" Margin="5"
                                                                    Width="80"
                                                                    Visibility="{Binding IsNotEditingBucket, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <Button Content="Edit"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding EditBucketCommand}" Margin="5"
                                                                    Width="80">
                                                                <Button.Visibility>
                                                                    <MultiBinding
                                                                        Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                                        <Binding Path="CanEditBucket" />
                                                                        <Binding Path="IsNotEditingBucket" />
                                                                    </MultiBinding>
                                                                </Button.Visibility>
                                                            </Button>
                                                            <Button Content="Save"
                                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                                    Command="{Binding SaveBucketCommand}" Margin="5"
                                                                    Width="80"
                                                                    Visibility="{Binding IsEditingBucket, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <Button Content="Cancel"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding CancelBucketCommand}" Margin="5"
                                                                    Width="80"
                                                                    Visibility="{Binding IsEditingBucket, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <DataGrid Grid.Row="0" ItemsSource="{Binding Buckets}"
                                                                  SelectedItem="{Binding SelectedBucket}"
                                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                                  IsReadOnly="True">
                                                            <DataGrid.InputBindings>
                                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                                              Command="{Binding EditBucketCommand}" />
                                                            </DataGrid.InputBindings>
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Name"
                                                                        Binding="{Binding Name}" Width="*" />
                                                                <DataGridTextColumn Header="Type"
                                                                        Binding="{Binding Type}" Width="140" />
                                                                <DataGridTextColumn Header="Target Cadence"
                                                                        Binding="{Binding TargetFrequency}" Width="120" />
                                                                <DataGridTextColumn Header="Target Amount"
                                                                        Binding="{Binding TargetAmount, StringFormat=C}"
                                                                        Width="110" />
                                                                <DataGridTextColumn Header="Target Floor"
                                                                        Binding="{Binding TargetBalance, StringFormat=C}"
                                                                        Width="100" />
                                                                <DataGridTextColumn Header="Current Balance"
                                                                        Binding="{Binding CurrentBalance, StringFormat=C}"
                                                                        Width="110" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>

                                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                                      MaxHeight="450">
                                                            <StackPanel Margin="10"
                                                                        Visibility="{Binding IsEditingBucket, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="Edit Envelope Configuration"
                                                                           FontWeight="Bold" Margin="0,0,0,5" />
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Label Grid.Column="0" Content="Name:"
                                                                           VerticalAlignment="Center" />
                                                                    <TextBox Grid.Column="1"
                                                                             Text="{Binding EditingBucketClone.Name, UpdateSourceTrigger=PropertyChanged}"
                                                                             Margin="5" VerticalAlignment="Center" />
                                                                    <Label Grid.Column="2" Content="Envelope Type:"
                                                                           VerticalAlignment="Center" />
                                                                    <ComboBox Grid.Column="3"
                                                                              ItemsSource="{Binding BucketTypes}"
                                                                              SelectedItem="{Binding EditingBucketClone.Type, UpdateSourceTrigger=PropertyChanged}"
                                                                              Margin="5" VerticalAlignment="Center" />
                                                                    <Label Grid.Column="4" Content="Paid From:"
                                                                           VerticalAlignment="Center" />
                                                                    <ComboBox Grid.Column="5"
                                                                              ItemsSource="{Binding ActiveAccountsWithNone}"
                                                                              SelectedValue="{Binding EditingBucketClone.AccountId}"
                                                                              SelectedValuePath="Id"
                                                                              DisplayMemberPath="Name" Margin="5"
                                                                              VerticalAlignment="Center" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </DockPanel>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

                                    <!-- Index 6: Categories View -->
                                    <DataTrigger Binding="{Binding SelectedOuterTabIndex}" Value="6">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="5" />
                                                        <ColumnDefinition Width="1.5*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Left Categories -->
                                                    <DockPanel Grid.Column="0" Margin="5">
                                                        <Grid DockPanel.Dock="Bottom">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Content="Delete"
                                                                    Command="{Binding DeleteCategoryCommand}"
                                                                    Margin="2,5" Width="70" Background="Red"
                                                                    Foreground="White">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding EditingCategoryClone.Id, Converter={StaticResource IntToVisibilityConverter}}"
                                                                                Value="Collapsed">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger
                                                                                Binding="{Binding IsEditingCategory}"
                                                                                Value="False">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                        HorizontalAlignment="Right">
                                                                <Button Content="Add"
                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                        Command="{Binding AddCategoryCommand}"
                                                                        Margin="2,5" Width="60"
                                                                        Visibility="{Binding IsNotEditingCategory, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <Button Content="Edit"
                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                        Command="{Binding EditCategoryCommand}"
                                                                        Margin="2,5" Width="60">
                                                                    <Button.Visibility>
                                                                        <MultiBinding
                                                                            Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                                            <Binding Path="CanEditCategory" />
                                                                            <Binding Path="IsNotEditingCategory" />
                                                                        </MultiBinding>
                                                                    </Button.Visibility>
                                                                </Button>
                                                                <Button Content="Save"
                                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                                        Command="{Binding SaveCategoryCommand}"
                                                                        Margin="2,5" Width="60"
                                                                        Visibility="{Binding IsEditingCategory, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <Button Content="Cancel"
                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                        Command="{Binding CancelCategoryCommand}"
                                                                        Margin="2,5" Width="60"
                                                                        Visibility="{Binding IsEditingCategory, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <DataGrid ItemsSource="{Binding Categories}"
                                                                  SelectedItem="{Binding SelectedCategory}"
                                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                                  IsReadOnly="True">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Category"
                                                                        Binding="{Binding Name}" Width="*" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </DockPanel>

                                                    <GridSplitter Grid.Column="1" Width="5"
                                                                  HorizontalAlignment="Stretch"
                                                                  Style="{StaticResource ModernGridSplitterStyle}" />

                                                    <!-- Right Subcategories -->
                                                    <DockPanel Grid.Column="2" Margin="5">
                                                        <DataGrid ItemsSource="{Binding SubCategories}"
                                                                  SelectedItem="{Binding SelectedSubCategory}"
                                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                                  IsReadOnly="True">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Category"
                                                                        Binding="{Binding CategoryName}" Width="120" />
                                                                <DataGridTextColumn Header="Subcategory"
                                                                        Binding="{Binding Name}" Width="*" />
                                                                <!-- <DataGridTextColumn Header="Default Envelope" Binding="{Binding DefaultBucketName}" Width="140" /> -->
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </DockPanel>
                                                </Grid>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <!-- Bill Warning Widget -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8"
                            Margin="0,10,0,0" Padding="12"
                            Visibility="{Binding ShowWarningWidget, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Bill Alerts" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,10" />
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                    <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                                        <Path Data="M3 2v18h2V12h11l1-2-1-2H5V2H3zm4 4h7.5l.5 1-.5 1H7V6z"
                                              Fill="#EF4444" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Text="Past Due" FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}" FontWeight="Medium" />
                                        <TextBlock Text="{Binding PastDueCount}" FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                                        <Path Data="M3 2v18h2V12h11l1-2-1-2H5V2H3zm4 4h7.5l.5 1-.5 1H7V6z"
                                              Fill="#EAB308" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Text="Upcoming" FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}" FontWeight="Medium" />
                                        <TextBlock Text="{Binding UpcomingCount}" FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </UniformGrid>
                            <Separator Background="{DynamicResource BorderColorBrush}" Margin="0,0,0,10" Opacity="0.5" />
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding BudgetBustedBuckets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                                    CornerRadius="6" Margin="0,0,0,6" Padding="8,6">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                                  Command="{Binding DataContext.MapsToBucketCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                </Border.InputBindings>
                                                <DockPanel>
                                                    <TextBlock
                                                        Text="{Binding TransactionAmount, Converter={StaticResource AbsoluteValueConverter}, StringFormat=C}"
                                                        DockPanel.Dock="Right" FontWeight="SemiBold" FontSize="11"
                                                        VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#22C55E" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding BudgetExceeded}"
                                                                            Value="true">
                                                                        <Setter Property="Foreground" Value="#EF4444" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding BucketName}" Foreground="#1E293B"
                                                               FontWeight="Medium" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch"
                          Style="{StaticResource ModernGridSplitterStyle}" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ShowsPreview="True" />

            <!-- Right Panel: Projections -->
            <DockPanel Grid.Column="2" Margin="10,0,0,0">
                <Label DockPanel.Dock="Top"
                       Content="{Binding YearsProjecting, Converter={StaticResource ProjectionYearsLabelConverter}}"
                       Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="4"
                            Padding="6,4" Margin="0,4,0,8" Grid.Row="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Label Content="Start:" Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" Margin="5,0,0,0" />
                                <DatePicker
                                    SelectedDate="{Binding ProjectionStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                    VerticalAlignment="Center" Margin="5,0,0,0" />
                                <Label Content="End:" Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                                <DatePicker DisplayDateStart="{x:Static System:DateTime.Today}"
                                            SelectedDate="{Binding ProjectionEndDate}" VerticalAlignment="Center"
                                            Margin="5,0,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Command="{Binding SetOneYearCommand}" Content="1 yr" Padding="10,4"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Command="{Binding SetFiveYearCommand}" Content="5 yr" Padding="10,4"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="-1,0,0,0" />
                                <Button Command="{Binding SetTenYearCommand}" Content="10 yr" Padding="10,4"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="-1,0,0,0" />
                                <Button Command="{Binding SetThirtyYearCommand}" Content="30 yr" Padding="10,4"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="-1,0,0,0" />
                            </StackPanel>

                            <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                      Content="Pay off credit cards using excess checking each period"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      IsChecked="{Binding UseAutoSweep}" VerticalAlignment="Center" Margin="5,6,5,2" />
                        </Grid>
                    </Border>

                    <TabControl Grid.Row="1" Style="{StaticResource InnerTabControlStyle}"
                                ItemContainerStyle="{StaticResource ModernUnderlineTabItemStyle}"
                                SelectedIndex="{Binding SelectedProjectionTabIndex}">
                        <TabItem Header="Current Plan">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="2*" />
                                </Grid.RowDefinitions>

                                <DataGrid x:Name="ProjectionGrid" Grid.Row="0" ItemsSource="{Binding Projections}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          ScrollViewer.CanContentScroll="True"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="{x:Type DataGridRow}">
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Setter Property="BorderBrush" Value="LightGray" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                                                    <Setter Property="BorderBrush" Value="black" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Posting Date"
                                                            HeaderStyle="{StaticResource CenterAlignedHeaderStyle}"
                                                            Binding="{Binding TransactionDate, StringFormat='{}{0:MM/dd/yyyy}'}"
                                                            IsReadOnly="False" Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTemplateColumn Header="Description" Width="200">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Description}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />

                                                        <TextBlock Grid.Column="1"
                                                                   Visibility="{Binding CanPayIt, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                   Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <Hyperlink
                                                                Command="{Binding DataContext.PayBillCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}">
                                                                Enter Payment
                                                            </Hyperlink>
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="1"
                                                                   Visibility="{Binding CanFundDrawdown, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                   Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <Hyperlink
                                                                Command="{Binding DataContext.FundEnvelopeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}">
                                                                Funds Set Aside
                                                            </Hyperlink>
                                                            or
                                                            <Hyperlink
                                                                Command="{Binding DataContext.SkipFundEnvelopeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}">
                                                                Skip
                                                            </Hyperlink>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Amount"
                                                            HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                            Binding="{Binding Amount, StringFormat=C, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="90" MinWidth="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Right" />
                                                    <Setter Property="Padding" Value="0,0,8,0" />
                                                    <Setter Property="Foreground"
                                                            Value="{Binding Amount, Converter={StaticResource AmountToBrushConverter}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBucket}" Value="True">
                                                            <Setter Property="Foreground" Value="#6C5CE7" />
                                                            <Setter Property="FontStyle" Value="Italic" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSweep}" Value="True">
                                                            <Setter Property="Foreground" Value="Goldenrod" />
                                                            <Setter Property="FontStyle" Value="Italic" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Total Balance"
                                                            HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                            Binding="{Binding Balance, StringFormat=C}" Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Right" />
                                                    <Setter Property="Padding" Value="0,0,8,0" />
                                                    <Setter Property="Foreground"
                                                            Value="{Binding Balance, Converter={StaticResource AmountToBrushConverter}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="Red" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Period Net"
                                                            HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                            Binding="{Binding PeriodNet, StringFormat=C}" Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Right" />
                                                    <Setter Property="Padding" Value="0,0,8,0" />
                                                    <Setter Property="Foreground"
                                                            Value="{Binding Amount, Converter={StaticResource AmountToBrushConverter}}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding PeriodNet, Converter={StaticResource NegativeToRedConverter}}"
                                                            Value="True">
                                                            <Setter Property="Foreground" Value="Red" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <GridSplitter Grid.Row="1" ResizeDirection="Rows" Height="2"
                                              HorizontalAlignment="Stretch"
                                              Style="{StaticResource ModernGridSplitterStyle}"
                                              VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                                              ShowsPreview="True" />

                                <Grid Grid.Row="2" Margin="0,5,0,0">
                                    <local:ProjectionLiveChartControl
                                        Visibility="{Binding IsProjecting, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                        Projections="{Binding Projections}" Accounts="{Binding VisibleAccounts}" />
                                    <StackPanel
                                        Visibility="{Binding IsProjecting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                                        <Viewbox Width="50" Height="50">
                                            <Control>
                                                <Control.Template>
                                                    <ControlTemplate TargetType="Control">
                                                        <Grid RenderTransformOrigin="0.5,0.5">
                                                            <Grid.RenderTransform>
                                                                <RotateTransform x:Name="SpinTransform" Angle="0" />
                                                            </Grid.RenderTransform>
                                                            <Canvas Width="48" Height="48">
                                                                <Path Data="M24,4 A20,20 0 1,1 23.99,4"
                                                                      Stroke="#E2E8F0" StrokeThickness="4"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round" />
                                                                <Path Data="M24,4 A20,20 0 0,1 44,24" Stroke="#3B82F6"
                                                                      StrokeThickness="4" StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round" />
                                                            </Canvas>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsVisible" Value="True">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard x:Name="SpinStory">
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation
                                                                                Storyboard.TargetName="SpinTransform"
                                                                                Storyboard.TargetProperty="Angle"
                                                                                From="0" To="360" Duration="0:0:1" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <StopStoryboard BeginStoryboardName="SpinStory" />
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Control.Template>
                                            </Control>
                                        </Viewbox>
                                        <TextBlock Text="Loading Projections..." Margin="0,10,0,0" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#64748B"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Snowball Debt Planner">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <DockPanel Grid.Column="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="2*" />
                                        </Grid.RowDefinitions>

                                        <DataGrid x:Name="SnowballGrid" Grid.Row="0"
                                                  ItemsSource="{Binding SnowballProjections}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="{x:Type DataGridRow}">
                                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                    <Setter Property="BorderBrush" Value="LightGray" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                            <Setter Property="BorderThickness" Value="0,2,0,0" />
                                                            <Setter Property="BorderBrush" Value="black" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Posting Date"
                                                                    HeaderStyle="{StaticResource CenterAlignedHeaderStyle}"
                                                                    Binding="{Binding TransactionDate, StringFormat='{}{0:MM/dd/yyyy}'}"
                                                                    IsReadOnly="False" Width="90">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Center" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Description"
                                                                    Binding="{Binding Description}" IsReadOnly="True"
                                                                    Width="150" />
                                                <DataGridTextColumn Header="Amount"
                                                                    HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                                    Binding="{Binding Amount, StringFormat=C, UpdateSourceTrigger=PropertyChanged}"
                                                                    Width="90" MinWidth="80">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Right" />
                                                            <Setter Property="Padding" Value="0,0,8,0" />
                                                            <Setter Property="Foreground"
                                                                    Value="{Binding Amount, Converter={StaticResource AmountToBrushConverter}}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBucket}" Value="True">
                                                                    <Setter Property="Foreground" Value="#6C5CE7" />
                                                                    <Setter Property="FontStyle" Value="Italic" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSweep}" Value="True">
                                                                    <Setter Property="Foreground" Value="Goldenrod" />
                                                                    <Setter Property="FontStyle" Value="Italic" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Total Balance"
                                                                    HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                                    Binding="{Binding Balance, StringFormat=C}"
                                                                    Width="90">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Right" />
                                                            <Setter Property="Padding" Value="0,0,8,0" />
                                                            <Setter Property="Foreground"
                                                                    Value="{Binding Balance, Converter={StaticResource AmountToBrushConverter}}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                    <Setter Property="Foreground" Value="Red" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Period Net"
                                                                    HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                                    Binding="{Binding PeriodNet, StringFormat=C}"
                                                                    Width="90">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Right" />
                                                            <Setter Property="Padding" Value="0,0,8,0" />
                                                            <Setter Property="Foreground"
                                                                    Value="{Binding Amount, Converter={StaticResource AmountToBrushConverter}}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Style.Triggers>
                                                                <DataTrigger
                                                                    Binding="{Binding PeriodNet, Converter={StaticResource NegativeToRedConverter}}"
                                                                    Value="True">
                                                                    <Setter Property="Foreground" Value="Red" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <GridSplitter Grid.Row="1" ResizeDirection="Rows" Height="2"
                                                      HorizontalAlignment="Stretch"
                                                      Style="{StaticResource ModernGridSplitterStyle}"
                                                      VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                                                      ShowsPreview="True" />

                                        <Grid Grid.Row="2" Margin="0,5,0,0">
                                            <local:ProjectionLiveChartControl
                                                Visibility="{Binding IsSnowballProjecting, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                Projections="{Binding SnowballProjections}"
                                                Accounts="{Binding VisibleAccounts}" />
                                            <StackPanel
                                                Visibility="{Binding IsSnowballProjecting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Orientation="Vertical">
                                                <Viewbox Width="50" Height="50">
                                                    <Control>
                                                        <Control.Template>
                                                            <ControlTemplate TargetType="Control">
                                                                <Grid RenderTransformOrigin="0.5,0.5">
                                                                    <Grid.RenderTransform>
                                                                        <RotateTransform x:Name="SpinTransform"
                                                                                Angle="0" />
                                                                    </Grid.RenderTransform>
                                                                    <Canvas Width="48" Height="48">
                                                                        <Path Data="M24,4 A20,20 0 1,1 23.99,4"
                                                                              Stroke="#E2E8F0" StrokeThickness="4"
                                                                              StrokeStartLineCap="Round"
                                                                              StrokeEndLineCap="Round" />
                                                                        <Path Data="M24,4 A20,20 0 0,1 44,24"
                                                                              Stroke="#3B82F6" StrokeThickness="4"
                                                                              StrokeStartLineCap="Round"
                                                                              StrokeEndLineCap="Round" />
                                                                    </Canvas>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsVisible" Value="True">
                                                                        <Trigger.EnterActions>
                                                                            <BeginStoryboard x:Name="SpinStory">
                                                                                <Storyboard RepeatBehavior="Forever">
                                                                                    <DoubleAnimation
                                                                                        Storyboard.TargetName="SpinTransform"
                                                                                        Storyboard.TargetProperty="Angle"
                                                                                        From="0" To="360"
                                                                                        Duration="0:0:1" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </Trigger.EnterActions>
                                                                        <Trigger.ExitActions>
                                                                            <StopStoryboard
                                                                                BeginStoryboardName="SpinStory" />
                                                                        </Trigger.ExitActions>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Control.Template>
                                                    </Control>
                                                </Viewbox>
                                                <TextBlock Text="Loading Snowball Projections..." Margin="0,10,0,0"
                                                           FontSize="13" FontWeight="SemiBold" Foreground="#64748B"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </DockPanel>

                                <!-- Column 1: Flap Handle + Collapsible Side Panel -->
                                <Grid Grid.Column="1">
                                    <Border x:Name="OptionsPanelBorder" Width="320" Margin="0" Padding="12,10"
                                            Background="#F9F9F9" BorderBrush="#D0D0D0" BorderThickness="1,0,0,0"
                                            Visibility="{Binding ElementName=OptionsTabBtn, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock Text="Snowball Strategy Options" FontSize="16"
                                                           FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15" />
                                                <CheckBox Content="Enable Snowball Strategy"
                                                          IsChecked="{Binding SnowballOptions.EnableSnowball}"
                                                          Margin="0,0,0,15" FontSize="13" FontWeight="SemiBold" />

                                                <TextBlock Text="Primary Allocation Target" FontWeight="SemiBold"
                                                           Foreground="#64748B" Margin="0,0,0,5" />
                                                <ComboBox
                                                    ItemsSource="{Binding Source={StaticResource EnumSurplusAllocationTarget}}"
                                                    SelectedItem="{Binding SnowballOptions.PrimaryTarget}"
                                                    Margin="0,0,0,15" />

                                                <TextBlock Text="Debt Payoff Strategy" FontWeight="SemiBold"
                                                           Foreground="#64748B" Margin="0,0,0,5" />
                                                <ComboBox
                                                    ItemsSource="{Binding Source={StaticResource EnumSnowballSortStrategy}}"
                                                    SelectedItem="{Binding SnowballOptions.DebtSortStrategy}"
                                                    Margin="0,0,0,15" />

                                                <TextBlock Text="Investment Strategy" FontWeight="SemiBold"
                                                           Foreground="#64748B" Margin="0,0,0,5" />
                                                <ComboBox
                                                    ItemsSource="{Binding Source={StaticResource EnumInvestmentStrategy}}"
                                                    SelectedItem="{Binding SnowballOptions.InvestmentStrategy}"
                                                    Margin="0,0,0,15" />

                                                <Separator Margin="0,5,0,15" Background="#E2E8F0" />

                                                <TextBlock Text="Surplus Calculation Method" FontWeight="SemiBold"
                                                           Foreground="#64748B" Margin="0,0,0,5" />
                                                <ComboBox
                                                    ItemsSource="{Binding Source={StaticResource EnumSurplusCalculationMethod}}"
                                                    SelectedItem="{Binding SnowballOptions.SurplusMethod}"
                                                    Margin="0,0,0,15" />

                                                <StackPanel
                                                    Visibility="{Binding SnowballOptions.SurplusMethod, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=FixedMonthlyAmount}">
                                                    <TextBlock Text="Fixed Monthly Surplus Commitment ($)"
                                                               FontWeight="SemiBold" Foreground="#64748B"
                                                               Margin="0,0,0,5" />
                                                    <TextBox
                                                        Text="{Binding SnowballOptions.FixedMonthlySurplusAmount, StringFormat=C0, UpdateSourceTrigger=PropertyChanged}"
                                                        Margin="0,0,0,15" />
                                                </StackPanel>

                                                <TextBlock Text="Checking Minimum Safety Floor ($)"
                                                           FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5" />
                                                <TextBox
                                                    Text="{Binding SnowballOptions.CheckingSafetyBufferAmount, StringFormat=C0, UpdateSourceTrigger=PropertyChanged}"
                                                    Margin="0,0,0,10" />

                                                <DockPanel Margin="0,0,0,5">
                                                    <TextBlock Text="Checking Cushion %: " FontWeight="SemiBold"
                                                               Foreground="#64748B" />
                                                    <TextBlock
                                                        Text="{Binding SnowballOptions.CheckingSafetyThresholdPct, StringFormat={}{0:P0}}"
                                                        FontWeight="Bold" Foreground="#3B82F6"
                                                        HorizontalAlignment="Right" />
                                                </DockPanel>
                                                <Slider Minimum="0" Maximum="1" TickFrequency="0.05"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding SnowballOptions.CheckingSafetyThresholdPct, Converter={StaticResource DoubleToDecimalConverter}, Delay=300}"
                                                        Margin="0,0,0,5" />

                                                <TextBlock TextWrapping="Wrap"
                                                           Text="Sets the minimum buffer kept in Checking. The remainder is treated as sweepable cash."
                                                           FontSize="11" Foreground="#64748B" Margin="0,0,0,15" />

                                                <DockPanel Margin="0,0,0,5">
                                                    <TextBlock Text="Goal Contribution Rate: " FontWeight="SemiBold"
                                                               Foreground="#64748B" />
                                                    <TextBlock
                                                        Text="{Binding SnowballOptions.SurplusSweepPercentage, StringFormat={}{0:P0}}"
                                                        FontWeight="Bold" Foreground="#3B82F6"
                                                        HorizontalAlignment="Right" />
                                                </DockPanel>
                                                <Slider Minimum="0" Maximum="1" TickFrequency="0.05"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding SnowballOptions.SurplusSweepPercentage, Converter={StaticResource DoubleToDecimalConverter}, Delay=300}"
                                                        Margin="0,0,0,5" />
                                                <TextBlock TextWrapping="Wrap"
                                                           Text="Percentage of extra cash moved toward debt or investments. The remainder is fun money or future extra cash."
                                                           FontSize="11" Foreground="#64748B" Margin="0,0,0,15" />

                                                <Separator Margin="0,5,0,15" Background="#E2E8F0" />

                                                <TextBlock Text="Annual Roth IRA Contribution Limit"
                                                           FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5" />
                                                <TextBox
                                                    Text="{Binding SnowballOptions.AnnualRothIraContributionLimit, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"
                                                    Margin="0,0,0,15" />

                                                <TextBlock Text="Excluded Accounts" FontWeight="SemiBold"
                                                           Foreground="#64748B" Margin="0,0,0,5" />
                                                <Button Content="Manage Excluded Debts / Accounts"
                                                        Command="{Binding OpenManageExcludedAccountsCommand}"
                                                        Margin="0,0,0,15" Padding="8,5" Background="#F1F5F9"
                                                        BorderBrush="#CBD5E1" />

                                                <Border Background="#E8F4FD" BorderBrush="#BEE3F8" BorderThickness="1"
                                                        CornerRadius="6" Padding="12,10" Margin="0,5,0,15"
                                                        Visibility="{Binding ShowSnowballAnalysis, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel>
                                                        <TextBlock Text="Strategy Comparison" FontWeight="Bold"
                                                                   Foreground="#0369A1" Margin="0,0,0,8" />
                                                        <StackPanel
                                                            Visibility="{Binding SnowballDebtFreeDate, Converter={StaticResource NullToVisibilityConverter}}">
                                                            <TextBlock Foreground="#1E293B" FontSize="12">
                                                                <Run Text="Estimated Debt Free: " />
                                                                <Run
                                                                    Text="{Binding SnowballDebtFreeDate, StringFormat={}{0:MMM yyyy}, Mode=OneWay}"
                                                                    FontWeight="Bold" />
                                                            </TextBlock>
                                                            <TextBlock
                                                                Foreground="{Binding SnowballMonthsSaved, Converter={StaticResource DeltaToBrushConverter}}"
                                                                FontSize="11" FontWeight="Bold" Margin="0,2,0,8"
                                                                Visibility="{Binding SnowballMonthsSaved, Converter={StaticResource IntToVisibilityConverter}}">
                                                                <Run Text="(Saves " />
                                                                <Run Text="{Binding SnowballMonthsSaved, Mode=OneWay}" />
                                                                <Run Text=" months vs current plan)" />
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <StackPanel
                                                            Visibility="{Binding SnowballDebtFreeDate, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                                                            <TextBlock Foreground="#1E293B" FontSize="12">
                                                                <Run Text="End of Projection Debt: " />
                                                                <Run
                                                                    Text="{Binding SnowballFinalDebt, StringFormat='{}{0:+$#,##0;-$#,##0;$0}', Mode=OneWay}"
                                                                    FontWeight="Bold" />
                                                            </TextBlock>
                                                            <TextBlock
                                                                Foreground="{Binding SnowballDebtReductionVsStandard, Converter={StaticResource DeltaToBrushConverter}}"
                                                                FontSize="11" FontWeight="Bold" Margin="0,2,0,8"
                                                                Visibility="{Binding SnowballDebtReductionVsStandard, Converter={StaticResource IntToVisibilityConverter}}">
                                                                <Run Text="(" />
                                                                <Run
                                                                    Text="{Binding SnowballDebtReductionVsStandard, StringFormat='{}{0:+$#,##0;-$#,##0;$0}', Mode=OneWay}" />
                                                                <Run Text=" less than current plan)" />
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <TextBlock Foreground="#1E293B" FontSize="12">
                                                            <Run Text="Final Net Worth: " />
                                                            <Run
                                                                Text="{Binding SnowballFinalNetWorth, StringFormat='{}{0:+$#,##0;-$#,##0;$0}', Mode=OneWay}"
                                                                FontWeight="Bold" />
                                                        </TextBlock>
                                                        <TextBlock
                                                            Foreground="{Binding SnowballNetWorthImprovement, Converter={StaticResource DeltaToBrushConverter}}"
                                                            FontSize="11" FontWeight="Bold" Margin="0,2,0,8">
                                                            <Run Text="(" />
                                                            <Run
                                                                Text="{Binding SnowballNetWorthImprovement, StringFormat='{}{0:+$#,##0;-$#,##0;$0}', Mode=OneWay}" />
                                                            <Run Text=" improvement)" />
                                                        </TextBlock>

                                                        <Border BorderBrush="#BAE6FD" BorderThickness="0,1,0,0"
                                                                Margin="0,10,0,0" Padding="0,8,0,0">
                                                            <StackPanel>
                                                                <TextBlock TextWrapping="Wrap" FontSize="11"
                                                                           Foreground="#0C4A6E" FontWeight="SemiBold"
                                                                           LineHeight="16" Margin="0,0,0,6">
                                                                    <Run Text="💡 " />
                                                                    <Run
                                                                        Text="{Binding StrategyTakeawayPrimary, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <TextBlock TextWrapping="Wrap" FontSize="10.5"
                                                                           Foreground="#475569" LineHeight="15"
                                                                           FontStyle="Italic">
                                                                    <Run
                                                                        Text="{Binding StrategyTakeawayDilemma, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock
                                                    Text="Tip: Settings are applied instantly to the projection below."
                                                    FontSize="11" Foreground="#94A3B8" FontStyle="Italic"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                    <ToggleButton x:Name="OptionsTabBtn" IsChecked="True" Width="18" Height="48"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Margin="-18,10,0,0" Padding="0" Background="#F9F9F9"
                                                  BorderBrush="#D0D0D0" BorderThickness="1,1,0,1"
                                                  ToolTip="Toggle Snowball Options">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4,0,0,4" SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Content" Value="▶" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="False">
                                                        <Setter Property="Content" Value="◀" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E5E5E5" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- OVERLAY MODAL: Manage Excluded Debts & Accounts -->
        <Grid Visibility="{Binding IsManageExclusionsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Grid.Row="0" Grid.Column="0" Grid.RowSpan="99" Grid.ColumnSpan="99" Panel.ZIndex="1000">

            <Border Background="#80000000" MouseDown="CloseOverlayOnBackdropClick" />

            <Border Width="420" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ModalBackgroundBrush}" CornerRadius="8" Padding="20"
                    BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25" Color="Black" />
                </Border.Effect>

                <Grid RowDefinitions="Auto, *, Auto">
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Manage Excluded Accounts" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            Text="Checked accounts will be skipped by the Snowball/Avalanche engine during surplus sweeps."
                            FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                            Margin="0,4,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                        <ItemsControl ItemsSource="{Binding ExcludableAccounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="0,0,0,6"
                                            Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="6"
                                            BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1">
                                        <DockPanel LastChildFill="True">
                                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      IsChecked="{Binding IsExcludedInSnowball, Mode=TwoWay}"
                                                      Command="{Binding DataContext.ToggleAccountExclusionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding Id}" />

                                            <Border DockPanel.Dock="Right" Background="#E2E8F0" CornerRadius="4"
                                                    Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="#475569" />
                                            </Border>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" />
                                                <TextBlock FontSize="11"
                                                           Foreground="{StaticResource SecondaryTextBrush}">
                                                    <Run Text="Balance: " />
                                                    <Run Text="{Binding Balance, StringFormat=C0}" FontWeight="Bold" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- <Button Content="Done" Command="{Binding CloseManageExcludedAccountsCommand}" Width="90" Height="32" Foreground="White" FontWeight="SemiBold" Cursor="Hand"> -->
                        <!--     <Button.Template> -->
                        <!--         <ControlTemplate TargetType="Button"> -->
                        <!--             <Border Background="#2563EB" CornerRadius="5"> -->
                        <!--                 <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /> -->
                        <!--             </Border> -->
                        <!--         </ControlTemplate> -->
                        <!--     </Button.Template> -->
                        <!-- </Button> -->
                        <Button Content="Done"
                                Command="{Binding CloseManageExcludedAccountsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="90"
                                Height="32" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>