                                                                            <DataTrigger
                                                                                Binding="{Binding EditingBucketClone.Id, Converter={StaticResource IntToVisibilityConverter}}"
                                                                                Value="Collapsed">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger
                                                                                Binding="{Binding IsEditingBucket}"
                                                                                Value="False">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </StackPanel>
