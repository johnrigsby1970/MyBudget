                                                                            <Hyperlink
                                                                                Command="{Binding ToggleBucketDescriptionCommand}">
                                                                                Read more...
                                                                            </Hyperlink>
                                                                        </TextBlock>
                                                                        <TextBlock Margin="5" TextWrapping="Wrap"
                                                                                Visibility="{Binding IsBucketDescriptionExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            Amounts set here apply only for this period.
                                                                            <Hyperlink
                                                                                Command="{Binding ToggleBucketDescriptionCommand}">
                                                                                Read less
                                                                            </Hyperlink>
                                                                        </TextBlock>
                                                                    </StackPanel>

                                                                    <DataGrid Grid.Row="1"
                                                                              ItemsSource="{Binding CurrentPeriodBuckets}"
                                                                              SelectedItem="{Binding SelectedPeriodBucket}"
                                                                              AutoGenerateColumns="False"
                                                                              CanUserAddRows="False">
                                                                        <DataGrid.RowStyle>
                                                                            <Style TargetType="{x:Type DataGridRow}"
                                                                                    BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding IsFunded}"
                                                                                        Value="True">
                                                                                        <Setter Property="Background"
                                                                                            Value="#E6F4EA" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding IsSkipped}"
                                                                                        Value="True">
                                                                                        <Setter Property="Background"
                                                                                            Value="#F1F3F4" />
                                                                                        <Setter Property="Foreground"
                                                                                            Value="#70757A" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding HasActualAmount}"
                                                                                        Value="True">
                                                                                        <Setter Property="Background"
                                                                                            Value="#CCFFCC" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding BudgetExceeded}"
                                                                                        Value="True">
                                                                                        <Setter Property="Background"
                                                                                            Value="#FFCCCC" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </DataGrid.RowStyle>
                                                                        <DataGrid.InputBindings>
                                                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                                                    Command="{Binding EditPeriodBucketCommand}" />
                                                                        </DataGrid.InputBindings>
                                                                        <DataGrid.Columns>
                                                                            <DataGridTemplateColumn Header="Envelope"
                                                                                    Width="*">
                                                                                <DataGridTemplateColumn.CellTemplate>
                                                                                    <DataTemplate>
                                                                                        <StackPanel
                                                                                            Orientation="Horizontal"
                                                                                            VerticalAlignment="Center"
                                                                                            Margin="4,0">
