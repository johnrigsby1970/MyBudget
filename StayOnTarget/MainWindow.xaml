                                                  ItemsSource="{Binding PaychecksWithNone}"
                                                  SelectedValue="{Binding EditingBucketClone.PaycheckId}"
                                                  SelectedValuePath="Id" DisplayMemberPath="Name" Margin="5" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Bills">
