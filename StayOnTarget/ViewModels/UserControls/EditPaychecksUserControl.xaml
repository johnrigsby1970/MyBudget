<UserControl x:Class="StayOnTarget.ViewModels.UserControls.EditPaychecksUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:StayOnTarget"
             xmlns:controls="clr-namespace:StayOnTarget.Controls"
             xmlns:converters="clr-namespace:StayOnTarget.Converters"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="680">

    <!-- <UserControl.Resources> -->
    <!--     <converters:AbsoluteValueConverter x:Key="AbsoluteValueConverter" /> -->
    <!--     <converters:VisibleForMortgageTypeConverter x:Key="VisibleForMortgageTypeConverter" /> -->
    <!--     <converters:PaycheckFieldVisibilityConverter x:Key="PaycheckFieldVisibilityConverter" /> -->
    <!--     <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" /> -->
    <!--     <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" /> -->
    <!-- </UserControl.Resources> -->

    <!-- Semi-transparent Dimmed Backdrop Overlay -->
    <Grid Background="#99000000">
        <!-- Centered Floating Dialog Card -->
        <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Width="780"
                Height="650" 
                Margin="20"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.4" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 0: Header -->
                    <RowDefinition Height="*" />    <!-- 1: Active Form (Takes remaining space) -->
                    <RowDefinition Height="Auto" /> <!-- 2: Staged Batch List (Capped Height) -->
                    <RowDefinition Height="Auto" /> <!-- 3: Footer Actions -->
                </Grid.RowDefinitions>

                <!-- 0: HEADER -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Edit Paychecks"
                               Style="{DynamicResource StyledTextBlock}"
                               FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StagedPaychecks.Count, StringFormat='Pending items: {0}', FallbackValue='Pending items: 0'}"
                                   Style="{DynamicResource StyledSecondaryTextBlock}"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,10,0" />
                        <Button Content="✕"
                                Command="{Binding CancelPaycheckCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Width="26" Height="26" Padding="0"
                                FontWeight="Bold" ToolTip="Close overlay" />
                    </StackPanel>
                </DockPanel>

                <!-- FORM CONTENT (Scrollable for smaller screens) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
               <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0" Grid.Row="0" Content="Name:" />
                                                                <TextBox Grid.Column="1" Grid.Row="0"
                                                                         x:Name="NameTextBox"
                                                                         Text="{Binding EditingPaycheckClone.Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                                         Margin="5" />
                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="2" Grid.Row="0"
                                                                       Content="Amount:" />
                                                                <controls:NumericTextBox Grid.Column="3"
                                                                        Grid.Row="0"
                                                                        Text="{Binding EditingPaycheckClone.ExpectedAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                                        Margin="5" />
                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0" Grid.Row="1"
                                                                       Content="Frequency:" />
                                                                <ComboBox Grid.Column="1" Grid.Row="1"
                                                                          Style="{DynamicResource    StyledEnumComboBox}"
                                                                          ItemsSource="{Binding Source={StaticResource EnumFrequency}}"
                                                                          SelectedItem="{Binding EditingPaycheckClone.Frequency}"
                                                                          Margin="5" />
                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0" Grid.Row="2"
                                                                       Content="Start date:" />
                                                                <DatePicker Grid.Column="1" Grid.Row="2"
                                                                            SelectedDate="{Binding EditingPaycheckClone.StartDate}"
                                                                            Margin="5" />
                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="2" Grid.Row="2"
                                                                       Content="End date:" />
                                                                <DatePicker Grid.Column="3" Grid.Row="2"
                                                                            SelectedDate="{Binding EditingPaycheckClone.EndDate}"
                                                                            Margin="5" />
                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0" Grid.Row="3"
                                                                       Content="Deposit To:" />
                                                                <ComboBox Grid.Column="1" Grid.Row="3"
                                                                          ItemsSource="{Binding Accounts}"
                                                                          SelectedValue="{Binding EditingPaycheckClone.AccountId}"
                                                                          SelectedValuePath="Id"
                                                                          DisplayMemberPath="Name" Margin="5" />
                                                            </Grid>
                </ScrollViewer>

                <!-- PENDING BATCH STAGING LIST (Visible only when StagedTransactions has items) -->
                <Border Grid.Row="2" Grid.Column="0" 
                        Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderColorBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Margin="0,0,0,15" Padding="8"
                        Visibility="{Binding StagedPaychecks.Count, Converter={StaticResource IntToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Staged for Save:"
                                   Style="{DynamicResource StyledSecondaryTextBlock}"
                                   FontWeight="Bold" FontSize="11" Margin="0,0,0,4" />

                        <TextBlock Grid.Row="0" Text="Staged for Save:" 
                                   Style="{DynamicResource StyledSecondaryTextBlock}" 
                                   FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding StagedPaychecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button Content="✕" 
                                                    Command="{Binding DataContext.RemoveStagedPaycheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource DangerButtonStyle}"
                                                    Width="18" Height="18" Padding="0" Margin="0,0,8,0"
                                                    ToolTip="Remove from batch" />

                                            <TextBlock Text="{Binding Amount, StringFormat=C}" DockPanel.Dock="Right" FontWeight="Bold" Style="{DynamicResource StyledTextBlock}"/>
                                            <TextBlock Text="{Binding Description}" Style="{DynamicResource StyledTextBlock}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <!-- FOOTER ACTIONS -->
                <Grid Grid.Row="3" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0"
                            Content="Clear Form"
                            Command="{Binding ClearCurrentDraftCommand}"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Width="90" />

                    <!-- Batch Controls (Right side) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Add Another"
                                Command="{Binding AddAnotherPaycheckCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Width="100" Margin="4,0" />

                        <Button Command="{Binding SavePaycheckCommand}"
                                IsEnabled="{Binding CanSavePaycheck}"
                                MinWidth="100" Padding="12,6"
                                Margin="4,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <!-- Bind to the integer value -->
                                    <Setter Property="Content" Value="{Binding TotalPaycheckItemsToSaveCount}" />
                                    <!-- Default template for multiple staged items -->
                                    <Setter Property="ContentStringFormat" Value="Save All ({0})" />
                                    <Style.Triggers>
                                        <!-- Hide count when saving only 1 item (active draft or 1 staged item) -->
                                        <DataTrigger Binding="{Binding TotalPaycheckItemsToSaveCount}" Value="1">
                                            <Setter Property="Content" Value="Save" />
                                            <Setter Property="ContentStringFormat" Value="{x:Null}" />
                                        </DataTrigger>
                                        <!-- Default label when 0 -->
                                        <DataTrigger Binding="{Binding TotalPaycheckItemsToSaveCount}" Value="0">
                                            <Setter Property="Content" Value="Save" />
                                            <Setter Property="ContentStringFormat" Value="{x:Null}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Cancel"
                                Command="{Binding CancelPaycheckCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Width="80" Margin="4,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>