<UserControl x:Class="StayOnTarget.ViewModels.UserControls.EditCategoriesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:StayOnTarget.Controls"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="780">

    <Grid Background="#99000000">
        <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Width="780"
                Height="650"
                Margin="20"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.4" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Header -->
                    <RowDefinition Height="*" />    <!-- Form Content -->
                    <RowDefinition Height="Auto" /> <!-- Batch Staged Items -->
                    <RowDefinition Height="Auto" /> <!-- Footer Actions -->
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Edit Categories &amp; Subcategories"
                               Style="{DynamicResource StyledTextBlock}"
                               FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding StagedCategories.Count, StringFormat='Pending items: {0}', FallbackValue='Pending items: 0'}"
                                   Style="{DynamicResource StyledSecondaryTextBlock}"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,10,0" />
                        <Button Content="✕"
                                Command="{Binding CancelCategoryCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Width="26" Height="26" Padding="0"
                                FontWeight="Bold" ToolTip="Close overlay" />
                    </StackPanel>
                </DockPanel>

                <!-- FORM CONTENT -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <!-- Category Section -->
                        <TextBlock Text="Category Details" Style="{DynamicResource StyledTextBlock}" FontWeight="Bold" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Style="{DynamicResource StyledLabel}" Grid.Column="0" Content="Category Name:" />
                            <TextBox Grid.Column="1" x:Name="NameTextBox"
                                     Text="{Binding EditingCategoryClone.Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Margin="2" />

                            <Label Style="{DynamicResource StyledLabel}" Grid.Column="2" Content="Sort Order:" />
                            <controls:NumericTextBox Grid.Column="3"
                                                     Text="{Binding EditingCategoryClone.SortOrder, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                     Margin="2" />
                        </Grid>

                        <Separator Background="{DynamicResource BorderColorBrush}" Margin="0,10" />

                        <!-- Subcategory Section -->
                        <TextBlock Text="Subcategory Details" Style="{DynamicResource StyledTextBlock}" FontWeight="Bold" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Style="{DynamicResource StyledLabel}" Grid.Row="0" Grid.Column="0" Content="Parent Category:" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding AvailableParentCategories}"
                                      SelectedValue="{Binding EditingSubCategoryClone.CategoryId}"
                                      SelectedValuePath="Id" 
                                      DisplayMemberPath="Name" 
                                      Margin="2" />

                            <Label Style="{DynamicResource StyledLabel}" Grid.Row="0" Grid.Column="2" Content="Subcategory Name:" />
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding EditingSubCategoryClone.Name, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="2" />

                            <Label Style="{DynamicResource StyledLabel}" Grid.Row="1" Grid.Column="0" Content="Default Envelope:" />
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{Binding BucketsWithNone}"
                                      SelectedValue="{Binding EditingSubCategoryClone.DefaultBucketId}"
                                      SelectedValuePath="Id" DisplayMemberPath="Name" Margin="2" />

                            <Label Style="{DynamicResource StyledLabel}" Grid.Row="1" Grid.Column="2" Content="Sort Order:" />
                            <controls:NumericTextBox Grid.Row="1" Grid.Column="3"
                                                     Text="{Binding EditingSubCategoryClone.SortOrder, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="2" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- BATCH STAGING -->
<Border Grid.Row="2" Background="{DynamicResource WindowBackgroundBrush}"
        BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="6"
        Margin="0,0,0,15" Padding="8"
        Visibility="{Binding HasStagedCategoryItems, Converter={StaticResource BooleanToVisibilityConverter}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <TextBlock Text="Staged Items for Save:" Style="{DynamicResource StyledSecondaryTextBlock}"
                   FontWeight="Bold" FontSize="11" Margin="0,0,0,4" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="120">
            <StackPanel>
                <!-- Staged Categories -->
                <ItemsControl ItemsSource="{Binding StagedCategories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Button Content="✕"
                                        Command="{Binding DataContext.RemoveStagedCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{DynamicResource DangerButtonStyle}"
                                        Width="18" Height="18" Padding="0" Margin="0,0,8,0"
                                        ToolTip="Remove category from batch" />
                                <TextBlock Text="{Binding Name, StringFormat='Category: {0}'}" 
                                           Style="{DynamicResource StyledTextBlock}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Staged Subcategories -->
                <ItemsControl ItemsSource="{Binding StagedSubCategories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Button Content="✕"
                                        Command="{Binding DataContext.RemoveStagedSubCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{DynamicResource DangerButtonStyle}"
                                        Width="18" Height="18" Padding="0" Margin="0,0,8,0"
                                        ToolTip="Remove subcategory from batch" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Subcategory: " Style="{DynamicResource StyledSecondaryTextBlock}" FontSize="12" />
                                    <TextBlock Text="{Binding Name}" Style="{DynamicResource StyledTextBlock}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CategoryName, StringFormat='  (Parent: {0})'}" 
                                               Style="{DynamicResource StyledSecondaryTextBlock}" 
                                               FontStyle="Italic" 
                                               FontSize="11" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Border>

                <!-- FOOTER ACTIONS -->
                <Grid Grid.Row="3" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Clear Form" Command="{Binding ClearCurrentCategoryDraftCommand}"
                            Style="{DynamicResource SecondaryButtonStyle}" Width="90" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Add Another" Command="{Binding AddAnotherCategoryCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}" Width="100" Margin="4,0" />

                        <Button Command="{Binding SaveCategoryCommand}" IsEnabled="{Binding CanSaveCategory}"
                                MinWidth="100" Padding="12,6" Margin="4,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Content" Value="{Binding TotalCategoryItemsToSaveCount}" />
                                    <Setter Property="ContentStringFormat" Value="Save All ({0})" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TotalCategoryItemsToSaveCount}" Value="1">
                                            <Setter Property="Content" Value="Save" />
                                            <Setter Property="ContentStringFormat" Value="{x:Null}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TotalCategoryItemsToSaveCount}" Value="0">
                                            <Setter Property="Content" Value="Save" />
                                            <Setter Property="ContentStringFormat" Value="{x:Null}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Cancel" Command="{Binding CancelCategoryCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}" Width="80" Margin="4,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>