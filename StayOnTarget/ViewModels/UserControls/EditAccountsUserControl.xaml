<UserControl x:Class="StayOnTarget.ViewModels.UserControls.EditAccountsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:StayOnTarget"
             xmlns:controls="clr-namespace:StayOnTarget.Controls"
             xmlns:converters="clr-namespace:StayOnTarget.Converters"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="680">

    <!-- <UserControl.Resources> -->
    <!--     <converters:AbsoluteValueConverter x:Key="AbsoluteValueConverter" /> -->
    <!--     <converters:VisibleForMortgageTypeConverter x:Key="VisibleForMortgageTypeConverter" /> -->
    <!--     <converters:PaycheckFieldVisibilityConverter x:Key="PaycheckFieldVisibilityConverter" /> -->
    <!--     <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" /> -->
    <!--     <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" /> -->
    <!-- </UserControl.Resources> -->

    <!-- Semi-transparent Dimmed Backdrop Overlay -->
    <Grid Background="#99000000">
        <!-- Centered Floating Dialog Card -->
        <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Width="780"
                Height="650" 
                Margin="20"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.4" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 0: Header -->
                    <RowDefinition Height="*" />    <!-- 1: Active Form (Takes remaining space) -->
                    <RowDefinition Height="Auto" /> <!-- 2: Staged Batch List (Capped Height) -->
                    <RowDefinition Height="Auto" /> <!-- 3: Footer Actions -->
                </Grid.RowDefinitions>

                <!-- 0: HEADER -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Edit Accounts"
                               Style="{DynamicResource StyledTextBlock}"
                               FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StagedAccounts.Count, StringFormat='Pending items: {0}', FallbackValue='Pending items: 0'}"
                                   Style="{DynamicResource StyledSecondaryTextBlock}"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,10,0" />
                        <Button Content="✕"
                                Command="{Binding CancelAccountCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Width="26" Height="26" Padding="0"
                                FontWeight="Bold" ToolTip="Close overlay" />
                    </StackPanel>
                </DockPanel>

                <!-- FORM CONTENT (Scrollable for smaller screens) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
           <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <Label Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0" Grid.Row="0" Content="Name:" />
                                                                <TextBox
                                                                    Grid.Column="1"
                                                                    Grid.Row="0"
                                                                    x:Name="NameTextBox"
                                                                    Text="{Binding EditingAccountClone.Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                                    Margin="5" />
                                                                <CheckBox
                                                                    Grid.Column="2"
                                                                    Grid.Row="0"
                                                                    Content="Include In Total"
                                                                    IsChecked="{Binding EditingAccountClone.IncludeInTotal}"
                                                                    VerticalAlignment="Center"
                                                                    Margin="5" />

                                                                <Label Content="Bank:"
                                                                       Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0"
                                                                       Grid.Row="1" />
                                                                <TextBox
                                                                    Grid.Column="1"
                                                                    Grid.Row="1"
                                                                    Text="{Binding EditingAccountClone.BankName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                                    Margin="5" />

                                                                <Label Content="Type:"
                                                                       Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="2"
                                                                       Grid.Row="1" />
                                                                <StackPanel
                                                                    Grid.Column="3"
                                                                    Grid.Row="1"
                                                                    Orientation="Horizontal">
                                                                    <ComboBox ItemsSource="{Binding AccountTypes}"
                                                                              Style="{DynamicResource    StyledEnumComboBox}"
                                                                              SelectedItem="{Binding EditingAccountClone.Type}"
                                                                              Margin="5" />
                                                                    <CheckBox Content="Primary"
                                                                              Foreground="{DynamicResource SecondaryTextBrush}"
                                                                              IsChecked="{Binding EditingAccountClone.IsPrimary}"
                                                                              VerticalAlignment="Center"
                                                                              Margin="0,0,10,0"
                                                                              Visibility="{Binding EditingAccountClone.Type, ConverterParameter='Checking|Savings', Converter={StaticResource AccountTypeToVisibilityConverter}, FallbackValue=Collapsed}" />
                                                                </StackPanel>

                                                                <Label Content="Balance:"
                                                                       Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0"
                                                                       Grid.Row="2" />
                                                                <TextBox Grid.Column="1" Grid.Row="2"
                                                                         Text="{Binding EditingAccountClone.Balance, UpdateSourceTrigger=PropertyChanged, StringFormat=F2, ValidatesOnNotifyDataErrors=True}"
                                                                         Margin="5" />
                                                                <Label Content="As Of:"
                                                                       Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="2"
                                                                       Grid.Row="2" />
                                                                <DatePicker
                                                                    Grid.Column="3"
                                                                    Grid.Row="2"
                                                                    SelectedDate="{Binding EditingAccountClone.BalanceAsOf}"
                                                                    Margin="5" />

                                                                <Label Content="Growth %:"
                                                                       Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="0"
                                                                       Grid.Row="3" />
                                                                <TextBox
                                                                    Grid.Column="1"
                                                                    Grid.Row="3"
                                                                    Text="{Binding EditingAccountClone.AnnualGrowthRate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                                    Margin="5" />
                                                                <Label Content="Color (Hex):"
                                                                       Style="{DynamicResource    StyledLabel}"
                                                                       Grid.Column="2"
                                                                       Grid.Row="3" />
                                                                <TextBox Grid.Column="3" Grid.Row="3"
                                                                         Text="{Binding EditingAccountClone.HexColor, UpdateSourceTrigger=PropertyChanged}"
                                                                         Margin="5" />

                                                                <!-- Mortgage Details -->
                                                                <StackPanel Grid.Column="0" Grid.Row="4"
                                                                            Grid.ColumnSpan="4" Orientation="Vertical"
                                                                            Visibility="{Binding EditingAccountClone.Type, ConverterParameter=Mortgage, Converter={StaticResource AccountTypeToVisibilityConverter}, ValidatesOnNotifyDataErrors=True}">
                                                                    <TextBlock
                                                                        Style="{DynamicResource    StyledTextBlock}"
                                                                        Text="Mortgage Details" FontSize="12"
                                                                        FontWeight="Bold" Margin="0,5,0,5" />
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Label
                                                                            Style="{DynamicResource    StyledLabel}"
                                                                            Grid.Row="0" Grid.Column="0"
                                                                            Content="Rate %:" />
                                                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                                                Text="{Binding EditingAccountClone.MortgageDetails.InterestRate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                                                Margin="5" />
                                                                        <Label
                                                                            Style="{DynamicResource    StyledLabel}"
                                                                            Grid.Row="0" Grid.Column="2"
                                                                            Content="Escrow:" />
                                                                        <TextBox Grid.Row="0" Grid.Column="3"
                                                                                Text="{Binding EditingAccountClone.MortgageDetails.Escrow, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                                                Margin="5" />
                                                                        <Label Content="Insurance:"
                                                                               Style="{DynamicResource    StyledLabel}"
                                                                               Grid.Row="1"
                                                                               Grid.Column="0" />
                                                                        <TextBox
                                                                            Grid.Row="1"
                                                                            Grid.Column="1"
                                                                            Text="{Binding EditingAccountClone.MortgageDetails.MortgageInsurance, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                                            Margin="5" />
                                                                        <Label Content="Payment:"
                                                                               Style="{DynamicResource    StyledLabel}"
                                                                               Grid.Row="2"
                                                                               Grid.Column="0" />
                                                                        <TextBox
                                                                            Grid.Row="2"
                                                                            Grid.Column="1"
                                                                            Text="{Binding EditingAccountClone.MortgageDetails.LoanPayment, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                                            Margin="5" />
                                                                        <Label Content="Statement date:"
                                                                               Style="{DynamicResource    StyledLabel}"
                                                                               Grid.Row="2"
                                                                               Grid.Column="2" />
                                                                        <DatePicker
                                                                            Grid.Row="2"
                                                                            Grid.Column="3"
                                                                            SelectedDate="{Binding EditingAccountClone.MortgageDetails.PaymentDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                                            MinWidth="90"
                                                                            Margin="5" />
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Credit Card Details -->
                                                                <StackPanel
                                                                    Grid.Column="0"
                                                                    Grid.Row="4"
                                                                    Grid.ColumnSpan="4"
                                                                    Orientation="Vertical"
                                                                    Visibility="{Binding EditingAccountClone.Type, ConverterParameter=CreditCard, Converter={StaticResource AccountTypeToVisibilityConverter}, ValidatesOnNotifyDataErrors=True}">
                                                                    <TextBlock Text="Credit Card Details"
                                                                               Style="{DynamicResource    StyledTextBlock}"
                                                                               FontSize="12"
                                                                               FontWeight="Bold"
                                                                               Margin="0,5,0,5" />
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Label
                                                                            Style="{DynamicResource    StyledLabel}"
                                                                            Grid.Row="0" Grid.Column="0"
                                                                            Content="Statement Day:" />
                                                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                                                Text="{Binding EditingAccountClone.CreditCardDetails.StatementDay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                                                Margin="5" />
                                                                        <Label
                                                                            Style="{DynamicResource    StyledLabel}"
                                                                            Grid.Row="0" Grid.Column="2"
                                                                            Content="Due Date Offset:" />
                                                                        <TextBox Grid.Row="0" Grid.Column="3"
                                                                                Text="{Binding EditingAccountClone.CreditCardDetails.DueDateOffset, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                                                Margin="5" />
                                                                        <Label
                                                                            Style="{DynamicResource    StyledLabel}"
                                                                            Grid.Row="1" Grid.Column="0"
                                                                            Content="Minimum payment:" />
                                                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                                                Text="{Binding EditingAccountClone.CreditCardDetails.MinPayFloor, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                                                Margin="5" />
                                                                        <CheckBox Grid.Row="1" Grid.Column="2"
                                                                                Content="Grace Period"
                                                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                                                IsChecked="{Binding EditingAccountClone.CreditCardDetails.PayPreviousMonthBalanceInFull, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                                                VerticalAlignment="Center"
                                                                                Margin="5"
                                                                                ToolTip="Interest is not charged if previous month's balance is paid in full" />
                                                                        <Button Grid.Row="2" Grid.Column="0"
                                                                                Content="Manage Interest Rates"
                                                                                Command="{Binding DataContext.SetAccountAprRatesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                Margin="0,0,0,0" Width="150"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Grid>
                </ScrollViewer>

                <!-- PENDING BATCH STAGING LIST (Visible only when StagedAccounts has items) -->
                <Border Grid.Row="2" Grid.Column="0" 
                        Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderColorBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Margin="0,0,0,15" Padding="8"
                        Visibility="{Binding StagedAccounts.Count, Converter={StaticResource IntToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Staged for Save:"
                                   Style="{DynamicResource StyledSecondaryTextBlock}"
                                   FontWeight="Bold" FontSize="11" Margin="0,0,0,4" />

                        <TextBlock Grid.Row="0" Text="Staged for Save:" 
                                   Style="{DynamicResource StyledSecondaryTextBlock}" 
                                   FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding StagedAccounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button Content="✕" 
                                                    Command="{Binding DataContext.RemoveStagedAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource DangerButtonStyle}"
                                                    Width="18" Height="18" Padding="0" Margin="0,0,8,0"
                                                    ToolTip="Remove from batch" />

                                            <TextBlock Text="{Binding Name}" Style="{DynamicResource StyledTextBlock}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <!-- FOOTER ACTIONS -->
                <Grid Grid.Row="3" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Delete Button (Left side) -->
                    <!-- <Button Grid.Column="0" -->
                    <!--         Content="Delete" -->
                    <!--         Command="{Binding DeleteTransactionCommand}" -->
                    <!--         Width="80"> -->
                    <!--     <Button.Style> -->
                    <!--         <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}"> -->
                    <!--             <Setter Property="Visibility" Value="Visible" /> -->
                    <!--             <Style.Triggers> -->
                    <!--                 <DataTrigger Binding="{Binding EditingTransactionClone.TransactionId, Converter={StaticResource NullToVisibilityConverter}}" Value="Collapsed"> -->
                    <!--                     <Setter Property="Visibility" Value="Collapsed" /> -->
                    <!--                 </DataTrigger> -->
                    <!--             </Style.Triggers> -->
                    <!--         </Style> -->
                    <!--     </Button.Style> -->
                    <!-- </Button> -->
                    <Button Grid.Column="0"
                            Content="Clear Form"
                            Command="{Binding ClearCurrentDraftCommand}"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Width="90" />

                    <!-- Batch Controls (Right side) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Add Another"
                                Command="{Binding AddAnotherAccountCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Width="100" Margin="4,0" />

                        <Button Command="{Binding SaveAccountCommand}"
                                IsEnabled="{Binding CanSaveAccount}"
                                MinWidth="100" Padding="12,6"
                                Margin="4,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <!-- Bind to the integer value -->
                                    <Setter Property="Content" Value="{Binding TotalAccountItemsToSaveCount}" />
                                    <!-- Default template for multiple staged items -->
                                    <Setter Property="ContentStringFormat" Value="Save All ({0})" />
                                    <Style.Triggers>
                                        <!-- Hide count when saving only 1 item (active draft or 1 staged item) -->
                                        <DataTrigger Binding="{Binding TotalAccountItemsToSaveCount}" Value="1">
                                            <Setter Property="Content" Value="Save" />
                                            <Setter Property="ContentStringFormat" Value="{x:Null}" />
                                        </DataTrigger>
                                        <!-- Default label when 0 -->
                                        <DataTrigger Binding="{Binding TotalAccountItemsToSaveCount}" Value="0">
                                            <Setter Property="Content" Value="Save" />
                                            <Setter Property="ContentStringFormat" Value="{x:Null}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Cancel"
                                Command="{Binding CancelAccountCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Width="80" Margin="4,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>