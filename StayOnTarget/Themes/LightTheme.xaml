<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64748B" />
    <SolidColorBrush x:Key="BorderColorBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DataGridAltRowBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="ThumbBrush" Color="Gray" />
    <SolidColorBrush x:Key="ModalBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DataGridRowForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TrackBackgroundBrush" Color="#EFEFEF" />
    <SolidColorBrush x:Key="ThumbNormalBrush" Color="#CECECE" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#373737" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#43BB26" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#EAAC45" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F9C200" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#3C4655" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#B31E1F" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#CE1311" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#5597D5" />
    <SolidColorBrush x:Key="InfoBrush" Color="#5bc0de" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="#3C4655" />
    <SolidColorBrush x:Key="NeutralBorderBrush" Color="#3C4655" />
    <SolidColorBrush x:Key="NeutralBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="NeutralTextBrush" Color="#3C4655" />
    
    <SolidColorBrush x:Key="GridSplitterBrush" Color="#DDD" />
    
    <!-- Primary Button (Light) -->
    <SolidColorBrush x:Key="ButtonPrimaryBackgroundBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="ButtonPrimaryForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonPrimaryBorderBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="ButtonPrimaryHoverBackgroundBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="ButtonPrimaryPressedBackgroundBrush" Color="#1E40AF" />

    <!-- Secondary Button (Light) -->
    <SolidColorBrush x:Key="ButtonSecondaryBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="ButtonSecondaryForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="ButtonSecondaryBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="ButtonSecondaryHoverBackgroundBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ButtonSecondaryPressedBackgroundBrush" Color="#CBD5E1" />

    <!-- Danger Button (Light) -->
    <SolidColorBrush x:Key="ButtonDangerBackgroundBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="ButtonDangerForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonDangerBorderBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="ButtonDangerHoverBackgroundBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="ButtonDangerPressedBackgroundBrush" Color="#991B1B" />

    <!-- Danger Subdued Button (Light) -->
    <SolidColorBrush x:Key="ButtonDangerSubduedBackgroundBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="ButtonDangerSubduedForegroundBrush" Color="#991B1B" />
    <SolidColorBrush x:Key="ButtonDangerSubduedBorderBrush" Color="#FCA5A5" />
    <SolidColorBrush x:Key="ButtonDangerSubduedHoverBackgroundBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="ButtonDangerSubduedPressedBackgroundBrush" Color="#FECACA" />
    
    <!-- Accent / Wizard Next & Finish Button (Light) -->
    <SolidColorBrush x:Key="ButtonAccentBackgroundBrush" Color="#0D9488" />        <!-- Teal 600 -->
    <SolidColorBrush x:Key="ButtonAccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonAccentBorderBrush" Color="#0D9488" />
    <SolidColorBrush x:Key="ButtonAccentHoverBackgroundBrush" Color="#0F766E" />   <!-- Darker Teal -->
    <SolidColorBrush x:Key="ButtonAccentPressedBackgroundBrush" Color="#115E59" />
    
    <!-- GridSplitter Colors (Light Theme) -->
    <SolidColorBrush x:Key="SplitterBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SplitterLineBrush" Color="#CBD5E1" />          <!-- Slate 300 -->
    <SolidColorBrush x:Key="SplitterGripBrush" Color="#94A3B8" />          <!-- Slate 400 -->
    <SolidColorBrush x:Key="SplitterHoverBrush" Color="#3B82F6" />         <!-- Accent Blue -->
</ResourceDictionary>