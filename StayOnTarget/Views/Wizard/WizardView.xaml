<UserControl x:Class="StayOnTarget.Views.Wizard.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:StayOnTarget.ViewModels.Wizard"
             xmlns:views="clr-namespace:StayOnTarget.Views.Wizard"
             xmlns:converters="clr-namespace:StayOnTarget.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="700">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <!-- Map each Step ViewModel to its respective View -->
        <DataTemplate DataType="{x:Type vm:DatabaseNameViewModel}">
            <views:DatabaseNameView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountSetupViewModel}">
            <views:AccountSetupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PaycheckSetupViewModel}">
            <views:PaycheckSetupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BillSetupViewModel}">
            <views:BillSetupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BucketSetupViewModel}">
            <views:BucketSetupView />
        </DataTemplate>

        <!-- Step Indicator Style -->
        <Style x:Key="StepIndicatorCircle" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header / Step Indicator -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1"/>
            <!-- Content Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Navigation -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Breadcrumb Step Tracker -->
        <ItemsControl ItemsSource="{Binding Steps}" Grid.Row="0" Margin="0,0,0,24" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="12,0">
                        <Border Style="{StaticResource StepIndicatorCircle}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StepIndex}" 
                                       Foreground="White" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding StepTitle}" 
                                   VerticalAlignment="Center" 
                                   Margin="8,0,0,0" 
                                   FontWeight="SemiBold" 
                                   Foreground="#333333"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator Grid.Row="1" Background="#E0E0E0" Margin="0,0,0,16"/>

        <!-- 2. Dynamic Content Host -->
        <ContentControl Grid.Row="2" 
                        Content="{Binding CurrentStep}" 
                        Margin="0,8,0,16"/>

        <!-- 3. Navigation Controls -->
        <Border Grid.Row="3" Padding="0,16,0,0" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <Button Content="Back" 
                        Command="{Binding PreviousCommand}" 
                        HorizontalAlignment="Left" 
                        Width="100" Height="36"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" 
                            IsCancel="True"
                            Width="90" Height="36" 
                            Margin="0,0,8,0" 
                            Background="Transparent" 
                            BorderThickness="0"/>

                    <Button Content="Next" 
                            Command="{Binding NextCommand}" 
                            Visibility="{Binding IsLastStep, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            Width="100" Height="36" 
                            Style="{StaticResource AccentButtonStyle}"/>

                    <Button Content="Finish" 
                            Command="{Binding FinishCommand}" 
                            Visibility="{Binding IsLastStep, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Width="100" Height="36" 
                            Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>