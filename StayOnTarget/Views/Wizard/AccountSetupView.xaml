<UserControl x:Class="StayOnTarget.Views.Wizard.AccountSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:StayOnTarget.Views.Wizard"
             xmlns:helpers="clr-namespace:StayOnTarget"
             xmlns:converters="clr-namespace:StayOnTarget.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:AccountTypeToVisibilityConverter x:Key="AccountTypeToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Manage Accounts" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <TextBlock Text="Current Accounts" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ListBox ItemsSource="{Binding Accounts}" MinHeight="100">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Delete" 
                                    Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Padding="5,2" Margin="5,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Border Grid.Column="1" Background="#F5F5F5" Padding="15">
            <StackPanel>
                
                <TextBlock Text="Add New Account" FontWeight="Bold" Margin="0,0,0,15"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Account Name" Margin="0,0,0,5"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding EditingAccount.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                
                    <TextBlock Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2"  Text="Bank Name" Margin="0,0,0,5"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"  Text="{Binding EditingAccount.BankName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Initial Balance" Margin="0,0,0,5"/>
                    <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding EditingAccount.Balance, UpdateSourceTrigger=PropertyChanged}" 
                             helpers:TextBoxBehavior.IsNumericOnly="True"
                             Margin="0,0,0,15"/>
                    
                    <Label Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2"  Content="Balance as of:" />
                    <DatePicker Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2"
                                SelectedDate="{Binding EditingAccount.MortgageDetails.BalanceAsOf, UpdateSourceTrigger=PropertyChanged}"
                                MinWidth="90" Margin="0,0,0,15" />
                    
                    <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="Account Type" Margin="0,0,0,5"/>
                    <ComboBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding EditingAccount.Type}" Margin="0,0,0,10"/>
                    
                    <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Content="Primary payment account"
                              IsChecked="{Binding EditingAccount.IsPrimary}"
                              VerticalAlignment="Center" Margin="0,0,0,5"
                              Visibility="{Binding EditingAccount.Type, ConverterParameter='Checking|Savings', Converter={StaticResource AccountTypeToVisibilityConverter}, FallbackValue=Collapsed}"

                    />
                    <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="5" 
                               Margin="0,0,0,15" Foreground="DimGray" Text="(This is the account used to plan automated debt payments)" 
                               TextWrapping="Wrap"
                               Visibility="{Binding EditingAccount.Type, ConverterParameter='Checking|Savings', Converter={StaticResource AccountTypeToVisibilityConverter}, FallbackValue=Collapsed}"

                               />

                    
                </Grid>
                
                
                
                 
               
                
                <!-- Mortgage Specific Details -->
                                        <StackPanel 
                                            Margin="0, 0, 1, 15"
                                                    Orientation="Vertical"
                                                    Visibility="{Binding EditingAccount.Type, ConverterParameter=Mortgage, Converter={StaticResource AccountTypeToVisibilityConverter}}">
                                            <TextBlock Text="Mortgage Details" FontSize="12" FontWeight="Bold"
                                                       Margin="0,5,0,5" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Label Grid.Row="0" Grid.Column="0" Content="Rate %:" />
                                                <TextBox Grid.Row="0" Grid.Column="1"
                                                         Text="{Binding EditingAccount.MortgageDetails.InterestRate, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="5" />
                                                <Label Grid.Row="0" Grid.Column="2" Content="Escrow $:" />
                                                <TextBox Grid.Row="0" Grid.Column="3"
                                                         Text="{Binding EditingAccount.MortgageDetails.Escrow, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="5" />

                                                <Label Grid.Row="1" Grid.Column="0" Content="Insurance $:" />
                                                <TextBox Grid.Row="1" Grid.Column="1"
                                                         Text="{Binding EditingAccount.MortgageDetails.MortgageInsurance, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="5" />

                                                <Label Grid.Row="1" Grid.Column="2" Content="Payment $:" />
                                                <TextBox Grid.Row="1" Grid.Column="3"
                                                         Text="{Binding EditingAccount.MortgageDetails.LoanPayment, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="5" />
                                                <Label Grid.Row="2" Grid.Column="0" Content="Statement date:" />
                                                <DatePicker Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                            SelectedDate="{Binding EditingAccount.MortgageDetails.PaymentDate, UpdateSourceTrigger=PropertyChanged}"
                                                            MinWidth="90" Margin="5" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- Credit Card Specific Details -->
                                        <StackPanel 
                                                    Orientation="Vertical"
                                                    Margin="0, 0, 0, 15"
                                                    Visibility="{Binding EditingAccount.Type, ConverterParameter=CreditCard, Converter={StaticResource AccountTypeToVisibilityConverter}}">

                                            <TextBlock Text="Credit Card Details" FontSize="12" FontWeight="Bold"
                                                       Margin="0,5,0,5" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>


                                                <Label Grid.Row="0" Grid.Column="0" Content="Statement Day:" />
                                                <TextBox Grid.Row="0" Grid.Column="1"
                                                         Text="{Binding EditingAccount.CreditCardDetails.StatementDay, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="5" />
                                                <Label Grid.Row="0" Grid.Column="2" Content="Due Date Offset:" />
                                                <TextBox Grid.Row="0" Grid.Column="3"
                                                         Text="{Binding EditingAccount.CreditCardDetails.DueDateOffset, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="5" />

                                                <Label Grid.Row="1" Grid.Column="0" Content="Minimum payment $:" />
                                                <TextBox Grid.Row="1" Grid.Column="1"
                                                         Text="{Binding EditingAccount.CreditCardDetails.MinPayFloor, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="5" />
                                                <CheckBox Grid.Row="1" Grid.Column="2" Content="Grace Period"
                                                          IsChecked="{Binding EditingAccount.CreditCardDetails.PayPreviousMonthBalanceInFull, UpdateSourceTrigger=PropertyChanged}"
                                                          VerticalAlignment="Center" Margin="5"
                                                          ToolTip="Interest is not charged if previous month's balance is paid in full" />


                                                <Button Grid.Row="2" Grid.Column="0" Content="Manage Interest Rates"
                                                        Command="{Binding SetAccountAprRatesCommand}"
                                                        Margin="0,0,0,0"
                                                        Width="150"
                                                        Padding="10,5"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </StackPanel>
                
                <Button Content="Add Account" Command="{Binding AddAccountCommand}" Padding="10,5"/>
            </StackPanel>
            
            
        </Border>
    </Grid>
</UserControl>
