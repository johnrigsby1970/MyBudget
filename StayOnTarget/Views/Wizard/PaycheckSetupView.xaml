<UserControl x:Class="StayOnTarget.Views.Wizard.PaycheckSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:StayOnTarget.Views.Wizard"
             xmlns:helpers="clr-namespace:StayOnTarget"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Income Setup (Optional)" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <TextBlock Text="Your Paychecks" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ListBox ItemsSource="{Binding Paychecks}" MinHeight="100">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <TextBlock>
                                    <Run Text="{Binding ExpectedAmount, StringFormat=C}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding Frequency}"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Delete" 
                                    Command="{Binding DataContext.DeletePaycheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Padding="5,2" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Border Grid.Column="1" Background="#F5F5F5" Padding="15">
            <StackPanel>
                <TextBlock Text="Add Paycheck" FontWeight="Bold" Margin="0,0,0,15"/>
                
                <TextBlock Text="Name" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EditingPaycheck.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                
                <TextBlock Text="Expected Amount" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EditingPaycheck.ExpectedAmount, UpdateSourceTrigger=PropertyChanged}" 
                         helpers:TextBoxBehavior.IsNumericOnly="True"
                         Margin="0,0,0,10"/>
                
                <TextBlock Text="Frequency" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Frequencies}" SelectedItem="{Binding EditingPaycheck.Frequency}" Margin="0,0,0,10"/>
                
                <TextBlock Text="Next Pay Date" Margin="0,0,0,5"/>
                <DatePicker SelectedDate="{Binding EditingPaycheck.StartDate}" Margin="0,0,0,10"/>

                <TextBlock Text="Deposit To" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Accounts}" 
                          SelectedValue="{Binding EditingPaycheck.AccountId}" 
                          SelectedValuePath="Id" 
                          DisplayMemberPath="Name"
                          Margin="0,0,0,15"/>
                
                <Button Content="Add Paycheck" Command="{Binding AddPaycheckCommand}" Padding="10,5"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
