<UserControl x:Class="StayOnTarget.Views.Wizard.BillSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:StayOnTarget.Views.Wizard"
             xmlns:helpers="clr-namespace:StayOnTarget"
             xmlns:converters="clr-namespace:StayOnTarget.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <converters:AccountTypeToVisibilityConverter x:Key="AccountTypeToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Bill Setup (Optional)" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <TextBlock Text="Your Bills" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ListBox ItemsSource="{Binding Bills}" MinHeight="100">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <TextBlock>
                                    <Run Text="{Binding ExpectedAmount, StringFormat=C}"/>
                                    <Run Text=" - Due Day: "/>
                                    <Run Text="{Binding DueDay}"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Delete" 
                                    Command="{Binding DataContext.DeleteBillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Padding="5,2" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Border Grid.Column="1" Background="#F5F5F5" Padding="15">
            <StackPanel>
                <TextBlock Text="Add Bill" FontWeight="Bold" Margin="0,0,0,15"/>
                
                <!-- <TextBlock Text="Name" Margin="0,0,0,5"/> -->
                <!-- <TextBox Text="{Binding EditingBill.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/> -->
                <!-- -->
                <!-- <TextBlock Text="Expected Amount" Margin="0,0,0,5"/> -->
                <!-- <TextBox Text="{Binding EditingBill.ExpectedAmount, UpdateSourceTrigger=PropertyChanged}"  -->
                <!--          helpers:TextBoxBehavior.IsNumericOnly="True" -->
                <!--          Margin="0,0,0,10"/> -->
                <!-- -->
                <!-- <TextBlock Text="Frequency" Margin="0,0,0,5"/> -->
                <!-- <ComboBox ItemsSource="{Binding Frequencies}" SelectedItem="{Binding EditingBill.Frequency}" Margin="0,0,0,10"/> -->
                <!-- -->
                <!-- <TextBlock Text="Due Day (1-31)" Margin="0,0,0,5"/> -->
                <!-- <TextBox Text="{Binding EditingBill.DueDay, UpdateSourceTrigger=PropertyChanged}"  -->
                <!--          helpers:TextBoxBehavior.IsNumericOnly="True" -->
                <!--          Margin="0,0,0,10"/> -->
                <!-- -->
                <!-- <TextBlock Text="Pay From" Margin="0,0,0,5"/> -->
                <!-- <ComboBox ItemsSource="{Binding Accounts}"  -->
                <!--           SelectedValue="{Binding EditingBill.AccountId}"  -->
                <!--           SelectedValuePath="Id"  -->
                <!--           DisplayMemberPath="Name" -->
                <!--           Margin="0,0,0,15"/> -->
                
                <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Label Grid.Column="0" Grid.Row="0" Content="Name:" />
                                        <TextBox Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="1"
                                                 Text="{Binding EditingBill.Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="5" />

                                        <Label Grid.Column="0" Grid.Row="2"  Grid.ColumnSpan="2" Content="Frequency:" />
                                        <ComboBox Grid.Column="0" Grid.Row="3"  Grid.ColumnSpan="2"
                                                  ItemsSource="{Binding BillFrequencies}"
                                                  SelectedItem="{Binding EditingBill.Frequency}" Margin="5" />
                                        
                                        <Label Grid.Column="2" Grid.Row="2"  Grid.ColumnSpan="2" Content="Budgeted:" />
                                        <TextBox Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="3"
                                                 helpers:TextBoxBehavior.IsNumericOnly="True"
                                                 Text="{Binding EditingBill.ExpectedAmount, UpdateSourceTrigger=PropertyChanged, Delay=500, StringFormat={}{0:0.00;-0.00;''}}"
                                                 Margin="5" />
                                        
                                        
                                        <Label Grid.Column="0" Grid.Row="4"  Grid.ColumnSpan="2" Content="Due Day:">
                                            <Label.Style>
                                                <Style TargetType="Label">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EditingBill.Frequency}"
                                                                     Value="Monthly">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Label.Style>
                                        </Label>
                                        <TextBox Grid.Column="0" Grid.Row="5"  Grid.ColumnSpan="2" 
                                                 Text="{Binding EditingBill.DueDay, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="5">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EditingBill.Frequency}"
                                                                     Value="Monthly">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <Label Grid.Column="2" Grid.Row="4"  Grid.ColumnSpan="2"  Content="Next Due Date:">
                                            <Label.Style>
                                                <Style TargetType="Label">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EditingBill.Frequency}"
                                                                     Value="Yearly">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Label.Style>
                                        </Label>
                                        <DatePicker Grid.Column="2" Grid.Row="5"  Grid.ColumnSpan="2" 
                                                    SelectedDate="{Binding EditingBill.NextDueDate}"
                                                    Margin="5">
                                            <DatePicker.Style>
                                                <Style TargetType="DatePicker">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EditingBill.Frequency}"
                                                                     Value="Yearly">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DatePicker.Style>
                                        </DatePicker>

                                        <Label Grid.Column="0" Grid.Row="6"  Grid.ColumnSpan="2"  Content="Paid From:" />
                                        <ComboBox Grid.Column="0" Grid.Row="7"  Grid.ColumnSpan="2"  ItemsSource="{Binding ActiveAccountsWithNone}"
                                                  x:Name="BillAccountComboBox"
                                                  SelectedValue="{Binding EditingBill.AccountId}"
                                                  SelectedValuePath="Id" DisplayMemberPath="Name" Margin="5" />

                                        <Label Grid.Column="2" Grid.Row="6"  Grid.ColumnSpan="2"  Content="Paid To:" />
                                        <ComboBox Grid.Column="2" Grid.Row="7"  Grid.ColumnSpan="2"  ItemsSource="{Binding ActiveAccountsWithNone}"
                                                  x:Name="BillToAccountComboBox"
                                                  SelectedValue="{Binding EditingBill.ToAccountId}"
                                                  SelectedValuePath="Id" DisplayMemberPath="Name" Margin="5" />

                                        <StackPanel Grid.Column="0" Grid.Row="8" Grid.ColumnSpan="4"
                                                    Orientation="Horizontal" Margin="5">
                                            <CheckBox Content="Principal Only (Mortgage/Loan Extra)"
                                                      IsChecked="{Binding EditingBill.IsPrincipalOnly}"
                                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                                      Visibility="{Binding SelectedItem, ElementName=BillToAccountComboBox, ConverterParameter='Mortgage|PersonalLoan', Converter={StaticResource AccountTypeToVisibilityConverter}, FallbackValue=Collapsed}" />

                                        </StackPanel>
                                    </Grid> 
                
                <Button Content="Add Bill" Command="{Binding AddBillCommand}" Padding="10,5"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
