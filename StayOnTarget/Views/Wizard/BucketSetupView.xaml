<UserControl x:Class="StayOnTarget.Views.Wizard.BucketSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:StayOnTarget.Views.Wizard"
             xmlns:helpers="clr-namespace:StayOnTarget"
             xmlns:helpers1="clr-namespace:StayOnTarget.Helpers"
             xmlns:controls="clr-namespace:StayOnTarget.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Envelopes (Optional)" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <TextBlock Text="Your Envelopes" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ListBox ItemsSource="{Binding Buckets}" MinHeight="100">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ExpectedAmount, StringFormat=C}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Delete" 
                                    Command="{Binding DataContext.DeleteBucketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Padding="5,2" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            
            <Border BorderBrush="#BAE6FD" BorderThickness="1,1,1,1" Margin="0,10,0,0" Padding="8,8,12,8">
                <StackPanel>
                    <!-- Primary Outcome Paragraph -->
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#0C4A6E" FontWeight="SemiBold" LineHeight="16" Margin="0,0,0,6">
                        <Run Text="💡 " />
                        <Run Text="Set aside money for variable, day-to-day spending—like groceries, gas, or dining out.
Be honest with your budget to get the clearest picture of your finances." />
                    </TextBlock>

                    <!-- ~1~ General Dilemma Paragraph @1@ -->
                    <!-- <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="#475569" LineHeight="15" FontStyle="Italic"> -->
                    <!--     <Run Text="{Binding StrategyTakeawayDilemma, Mode=OneWay}" /> -->
                    <!-- </TextBlock> -->
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Column="1" Background="#F5F5F5" Padding="15">
            <StackPanel>
                <TextBlock Text="Add Envelope" FontWeight="Bold" Margin="0,0,0,15"/>
                
                <TextBlock Text="Name" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EditingBucket.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                
                <TextBlock Text="Target Amount" Margin="0,0,0,5"/>
                <controls:NumericTextBox Text="{Binding EditingBucket.ExpectedAmount, UpdateSourceTrigger=PropertyChanged}" 
                                         Margin="0,0,0,10"/>

                <TextBlock Text="Paid From" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Accounts}" 
                          SelectedValue="{Binding EditingBucket.AccountId}" 
                          SelectedValuePath="Id" 
                          DisplayMemberPath="Name"
                          Margin="0,0,0,10"/>

                <TextBlock Text="Income Source Association (Optional)" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Paychecks}"
                          SelectedValue="{Binding EditingBucket.PaycheckId}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          Margin="0,0,0,5"/>
                <TextBlock  Foreground="DimGray" Text="(Is this envelope funded from a specific income source?)" Margin="0,0,0,15"/>
                
                <Button Content="Add Envelope" Command="{Binding AddBucketCommand}" Padding="10,5"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
