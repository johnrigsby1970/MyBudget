<UserControl x:Class="StayOnTarget.Views.Wizard.DatabaseNameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:StayOnTarget.Views.Wizard"
             xmlns:helpers="clr-namespace:StayOnTarget"
             xmlns:converters="clr-namespace:StayOnTarget.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!-- Left Panel: Setup Form -->
            <ColumnDefinition Width="380"/>
            <!-- Spacer -->
            <ColumnDefinition Width="30"/>
            <!-- Right Panel: Callout Box -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Main Form controls -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="Set Up Your Database" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="PROTECTED STORAGE" FontSize="10" FontWeight="Bold" Foreground="DodgerBlue" Margin="0,0,0,4"/>
                <TextBlock x:Name="InstructionText" 
                           Text="Enter a master password to encrypt your local budget file (AES-256). You will use this password to unlock your data." 
                           TextWrapping="Wrap" 
                           FontSize="13" 
                           Foreground="#555555" 
                           Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M6,10V7A4,4,0,0,1,14,7V10M8,10H12M5,10H15A2,2,0,0,1,17,12V19A2,2,0,0,1,15,21H5A2,2,0,0,1,3,19V12A2,2,0,0,1,5,10Z" 
                          Stroke="#666666" StrokeThickness="1" Width="20" Height="25" Stretch="Uniform" Margin="0,1,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="AES-256 local hardware encryption active" FontSize="11" FontStyle="Italic" Foreground="#666666" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            
            <TextBlock Text="Database Filename" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding DatabaseName}" Margin="0,0,0,15"
                       Visibility="{Binding DatabaseInitialized, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            
            <TextBox IsEnabled="true" Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Margin="0,0,0,15" Padding="5"
                     Visibility="{Binding DatabaseInitialized, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
            
            <TextBlock Text="Master Password" Margin="0,0,0,5"
                       Visibility="{Binding DatabaseInitialized, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
            <PasswordBox helpers:PasswordBoxHelper.BindPassword="True" 
                         helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Visibility="{Binding DatabaseInitialized, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                         Margin="0,0,0,5" Padding="5"/>
            <TextBlock Text="Password must be a minimum af 12 characters. Suggestion, a sentence." FontSize="11" Foreground="DimGray" Margin="0,0,0,15" FontWeight="SemiBold"/>

            <TextBlock Text="Confirm Password" Margin="0,0,0,5"
                       Visibility="{Binding DatabaseInitialized, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
            <PasswordBox helpers:PasswordBoxHelper.BindPassword="True" 
                         helpers:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Visibility="{Binding DatabaseInitialized, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                         Margin="0,0,0,15" Padding="5"/>
            
            <CheckBox Content="Use Windows Hello to unlock" IsChecked="{Binding UseWindowsHello}" Margin="0,0,0,20"/>
            
            <Button Content="Initialize Database" Command="{Binding InitializeDatabaseCommand}" Padding="10,5" HorizontalAlignment="Left"
                    Visibility="{Binding DatabaseInitialized, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    Style="{StaticResource AccentButtonStyle}"
                    Height="36" />
            
            <Button Content="Update Settings" Command="{Binding InitializeDatabaseCommand}" Padding="10,5" HorizontalAlignment="Left"
                    Visibility="{Binding DatabaseInitialized, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Height="36"/>
            
            <TextBlock Text="Database Initialized!" Foreground="Green" Margin="0,10,0,0" 
                       Visibility="{Binding DatabaseInitialized, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <!-- Right Column: Callout Box -->
        <Border 
                VerticalAlignment="Top" 
                Margin="0,45,0,0"
                Background="#F0F7FF" 
                BorderBrush="#BEE0FF" 
                BorderThickness="1" 
                CornerRadius="4" 
                Padding="12,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <!-- Lightbulb Icon -->
                    <Path Data="M12,2A7,7,0,0,0,5,9C5,11.38,6.19,13.47,8,14.74V17A1,1,0,0,0,9,18H15A1,1,0,0,0,16,17V14.74C17.81,13.47,19,11.38,19,9A7,7,0,0,0,12,2M9,21A1,1,0,0,0,10,22H14A1,1,0,0,0,15,21V20H9V21Z" 
                          Fill="#007ACC" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Why use Windows Hello?" FontWeight="SemiBold" Foreground="#007ACC" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                
                <TextBlock Text="Enabling Windows Hello allows you to quickly unlock your budget using PIN, fingerprint, or facial recognition." 
                           TextWrapping="Wrap" FontSize="11" Foreground="#004085" Margin="0,0,0,6"/>
                
                <TextBlock Text="Your Master Password remains the core key used to encrypt the SQLite database on disk. Windows Hello simply stores a secure local token so you don't have to re-type your password every time." 
                           TextWrapping="Wrap" FontSize="10.5" FontStyle="Italic" Foreground="#004085"/>
            </StackPanel>
        </Border>
        
            <!-- Validation Error Callout Box -->
            <Border Background="#FDF2F2" 
                    BorderBrush="#F8C4C4" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Padding="12,10" 
                    Margin="0,12,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Warning / Exclamation Icon -->
                    <Path Grid.Column="0"
                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" 
                          Fill="#D13438" 
                          Width="14" 
                          Height="14" 
                          Stretch="Uniform" 
                          Margin="0,1,8,0" 
                          VerticalAlignment="Top" />

                    <!-- Error Text -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding ErrorMessage}" 
                               Foreground="#A80000" 
                               FontSize="11.5" 
                               TextWrapping="Wrap" 
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
        
    </Grid>
</UserControl>