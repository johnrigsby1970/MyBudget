<UserControl x:Class="StayOnTarget.ProjectionLiveChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Chart Filter Control Bar -->
        <Border Grid.Row="0" Margin="0,0,0,8" Padding="8,6" Background="{DynamicResource SurfaceBackgroundBrush}"
                CornerRadius="6" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">

                <!-- Actions: All / None / Detailed Filter Toggle / Sync -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <!-- Link/Sync ToggleButton -->
                    <ToggleButton x:Name="SyncFiltersToggleButton"
                                  Content="🔗 Sync"
                                  IsChecked="{Binding IsSyncActive, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Padding="6,3" FontSize="11" Margin="0,0,6,0"
                                  ToolTip="Sync filter selections with other charts"
                                  Style="{DynamicResource SecondaryToggleButtonStyle}" />

                    <ToggleButton x:Name="DetailFilterToggleButton"
                                  Content="Filter Accounts... ⚙"
                                  Padding="8,3" FontSize="11"
                                  Style="{DynamicResource SecondaryToggleButtonStyle}" />

                    <!-- Individual Account Selection Popover -->
                    <Popup IsOpen="{Binding IsChecked, ElementName=DetailFilterToggleButton}"
                           StaysOpen="False"
                           PlacementTarget="{Binding ElementName=DetailFilterToggleButton}"
                           Placement="Bottom"
                           AllowsTransparency="True">
                        <Border Width="280" MaxHeight="350" Background="{DynamicResource ModalBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,4,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.3" Color="Black" />
                            </Border.Effect>
                            <Grid RowDefinitions="Auto, *, Auto">
                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Filter Accounts" FontWeight="Bold" FontSize="13"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="All" Click="OnSelectAllSeries" Padding="6,2" Margin="0,0,4,0"
                                                FontSize="10" Style="{DynamicResource SecondaryButtonStyle}" />
                                        <Button Content="None" Click="OnClearAllSeries" Padding="6,2" FontSize="10"
                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </DockPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="SeriesToggleItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}"
                                                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                          Margin="0,3,0,3" FontSize="12"
                                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Button Grid.Row="2" Content="Close" Margin="0,8,0,0"
                                        Click="OnCloseDetailFilterPopup"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Right" Padding="12,3" FontSize="11" />
                            </Grid>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- Group Level Toggles -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Total Balance"
                              IsChecked="{Binding IsTotalBalanceVisible, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Margin="0,0,14,0" FontWeight="SemiBold" FontSize="11"
                              Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />

                    <Border Width="1" Height="14" Background="{DynamicResource BorderColorBrush}" Margin="0,0,14,0"
                            VerticalAlignment="Center" />

                    <CheckBox Content="Liquid Cash"
                              IsChecked="{Binding IsLiquidGroupVisible, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Margin="0,0,14,0" FontSize="11"
                              Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />

                    <CheckBox Content="Credit &amp; Debt"
                              IsChecked="{Binding IsCreditGroupVisible, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Margin="0,0,14,0" FontSize="11"
                              Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />

                    <CheckBox Content="Investments &amp; Assets"
                              IsChecked="{Binding IsInvestmentsGroupVisible, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Margin="0,0,14,0" FontSize="11"
                              Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- LiveCharts Canvas Container -->
        <Grid x:Name="ChartHostGrid" Grid.Row="1" />
    </Grid>
</UserControl>